---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BaseHead from '../../components/BaseHead.astro';

export async function getStaticPaths() {
  const fs   = await import('fs');
  const path = await import('path');
  const raw  = fs.readFileSync(path.join(process.cwd(), 'public', 'persona-stats.json'), 'utf-8');
  const data = JSON.parse(raw);
  const blogMatchData = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'blog-match.json'), 'utf-8'));
  const DECADES = ['20대','30대','40대','50대','60대','70대이상'];
  return Object.entries(data)
    .filter(([key]) => DECADES.some(d => key.endsWith('_' + d)))
    .map(([key, stats]) => ({
      params: { slug: key.replace(/_/g, '-') },
      props:  { key, stats, blogMatch: blogMatchData }
    }));
}

const { key, stats: s, blogMatch } = Astro.props;
const [region, sex, ageRaw] = key.split('_');
const sexLabel = sex === '남자' ? '남성' : '여성';

function pctOf(obj: Record<string,number>, keys: string[]): number {
  if (!obj) return 0;
  const t = Object.values(obj).reduce((a,v) => a+v, 0);
  if (!t) return 0;
  return Math.round(keys.reduce((a,k) => a+(obj[k]||0), 0) / t * 100);
}
function topN(obj: Record<string,number>, n = 5) {
  return Object.entries(obj || {}).sort((a,b) => b[1]-a[1]).slice(0, n);
}

const aptPct = pctOf(s.housing,   ['아파트']);
const eduPct = pctOf(s.education, ['4년제 대학교','대학원']);
const marPct = pctOf(s.marital,   ['배우자있음']);
const unePct = pctOf(s.jobs,      ['무직']);
const divPct = pctOf(s.marital,   ['이혼']);
const widPct = pctOf(s.marital,   ['사별']);
const sngPct = pctOf(s.family,    ['혼자 거주','혼자 거주 (배우자 별거)']);

const incomeData = (s as any).income ?? null;
const incomeVal  = incomeData?.income_employed ?? null;
const topPct     = incomeData?.top_percentile ?? null;

const SITE_URL = 'https://persona.aikorea24.kr';
const title    = `${region} ${ageRaw} ${sexLabel} 평균 연봉·직업·주거 통계 (2025)`;
const desc     = `${region} ${ageRaw} ${sexLabel} ${s.total.toLocaleString()}명 분석. 추정 월소득 ${incomeVal ?? '?'}만원, 아파트 거주 ${aptPct}%, 대졸 ${eduPct}%, 기혼 ${marPct}%. KOSIS·NVIDIA 데이터 기반.`;
const pageUrl  = `${SITE_URL}/decade/${key.replace(/_/g, '-')}/`;
const ageForCard = ageRaw === '20대' ? '25' : ageRaw === '30대' ? '35' : ageRaw === '40대' ? '45' : ageRaw === '50대' ? '55' : '65';
const ogImg    = `${SITE_URL}/cards/${encodeURIComponent(region)}_${sex}_${ageForCard}.jpg`;

const ageRelLinks: Record<string, any[]> = {
  '20대': blogMatch['영 익스플로러'] ?? [],
  '30대': blogMatch['도시 자산 빌더'] ?? [],
  '40대': blogMatch['패밀리 앵커'] ?? [],
  '50대': blogMatch['스테디 인컴'] ?? [],
  '60대': blogMatch['골든타임 플래너'] ?? [],
  '70대이상': blogMatch['골든타임 플래너'] ?? [],
};
const relLinks = ageRelLinks[ageRaw] ?? blogMatch['한국인 평균형'] ?? [];

const JOB_WAGE: Record<string, number> = {
  '무직':0,'구직중':0,'관리자':1260,'임원':1260,'대표이사':1260,
  '의사':800,'변호사':950,'약사':520,'회계사':600,'간호사':450,
  '교사':540,'교수':430,'프로그래머':580,'개발자':580,'데이터':580,
  '사무원':490,'비서':290,'행정':490,'총무':490,'인사':490,
  '영업원':410,'판매원':290,'마케팅':500,'조리사':250,'청소원':220,
  '경비원':380,'보육':250,'운전원':350,'기관사':590,'지게차':420,
  '용접':410,'배관':400,'단순':260,'하역':260,'택배':290,
};
function getJobWage(jobName: string): number | null {
  for (const [kw, wage] of Object.entries(JOB_WAGE)) {
    if (jobName.includes(kw)) return wage;
  }
  return null;
}

// 비교 링크
const REGIONS = ['서울','경기','부산','대구','인천','광주','대전','울산','강원','제주'];
const AGES    = ['20대','30대','40대','50대'];
const compareRegions = REGIONS.filter(r => r !== region).slice(0, 4);
const compareAges    = AGES.filter(a => a !== ageRaw);
const compareSex     = sex === '남자' ? '여자' : '남자';
const compareSexLabel = sex === '남자' ? '여성' : '남성';
---
<html lang="ko">
<head>
  <BaseHead title={title} description={desc} />
  <link rel="canonical" href={pageUrl} />
  <meta property="og:image" content={ogImg} />
  <meta property="og:url" content={pageUrl} />
  <meta name="twitter:image" content={ogImg} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org",
    "@type":"Article",
    "headline": title,
    "description": desc,
    "url": pageUrl,
    "image": ogImg,
    "publisher":{"@type":"Organization","name":"한국인 페르소나","url":SITE_URL}
  })} />
  <style>
    .decade-hero{background:linear-gradient(135deg,#1E3A5F,#2D5A8E);color:#fff;padding:2rem 1rem 1.5rem;text-align:center}
    .decade-hero h1{font-size:1.5rem;font-weight:900;margin:0 0 .4rem;line-height:1.3;word-break:keep-all}
    .decade-hero p{font-size:.88rem;opacity:.85;margin:.3rem 0 .8rem}
    .decade-hero .count{font-size:.82rem;background:rgba(255,255,255,.15);display:inline-block;padding:.25rem .7rem;border-radius:20px}
    .decade-wrap{max-width:720px;margin:0 auto;padding:1rem}
    .stat-card{background:#fff;border-radius:16px;padding:1.25rem;margin-bottom:1rem;box-shadow:0 2px 12px rgba(30,58,95,.07)}
    .stat-card h2{font-size:1rem;font-weight:700;color:#1E3A5F;margin:0 0 1rem}
    .grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;margin-bottom:1rem}
    .kpi{background:#FFFDF7;border-radius:14px;padding:1rem .75rem;text-align:center;box-shadow:0 2px 10px rgba(107,66,38,.07);border:1px solid #F0DFC8}
    .kpi-val{font-size:1.6rem;font-weight:800;color:#6B4226}
    .kpi-label{font-size:.72rem;color:#8B7355;margin-top:.2rem}
    .kpi-income{border-color:#C8E6C9;background:#F1F8E9;grid-column:span 4}
    .kpi-income .kpi-val{color:#2E7D32;font-size:2rem}
    .bar-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.75rem}
    .bar-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:.3rem;font-size:.88rem}
    .bar-name{font-weight:600;color:#1E3A5F}
    .bar-pct{font-weight:700;color:#6B4226}
    .bar-track{height:8px;background:#F0DFC8;border-radius:4px;overflow:hidden}
    .bar-fill{height:100%;border-radius:4px}
    .job-wage-badge{font-size:.7rem;font-weight:600;color:#2E7D32;background:#E8F5E9;border-radius:5px;padding:1px 5px}
    .rank-wrap{text-align:center;padding:.5rem 0}
    .rank-big{font-size:2.2rem;font-weight:900;color:#2E7D32}
    .rank-unit{font-size:1rem;color:#4CAF50}
    .rank-sub{font-size:.78rem;color:#888;margin:.2rem 0 1rem}
    .gauge-bar{position:relative;height:12px;background:#E8F5E9;border-radius:6px;margin-bottom:6px}
    .gauge-fill{height:100%;background:linear-gradient(90deg,#81C784,#2E7D32);border-radius:6px}
    .gauge-marker{position:absolute;top:-4px;transform:translateX(-50%)}
    .marker-dot{width:20px;height:20px;background:#D97706;border:3px solid #fff;border-radius:50%;box-shadow:0 2px 6px rgba(0,0,0,.2)}
    .marker-label{font-size:.68rem;font-weight:700;color:#D97706;text-align:center;margin-top:2px}
    .gauge-labels{display:flex;justify-content:space-between;font-size:.72rem;color:#888}
    .rank-result{margin:.75rem 0 .25rem}
    .rank-highlight{font-size:1.3rem;font-weight:900;color:#D97706}
    .rank-note{font-size:.7rem;color:#aaa;line-height:1.5;margin-top:.4rem}
    .marital-grid{display:grid;grid-template-columns:1fr 1fr;gap:.5rem}
    .marital-item{background:#F8F5F0;border-radius:10px;padding:.6rem;text-align:center}
    .marital-val{font-size:1.2rem;font-weight:800;color:#6B4226}
    .marital-label{font-size:.72rem;color:#8B7355;margin-top:.1rem}
    .compare-links{display:flex;flex-wrap:wrap;gap:.5rem}
    .compare-chip{background:#EEF2FF;border:1px solid #C7D2FE;border-radius:20px;padding:.3rem .7rem;font-size:.78rem;font-weight:600;color:#3730A3;text-decoration:none}
    .compare-chip:hover{background:#C7D2FE}
    .rel-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-top:.75rem}
    .rel-card{background:#F8F5F0;border-radius:12px;padding:.85rem .75rem;display:flex;flex-direction:column;gap:.3rem;text-decoration:none;transition:background .15s}
    .rel-card:hover{background:#F0DFC8}
    .rel-emoji{font-size:1.3rem}
    .rel-title{font-size:.82rem;font-weight:600;color:#1E3A5F;line-height:1.35}
    .entity-card{margin:1.5rem 0;padding:1.25rem 1.4rem;background:linear-gradient(135deg,#F0F9FF,#E0F2FE);border:1.5px solid #BAE6FD;border-radius:16px;text-decoration:none;display:block}
    .entity-card-label{font-size:.72rem;font-weight:700;color:#0369A1;margin-bottom:.5rem}
    .entity-card-stat{font-size:1rem;font-weight:700;color:#1E3A5F;margin-bottom:.4rem}
    .entity-card-cta{font-size:.82rem;color:#0369A1;font-weight:600}
    .zodiac-section{margin:1.5rem 0;padding:1.25rem;background:linear-gradient(135deg,#1E3A5F,#2d5a9e);border-radius:16px}
    .zodiac-section h3{color:#fff;font-size:.95rem;font-weight:700;margin:0 0 .9rem;text-align:center}
    .zodiac-cards{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
    .zodiac-card{display:flex;flex-direction:column;align-items:center;gap:.4rem;padding:1rem .6rem;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:12px;text-decoration:none;transition:background .2s}
    .zodiac-card:hover{background:rgba(255,255,255,.15)}
    .zc-icon{font-size:1.8rem}
    .zc-title{color:#fff;font-size:.85rem;font-weight:700;text-align:center}
    .zc-desc{color:rgba(255,255,255,.9);font-size:.72rem;text-align:center;line-height:1.4}
    .cta-box{background:linear-gradient(135deg,#1E3A5F,#2D5A8E);color:#fff;border-radius:16px;padding:1.5rem;text-align:center;margin:1rem 0}
    .cta-box h2{font-size:1rem;margin:0 0 .75rem;color:#fff}
    .cta-btn{background:#D97706;color:#fff;font-weight:700;padding:.75rem 1.5rem;border-radius:12px;font-size:.95rem;display:inline-block;text-decoration:none}
    @media(max-width:600px){.grid4{grid-template-columns:repeat(2,1fr)}.decade-hero h1{font-size:1.25rem}}
  </style>
</head>
<body>
  <Header />

  <section class="decade-hero">
    <h1>{region} {ageRaw} {sexLabel}<br/>평균 연봉·직업·주거 통계</h1>
    <p>NVIDIA Nemotron + KOSIS 통계청 데이터 기반 · 2025년 기준</p>
    <span class="count">총 {s.total.toLocaleString()}명 분석</span>
  </section>

  <div class="decade-wrap">

    <!-- KPI -->
    <div class="grid4">
      <div class="kpi"><div class="kpi-val">{aptPct}%</div><div class="kpi-label">아파트 거주</div></div>
      <div class="kpi"><div class="kpi-val">{eduPct}%</div><div class="kpi-label">대졸 이상</div></div>
      <div class="kpi"><div class="kpi-val">{marPct}%</div><div class="kpi-label">기혼</div></div>
      <div class="kpi"><div class="kpi-val">{unePct}%</div><div class="kpi-label">{ageRaw === '60대' || ageRaw === '70대이상' ? '은퇴·비경활' : '무직'}</div></div>
      {incomeVal !== null && (
        <div class="kpi kpi-income">
          <div class="kpi-val">{incomeVal}<span style="font-size:.9rem;font-weight:500">만원</span></div>
          <div class="kpi-label">추정 월소득 (취업자 기준) · KOSIS 2025</div>
        </div>
      )}
    </div>

    <!-- 소득 백분위 -->
    {incomeVal !== null && topPct !== null && (
      <div class="stat-card">
        <h2>💰 동일 연령 취업자 중 소득 위치</h2>
        <div class="rank-wrap">
          <div class="rank-big">{incomeVal}<span class="rank-unit">만원</span></div>
          <div class="rank-sub">추정 월소득 · KOSIS 고용형태별근로실태조사 2025</div>
          <div class="gauge-bar">
            <div class="gauge-fill" style={`width:${100-topPct}%`}></div>
            <div class="gauge-marker" style={`left:${100-topPct}%`}>
              <div class="marker-dot"></div>
              <div class="marker-label">여기</div>
            </div>
          </div>
          <div class="gauge-labels"><span>하위</span><span>상위</span></div>
          <div class="rank-result">
            <span class="rank-highlight">상위 {topPct}%</span>
            <span style="color:#555;font-size:.9rem"> — {ageRaw} 취업자 중</span>
          </div>
          <div class="rank-note">KOSIS 2025 직종×연령×지역 보정 추정값. 직종 대분류 평균 기반으로 개인 차이가 큽니다.</div>
        </div>
      </div>
    )}

    <!-- 주거형태 -->
    <div class="stat-card">
      <h2>🏠 주거형태</h2>
      <ul class="bar-list">
        {topN(s.housing, 5).map(([k, v]) => {
          const t = Object.values(s.housing).reduce((a,b)=>a+b,0);
          const p = t ? Math.round(v/t*100) : 0;
          return <li class="bar-item">
            <div class="bar-header"><span class="bar-name">{k}</span><span class="bar-pct">{p}%</span></div>
            <div class="bar-track"><div class="bar-fill" style={`width:${p}%;background:#E8A87C`}></div></div>
          </li>;
        })}
      </ul>
    </div>

    <!-- 학력 -->
    <div class="stat-card">
      <h2>🎓 학력</h2>
      <ul class="bar-list">
        {topN(s.education, 5).map(([k, v]) => {
          const t = Object.values(s.education).reduce((a,b)=>a+b,0);
          const p = t ? Math.round(v/t*100) : 0;
          return <li class="bar-item">
            <div class="bar-header"><span class="bar-name">{k}</span><span class="bar-pct">{p}%</span></div>
            <div class="bar-track"><div class="bar-fill" style={`width:${p}%;background:#60A5FA`}></div></div>
          </li>;
        })}
      </ul>
    </div>

    <!-- 직업 TOP10 -->
    <div class="stat-card">
      <h2>💼 직업 TOP10</h2>
      <ul class="bar-list">
        {topN(s.jobs, 10).map(([k, v]) => {
          const t = Object.values(s.jobs).reduce((a,b)=>a+b,0);
          const p = t ? Math.round(v/t*100) : 0;
          const wage = getJobWage(k);
          return <li class="bar-item">
            <div class="bar-header">
              <span class="bar-name">{k}</span>
              <span style="display:flex;gap:.4rem;align-items:center">
                {wage !== null && wage > 0 && <span class="job-wage-badge">월 {wage}만원</span>}
                <span class="bar-pct">{p}%</span>
              </span>
            </div>
            <div class="bar-track"><div class="bar-fill" style={`width:${p}%;background:#8b5cf6`}></div></div>
          </li>;
        })}
      </ul>
    </div>

    <!-- 혼인상태 -->
    <div class="stat-card">
      <h2>💍 혼인상태</h2>
      <div class="marital-grid">
        <div class="marital-item"><div class="marital-val">{marPct}%</div><div class="marital-label">기혼</div></div>
        <div class="marital-item"><div class="marital-val">{pctOf(s.marital,['미혼'])}%</div><div class="marital-label">미혼</div></div>
        <div class="marital-item"><div class="marital-val">{divPct}%</div><div class="marital-label">이혼</div></div>
        <div class="marital-item"><div class="marital-val">{widPct}%</div><div class="marital-label">사별</div></div>
      </div>
    </div>

    <!-- 가족 구성 -->
    <div class="stat-card">
      <h2>👨‍👩‍👧 가족 구성</h2>
      <ul class="bar-list">
        {topN(s.family, 5).map(([k, v]) => {
          const t = Object.values(s.family).reduce((a,b)=>a+b,0);
          const p = t ? Math.round(v/t*100) : 0;
          return <li class="bar-item">
            <div class="bar-header"><span class="bar-name">{k}</span><span class="bar-pct">{p}%</span></div>
            <div class="bar-track"><div class="bar-fill" style={`width:${p}%;background:#34D399`}></div></div>
          </li>;
        })}
      </ul>
    </div>

    <!-- 내부링크: 페르소나 카드 -->
    <a class="entity-card" href="/my-persona">
      <div class="entity-card-label">📊 한국인 페르소나 데이터</div>
      <div class="entity-card-stat">{region} {ageRaw} {sexLabel} — 아파트 {aptPct}%, 기혼 {marPct}%, 추정 월소득 {incomeVal}만원</div>
      <div class="entity-card-cta">내 페르소나 직접 분석하기 →</div>
    </a>

    <!-- 광고 -->
    <ins class="adsbygoogle" style="display:block;margin:1rem 0"
      data-ad-client="ca-pub-5938862195544185"
      data-ad-slot="8107272066"
      data-ad-format="auto"
      data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>

    <!-- 비교 링크 -->
    <div class="stat-card">
      <h2>🔍 다른 조건과 비교</h2>
      <div class="compare-links">
        {compareRegions.map(r => (
          <a class="compare-chip" href={`/decade/${r}-${sex}-${ageRaw}/`}>{r} {ageRaw} {sexLabel} →</a>
        ))}
        {compareAges.map(a => (
          <a class="compare-chip" href={`/decade/${region}-${sex}-${a}/`}>{region} {a} {sexLabel} →</a>
        ))}
        <a class="compare-chip" href={`/decade/${region}-${compareSex}-${ageRaw}/`}>{region} {ageRaw} {compareSexLabel} →</a>
      </div>
    </div>

    <!-- 관련 금융 가이드 -->
    <div class="stat-card">
      <h2>📚 관련 금융 가이드</h2>
      <div class="rel-grid">
        {relLinks.slice(0,4).map((l: any) => (
          <a class="rel-card" href={l.url}>
            <div class="rel-emoji">{l.emoji}</div>
            <div class="rel-title">{l.title}</div>
          </a>
        ))}
      </div>
    </div>

    <!-- 운세 카드 (BlogPost와 동일) -->
    <div class="zodiac-section">
      <h3>🔮 오늘의 운세도 확인해보세요</h3>
      <div class="zodiac-cards">
        <a class="zodiac-card" href="https://zodiac.techpawz.com/daily/" target="_blank" rel="noopener">
          <span class="zc-icon">🐉</span>
          <span class="zc-title">오늘의 띠별 운세</span>
          <span class="zc-desc">종합운·연애운·금전운<br/>매일 업데이트</span>
        </a>
        <a class="zodiac-card" href="https://zodiac.techpawz.com/tarot/" target="_blank" rel="noopener">
          <span class="zc-icon">🃏</span>
          <span class="zc-title">오늘의 타로</span>
          <span class="zc-desc">매일 한 장 뽑기<br/>78장 카드 해석</span>
        </a>
      </div>
    </div>

    <!-- CTA -->
