---
export const prerender = false;
const session = Astro.cookies.get('session')?.value;
let user: any = null;
try { if (session) user = JSON.parse(atob(session)); } catch {}
if (!user) return Astro.redirect('https://aikorea24.kr/auth/consent');

const url = new URL(Astro.request.url);
const slug        = url.searchParams.get('slug') || '';
const personaType = url.searchParams.get('type') || '';
const region      = url.searchParams.get('region') || '';
const sex         = url.searchParams.get('sex') || '';
const age         = url.searchParams.get('age') || '';
---
<html lang="ko">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>글쓰기 | 페르소나 커뮤니티</title>
  <link rel="stylesheet" crossorigin="anonymous"
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Pretendard',-apple-system,sans-serif;background:#FFF8EE;color:#3D3D3D}
    header{background:#6B4226;padding:.9rem 1.25rem;display:flex;align-items:center;gap:.75rem}
    header a{color:#fff;font-weight:700;font-size:.95rem}
    header span{color:rgba(255,255,255,.6);font-size:.9rem}
    .container{max-width:680px;margin:1.75rem auto;padding:0 1rem}
    .card{background:#fff;border-radius:20px;padding:1.75rem;box-shadow:0 4px 20px rgba(107,66,38,.1)}
    h1{font-size:1.25rem;font-weight:800;color:#6B4226;margin-bottom:1rem}
    .pbadge{background:#E8D5C0;color:#6B4226;border-radius:20px;padding:.28rem .85rem;font-size:.82rem;font-weight:700;display:inline-block;margin-bottom:1.1rem}
    label{display:block;font-size:.85rem;font-weight:700;color:#6B4226;margin-bottom:.35rem}
    input[type=text],textarea{width:100%;border:1.5px solid #E8D5C0;border-radius:10px;padding:.75rem 1rem;font-size:.95rem;font-family:inherit;outline:none;background:#FFFDF7}
    input[type=text]:focus,textarea:focus{border-color:#6B4226;background:#fff}
    textarea{min-height:220px;resize:vertical;line-height:1.7}
    .field{margin-bottom:1.1rem}
    .char-count{text-align:right;font-size:.75rem;color:#8B7355;margin-top:.25rem}
    .submit-btn{width:100%;background:#6B4226;color:#fff;border:none;border-radius:12px;padding:1rem;font-size:1rem;font-weight:700;cursor:pointer;margin-top:.25rem;transition:background .2s}
    .submit-btn:hover{background:#4a2e1a}
    .submit-btn:disabled{background:#ccc;cursor:not-allowed}
    #msg{text-align:center;padding:.75rem;border-radius:10px;margin-top:.75rem;display:none;font-size:.9rem}
  </style>
</head>
<body>
  <header>
    <a href="/community">← 커뮤니티</a>
    <span>›</span>
    <span>글쓰기</span>
  </header>
  <div class="container">
    <div class="card">
      <h1>✏️ 글쓰기</h1>
      {slug && (
        <div class="pbadge">{region} {age} {sex} · {personaType}</div>
      )}
      <div class="field">
        <label>제목</label>
        <input type="text" id="title" placeholder="제목을 입력하세요" maxlength="100" oninput="updateChar()" />
        <div class="char-count"><span id="title-len">0</span>/100</div>
      </div>
      <div class="field">
        <label>내용</label>
        <textarea id="content" placeholder="같은 조건 한국인들과 이야기를 나눠보세요..." maxlength="3000" oninput="updateChar()"></textarea>
        <div class="char-count"><span id="content-len">0</span>/3000</div>
      </div>
      <button class="submit-btn" id="submit-btn" onclick="submitPost()">게시하기</button>
      <div id="msg"></div>
    </div>
  </div>
  <script define:vars={{ slug, personaType, region, sex, age }}>
  function updateChar() {
    document.getElementById('title-len').textContent = document.getElementById('title').value.length;
    document.getElementById('content-len').textContent = document.getElementById('content').value.length;
  }
  async function submitPost() {
    const title = document.getElementById('title').value.trim();
    const content = document.getElementById('content').value.trim();
    const msg = document.getElementById('msg');
    const btn = document.getElementById('submit-btn');
    if (!title || !content) {
      msg.style.cssText = 'display:block;background:#fee2e2;color:#dc2626';
      msg.textContent = '제목과 내용을 모두 입력해 주세요.';
      return;
    }
    btn.disabled = true;
    btn.textContent = '게시 중...';
    try {
      const res = await fetch('/api/community/posts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ persona_slug: slug, persona_type: personaType, region, sex, age, title, content })
      });
      const data = await res.json();
      if (data.ok) {
        window.location.href = `/community/${data.id}`;
      } else {
        msg.style.cssText = 'display:block;background:#fee2e2;color:#dc2626';
        msg.textContent = data.error === 'unauthorized' ? '로그인이 필요합니다.' : '오류가 발생했습니다.';
        btn.disabled = false; btn.textContent = '게시하기';
      }
    } catch {
      msg.style.cssText = 'display:block;background:#fee2e2;color:#dc2626';
      msg.textContent = '네트워크 오류가 발생했습니다.';
      btn.disabled = false; btn.textContent = '게시하기';
    }
  }
  </script>
</body>
</html>
