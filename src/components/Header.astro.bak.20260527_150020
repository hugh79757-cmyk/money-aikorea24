---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchBar from './SearchBar.astro';
import { SITE_TITLE } from '../consts';
---
<header>
  <nav>
    <a href="/" class="site-title">
      <span class="logo-kr">🇰🇷</span>
      <span>{SITE_TITLE}</span>
    </a>
    <div class="nav-links">
      <a href="/my-persona" class="nav-persona">🔍 내 페르소나</a>
      <div class="nav-menu-group">
        <HeaderLink href="/blog/category/insurance">🛡️ 보험</HeaderLink>
        <HeaderLink href="/blog/category/invest">📈 투자·절세</HeaderLink>
        <HeaderLink href="/blog/category/loan">🏠 대출·부동산</HeaderLink>
        <HeaderLink href="/blog/category/tax">💰 세금·절약</HeaderLink>
      </div>
      <a href="/benefits" class="nav-benefits">⏰ 지원금</a>
      <a href="/community" class="nav-community">💬 커뮤니티</a>
      <SearchBar />
      <a href="/auth/login" class="nav-kakao" id="btn-login">
        <svg width="16" height="16" viewBox="0 0 40 40" fill="none" style="flex-shrink:0">
          <path d="M20 4C11.163 4 4 9.82 4 17c0 4.747 3.027 8.91 7.627 11.367L9.8 35.08a.5.5 0 0 0 .717.543L17.64 31.2c.778.1 1.573.153 2.36.153 8.837 0 16-5.82 16-13S28.837 4 20 4z" fill="#3D3D3D"/>
        </svg>
        카카오 로그인
      </a>
      <span class="nav-user" id="btn-user">
        <span id="user-name"></span>
        <a href="/api/auth/logout" class="nav-logout">로그아웃</a>
      </span>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
(function() {
  // session_ui: non-HttpOnly 쿠키 (UI 표시 전용, 이름/ID만 포함)
  const raw = document.cookie.split(';').find(c => c.trim().startsWith('session_ui='));
  const btnLogin = document.getElementById('btn-login');
  const btnUser  = document.getElementById('btn-user');
  const userName = document.getElementById('user-name');
  if (raw) {
    try {
      const encoded = raw.trim().replace('session_ui=', '');
      const user = JSON.parse(decodeURIComponent(atob(encoded).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join('')));
      if (btnLogin) btnLogin.style.display = 'none';
      if (btnUser)  btnUser.style.display  = 'flex';
      if (userName && user.name) userName.textContent = `👤 ${user.name}`;
    } catch {}
  } else {
    if (btnUser) btnUser.style.display = 'none';
  }
})();
</script>

<style>
  header {
    margin: 0;
    padding: 0;
    background: var(--color-header-bg);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    box-shadow: var(--shadow-md);
    width: 100%;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
    gap: var(--space-2);
    width: 100%;
    box-sizing: border-box;
  }
  .site-title {
    font-size: var(--text-base);
    font-weight: var(--font-extrabold);
    color: var(--color-surface);
    text-decoration: none;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-shrink: 0;
  }
  .logo-kr { font-size: 1.1rem; }
  .nav-links {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: nowrap;
  }
  .nav-persona {
    background: var(--color-accent);
    color: var(--color-surface) !important;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    text-decoration: none !important;
    white-space: nowrap;
    box-shadow: var(--shadow-accent);
    transition: background var(--transition-fast);
  }
  .nav-persona:hover { background: var(--color-accent-dark); }
  .nav-benefits, .nav-community {
    background: rgba(255,255,255,0.1);
    color: var(--color-surface) !important;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    text-decoration: none !important;
    white-space: nowrap;
    border: 1px solid rgba(255,255,255,0.18);
    transition: background var(--transition-fast);
  }
  .nav-benefits:hover, .nav-community:hover { background: rgba(255,255,255,0.2); }
  .nav-kakao {
    background: var(--color-kakao);
    color: var(--color-kakao-text) !important;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    text-decoration: none !important;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    transition: background var(--transition-fast);
    flex-shrink: 0;
  }
  .nav-kakao:hover { background: #F5D800; }
  .nav-user {
    display: none;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
    flex-shrink: 0;
  }
  #user-name {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.9);
    font-weight: var(--font-semibold);
  }
  .nav-logout {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.5) !important;
    text-decoration: underline !important;
    cursor: pointer;
  }
  .nav-menu-group {
    display: flex;
    gap: var(--space-1);
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--radius-lg);
    padding: var(--space-1) var(--space-2);
  }
  .nav-menu-group :global(a) {
    color: rgba(255,255,255,0.85) !important;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none !important;
    transition: background var(--transition-fast);
    white-space: nowrap;
  }
  .nav-menu-group :global(a:hover),
  .nav-menu-group :global(a.active) {
    background: rgba(255,255,255,0.15);
    color: var(--color-surface) !important;
  }

  /* 태블릿 */
  @media (max-width: 900px) {
    .nav-menu-group { display: none; }
  }

  /* 모바일 — 전체 너비 꽉 */
  @media (max-width: 640px) {
    header { width: 100%; }
    nav {
      padding: var(--space-2) var(--space-3);
      gap: var(--space-2);
      width: 100%;
    }
    .nav-benefits, .nav-benefits, .nav-community { display: none; }
    .site-title { font-size: 0.92rem; }
    .nav-persona {
      font-size: var(--text-xs);
      padding: var(--space-2) var(--space-3);
    }
    .nav-kakao {
      font-size: var(--text-xs);
      padding: var(--space-2) var(--space-3);
    }
    .nav-kakao svg { display: none; }
  }
</style>
