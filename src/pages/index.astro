---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION, COLLECTIONS } from '../consts';
import { getCollection } from 'astro:content';

// blog 컬렉션 단일 쿼리 후 category 필드로 분류
const blogPosts = await getCollection('blog', ({ data }) => !data.draft);

const allPosts = COLLECTIONS.flatMap((col) => {
  return blogPosts
    .filter((p) => p.data.category === col.id)
    .sort((a, b) => {
      const da = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
      const db = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
      return db - da;
    })
    .slice(0, 3)
    .map((p) => ({ ...p, collectionId: col.id, collectionLabel: col.label }));
});

// pubDate 최신순 정렬
allPosts.sort((a, b) => {
  const da = a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
  const db = b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
  return db - da;
});

const recentPosts = allPosts.slice(0, 6);

import benefitsData from '../../public/benefits-clean.json';

// ── 페르소나 인덱스 허브 데이터 ──
const REGIONS = [
  '서울', '경기', '인천', '부산', '대구', '대전', '광주', '울산', '세종',
  '강원', '충청북', '충청남', '전북', '전라남', '경상북', '경상남', '제주'
]; // 17개 (persona-stats.json 키와 일치: 전북⚠️, 전라남✅, 경상남✅)

const GENDERS = ['남자', '여자']; // 2개

const AGE_GROUPS = [
  { label: '20대', slug: '20대' },
  { label: '30대', slug: '30대' },
  { label: '40대', slug: '40대' },
  { label: '50대', slug: '50대' },
  { label: '60대', slug: '60대' },
  { label: '70대 이상', slug: '70대이상' },
]; // 6개 → 총 17 × 2 × 6 = 204개
const _today = new Date();
function _daysLeft(d) {
  if (!d) return null;
  const m = String(d).match(/(\d{4})[-.](\d{1,2})[-.](\d{1,2})/);
  if (!m) return null;
  const dt = new Date(+m[1], +m[2]-1, +m[3]);
  return Math.ceil((dt - _today) / 86400000);
}
const urgentBenefits = benefitsData
  .map(b => ({...b, _d: _daysLeft(b.deadline)}))
  .filter(b => b._d !== null && b._d > 0 && b._d <= 30)
  .sort((a,b) => a._d - b._d)
  .slice(0, 5);
---

<html lang="ko">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="persona-hero">
        <div class="persona-hero-text">
          <a href="/data/nemotron-korea" class="persona-badge nvidia-data-btn">
            <span>🟢 Nvidia 700만 한국인 데이터</span>
            <span class="nvidia-sub">엔비디아 Nemotron-Personas-Korea 데이터셋이란? →</span>
          </a>
          <h2>나와 비슷한 한국인은<br/>어떻게 살고 있을까?</h2>
          <p>나이·성별·지역·혼인상태만 입력하면<br/>주거·직업·가족구성·돈 고민을 통계로 보여드려요</p>
          <div class="hero-trust-row">
            <span>🔒 개인정보 미수집</span>
            <span>⚡ 즉시 결과</span>
            <span>🆓 무료</span>
          </div>
          <a href="/my-persona" class="persona-cta-btn">1분 만에 내 페르소나 분석하기 →</a>
        </div>
        <div class="persona-hero-img">
          <img src="/cards/서울_남자_35.jpg" alt="한국인 페르소나 분석 카드 예시" loading="eager" />
        </div>
      </section>

      <section class="urgent-benefits">
        <div class="urgent-head">
          <h2>⏰ 마감 임박 지원금</h2>
          <a href="/benefits" class="urgent-more">전체보기 →</a>
        </div>
        <div class="urgent-list">
          {urgentBenefits.map(b => (
            <a href="/benefits" class="urgent-item">
              <div class="urgent-info">
                <div class="urgent-name">{b.name}</div>
                <div class="urgent-org">{b.org}</div>
              </div>
              <div class={`urgent-dday ${b._d <= 7 ? 'red' : ''}`}>D-{b._d}</div>
            </a>
          ))}
        </div>
      </section>

      <section class="hero">
        <h1>AI 시대, 돈을 더 잘 다루는 방법</h1>
        <p>보험, 투자, 대출, 세금, 디지털노마드 부업까지<br />실전 가이드를 무료로 제공합니다.</p>
      </section>

      <section class="categories">
        {COLLECTIONS.map((col) => (
          <a href={"/blog/category/" + col.id + "/"} class="cat-card">
            <strong>{col.label}</strong>
            <span>{col.desc}</span>
          </a>
        ))}
      </section>

      <section class="recent">
        <div class="section-header">
          <h2>📝 최신 금융 가이드</h2>
          <p class="section-sub">페르소나 분석 결과와 연결되는 실전 가이드</p>
        </div>
        <ul>
          {recentPosts.map((post) => (
            <li>
              <a href={"/blog/" + post.id + "/"}>
                <div class="card-top">
                  <span class="badge">{post.collectionLabel}</span>
                  {post.data.pubDate && (
                    <time><FormattedDate date={post.data.pubDate} /></time>
                  )}
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="read-more">읽기 →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <!-- 페르소나 인덱스 허브 (SEO: 메인 → 204개 페르소나 페이지 내부 링크) -->
    <section class="persona-index-hub" aria-label="지역별 페르소나 인덱스">
      <div class="container">
        <header class="hub-header">
          <h2>지역별 한국인 페르소나 둘러보기</h2>
          <p>17개 광역지자체 × 성별 × 연령대 — 204개 페르소나 분석</p>
        </header>

        {REGIONS.map(region => (
          <article class="region-block">
            <h3>{region}</h3>
            <div class="links-grid">
              {GENDERS.map(gender =>
                AGE_GROUPS.map(age => (
                  <a
                    href={`/persona/${region}-${gender}-${age.slug}/`}
                    class="persona-link"
                  >
                    {region} {gender} {age.label}
                  </a>
                ))
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <Footer />
  </body>
</html>

<style>
  /* 디자인 토큰은 design-tokens.css에서 가져옴 */
  body { background: var(--color-bg); color: var(--color-text); font-family: var(--font-sans); }
  main { max-width: var(--container-xl); margin: 0 auto; padding: 0 var(--space-4); }

  /* ── 페르소나 히어로 ── */
  .persona-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    align-items: center;
    background: var(--color-header-bg);
    border-radius: var(--radius-3xl);
    padding: var(--space-12) var(--space-10);
    margin: var(--space-8) 0;
    color: white;
    position: relative;
    overflow: hidden;
  }
  .persona-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/cards/서울_남자_35.jpg') center/cover no-repeat;
    opacity: 0.08;
  }
  .persona-hero-text { position: relative; z-index: 1; }
  .persona-badge {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.25);
    color: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-wider);
    margin-bottom: var(--space-5);
    text-decoration: none;
    transition: background var(--transition-fast), border-color var(--transition-fast);
    gap: 2px;
  }
  .nvidia-data-btn:hover {
    background: rgba(118,185,0,0.25);
    border-color: #76b900;
  }
  .nvidia-sub {
    font-size: 0.72rem;
    font-weight: var(--font-semibold);
    opacity: 0.85;
    letter-spacing: 0;
    color: #b8e06a;
  }
  .persona-hero h2 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: var(--font-extrabold);
    margin-bottom: var(--space-3);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-surface);
    text-shadow: 0 2px 8px rgba(0,0,0,0.18);
  }
  .persona-hero p {
    font-size: var(--text-base);
    opacity: 0.85;
    margin-bottom: var(--space-3);
    line-height: var(--leading-normal);
  }
  .hero-trust-row {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }
  .hero-trust-row span {
    font-size: var(--text-xs);
    background: rgba(255,255,255,0.12);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-weight: var(--font-semibold);
  }
  .persona-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-accent);
    color: var(--color-surface);
    font-weight: var(--font-bold);
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-lg);
    text-decoration: none;
    font-size: var(--text-md);
    box-shadow: var(--shadow-accent);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .persona-cta-btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-accent-lg); }
  .persona-hero-img { position: relative; z-index: 1; }
  .persona-hero-img img {
    width: 100%;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    display: block;
  }
  @media (max-width: 640px) {
    .persona-hero { grid-template-columns: 1fr; padding: var(--space-8) var(--space-6); }
    .persona-hero-img { display: none; }
  }

  /* ── 서브 히어로 ── */
  .hero {
    text-align: center;
    padding: var(--space-10) var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-8);
  }
  .hero h1 { font-size: var(--text-2xl); font-weight: var(--font-extrabold); color: var(--color-primary); margin-bottom: var(--space-3); letter-spacing: var(--tracking-tight); }
  .hero p { color: var(--color-muted); font-size: var(--text-base); line-height: 1.7; }

  /* ── 카테고리 카드 ── */
  .categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-10);
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
  }
  .cat-card:hover { border-color: var(--color-accent); transform: translateY(-2px); box-shadow: var(--shadow-primary); }
  .cat-card strong { font-size: 0.95rem; color: var(--color-primary); font-weight: var(--font-bold); }
  .cat-card span { font-size: var(--text-sm); color: var(--color-muted); line-height: 1.4; }

  /* ── 최신 글 ── */
  .section-header { margin: 0 0 var(--space-6); }
  .section-header h2 { font-size: 1.3rem; font-weight: var(--font-extrabold); color: var(--color-primary); margin: 0 0 var(--space-1); letter-spacing: var(--tracking-tight); }
  .section-sub { font-size: var(--text-sm); color: var(--color-muted); margin: 0; }
  .recent ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }
  .recent li a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
    height: 100%;
    box-shadow: var(--shadow-sm);
  }
  .recent li a:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .badge {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    background: var(--color-accent);
    color: var(--color-surface);
    border-radius: var(--radius-full);
    display: inline-block;
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-wide);
    white-space: nowrap;
  }
  .recent h3 {
    font-size: 0.97rem;
    font-weight: var(--font-bold);
    margin: 0;
    line-height: var(--leading-snug);
    color: var(--color-primary);
    letter-spacing: -0.01em;
  }
  .recent p {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0;
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .read-more {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-accent);
    margin-top: auto;
  }
  time { font-size: var(--text-xs); color: var(--color-placeholder); white-space: nowrap; }

  .urgent-benefits { max-width: var(--container-lg); margin: var(--space-6) auto var(--space-8); padding: 0 var(--space-4); }
  .urgent-head { display:flex; justify-content:space-between; align-items:center; margin-bottom: var(--space-3) }
  .urgent-head h2 { font-size: var(--text-lg); font-weight: var(--font-extrabold); color: var(--color-kakao-text); margin: 0 }
  .urgent-more { font-size: var(--text-sm); color: var(--color-benefit); font-weight: var(--font-semibold); text-decoration: none }
  .urgent-list { display: grid; gap: var(--space-2) }
  .urgent-item { display:flex; justify-content:space-between; align-items:center; gap: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-3) var(--space-4); text-decoration:none; color:inherit; box-shadow: var(--shadow-sm) }
  .urgent-item:hover { box-shadow: var(--shadow-md); border-color: var(--color-border-dark); }
  .urgent-info { flex:1; min-width:0 }
  .urgent-name { font-weight: var(--font-bold); font-size: 0.95rem; color: var(--color-kakao-text); line-height: 1.4; margin-bottom: var(--space-1) }
  .urgent-org { font-size: var(--text-xs); color: var(--color-benefit-light) }
  .urgent-dday { flex-shrink:0; background: var(--color-accent-light); color: #1a1a1a; border-radius: var(--radius-md); padding: var(--space-2) var(--space-3); font-weight: var(--font-bold); font-size: var(--text-sm); min-width:50px; text-align:center }
  .urgent-dday.red { background: var(--color-error); color: #fff; }

  /* ── 페르소나 인덱스 허브 ── */
  .persona-index-hub {
    background: var(--color-bg-alt, #f8fafc);
    padding: var(--space-16, 4rem) var(--space-4, 1rem);
    margin-top: var(--space-10, 2.5rem);
    border-top: 1px solid var(--color-border, #e5e7eb);
  }
  .persona-index-hub .container {
    max-width: var(--container-xl, 1200px);
    margin: 0 auto;
  }
  .hub-header {
    margin-bottom: var(--space-10, 2.5rem);
  }
  .hub-header h2 {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: var(--font-extrabold, 800);
    text-align: center;
    color: var(--color-primary, #1E3A5F);
    margin: 0 0 var(--space-2, 0.5rem);
    letter-spacing: var(--tracking-tight, -0.02em);
  }
  .hub-header p {
    font-size: var(--text-sm, 0.875rem);
    color: var(--color-muted, #4B5563);
    text-align: center;
    margin: 0;
  }
  .region-block {
    margin-bottom: var(--space-8, 2rem);
  }
  .region-block h3 {
    font-size: var(--text-lg, 1.125rem);
    font-weight: var(--font-semibold, 600);
    color: var(--color-text-secondary, #374151);
    margin: 0 0 var(--space-3, 0.75rem);
    padding-left: var(--space-3, 0.75rem);
    border-left: 4px solid var(--color-accent, #D97706);
  }
  .links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2, 0.5rem);
  }
  @media (min-width: 640px) {
    .links-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 768px) {
    .links-grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 1024px) {
    .links-grid { grid-template-columns: repeat(6, 1fr); }
  }
  .persona-link {
    display: block;
    text-align: center;
    font-size: var(--text-sm, 0.875rem);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    border-radius: var(--radius-md, 8px);
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-border, #e5e7eb);
    color: var(--color-muted, #4B5563);
    text-decoration: none;
    transition: background var(--transition-fast, 0.15s),
                border-color var(--transition-fast, 0.15s),
                color var(--transition-fast, 0.15s);
  }
  .persona-link:hover {
    background: rgba(217, 119, 6, 0.05);
    border-color: var(--color-accent-light, #F59E0B);
    color: var(--color-accent-dark, #B45309);
  }
</style>
