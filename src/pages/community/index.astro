---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<html lang="ko">
<head>
  <BaseHead
    title="페르소나 커뮤니티 | persona.aikorea24.kr"
    description="같은 페르소나를 가진 사람들과 이야기를 나눠보세요"
  />
  <style>
    /* ── 공통 ── */
    a { color: inherit; text-decoration: none; }

    /* ── 글쓰기 툴바 (헤더 외부) ── */
    .community-toolbar {
      max-width: 800px;
      margin: 1.5rem auto 0;
      padding: 0 1rem;
      display: flex;
      justify-content: flex-end;
      gap: .5rem;
    }
    .btn-write {
      background: var(--color-surface);
      border: 1.5px solid var(--color-border);
      color: var(--color-benefit);
      padding: .5rem 1rem;
      border-radius: 10px;
      font-weight: 700;
      font-size: .88rem;
      text-decoration: none;
      display: none; /* 로그인 시 JS로 show */
      transition: background .12s;
    }
    .btn-write:hover { background: var(--color-bg); }

    /* ── 컨테이너 ── */
    .container {
      max-width: 760px;
      margin: 0 auto;
      padding: 1.5rem 1rem;
    }

    h1 {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--color-benefit);
      margin: 0 0 .25rem;
    }
    .sub {
      color: var(--color-muted);
      font-size: .88rem;
      margin-bottom: 1.25rem;
    }

    /* ── 검색 ── */
    .search-bar { display: flex; gap: .5rem; margin-bottom: 1.25rem; }
    .search-bar input {
      flex: 1;
      border: 1.5px solid var(--color-border);
      border-radius: 10px;
      padding: .65rem 1rem;
      font-size: .95rem;
      background: var(--color-surface);
      color: var(--color-text);
      outline: none;
      font-family: inherit;
    }
    .search-bar input::placeholder { color: var(--color-placeholder); }
    .search-bar input:focus { border-color: var(--color-benefit); }
    .search-bar button {
      background: var(--color-benefit);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: .65rem 1.2rem;
      font-size: .92rem;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
    }

    /* ── 게시판 탭 ── */
    .board-tabs { display: flex; gap: .5rem; margin-bottom: 1.25rem; }
    .board-tab {
      flex: 1;
      text-align: center;
      padding: .65rem;
      border-radius: 12px;
      font-size: .92rem;
      font-weight: 700;
      border: 2px solid var(--color-border);
      color: var(--color-muted);
      background: var(--color-surface);
      cursor: pointer;
      transition: all .15s;
      font-family: inherit;
    }
    .board-tab.active {
      background: var(--color-benefit);
      color: #fff;
      border-color: var(--color-benefit);
    }

    /* ── 게시글 목록 컨테이너 ── */
    .post-list {
      background: var(--color-surface);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(107,66,38,.08);
      margin-bottom: 1.25rem;
      min-height: 200px;
    }

    /* ── 동적 생성 요소: :global() ── */
    /* .post-item, .post-meta 등은 loadPosts()의 innerHTML로 생성됨 */
    :global(.post-item) {
      display: flex;
      flex-direction: column;
      gap: .3rem;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--color-border);
      transition: background .15s;
      cursor: pointer;
      text-decoration: none;
      color: inherit;
    }
    :global(.post-item:last-child) { border-bottom: none; }
    :global(.post-item:hover) { background: var(--color-bg); }

    :global(.post-meta) {
      display: flex;
      gap: .5rem;
      align-items: center;
      flex-wrap: wrap;
    }
    :global(.pbadge) {
      background: var(--color-bg);
      color: var(--color-benefit);
      border: 1px solid var(--color-border);
      border-radius: 20px;
      padding: .18rem .65rem;
      font-size: .73rem;
      font-weight: 700;
    }
    :global(.ptype) { font-size: .75rem; color: var(--color-muted); }

    :global(.post-title) {
      font-size: .97rem;
      font-weight: 700;
      color: var(--color-text);
      line-height: 1.4;
    }
    :global(.ccnt) { color: var(--color-benefit); font-size: .85rem; margin-left: .3rem; }

    :global(.post-info) {
      font-size: .76rem;
      color: var(--color-muted);
      display: flex;
      gap: .6rem;
    }

    :global(.empty) {
      text-align: center;
      padding: 3.5rem 1rem;
      color: var(--color-muted);
    }
    :global(.loading) {
      text-align: center;
      padding: 3rem;
      color: var(--color-muted);
    }

    /* ── 페이지네이션 (동적 생성) ── */
    .pagination {
      display: flex;
      justify-content: center;
      gap: .4rem;
      margin-top: 1rem;
      flex-wrap: wrap;
    }
    :global(.pagination button) {
      padding: .5rem .9rem;
      border-radius: 8px;
      font-size: .85rem;
      font-weight: 600;
      border: 1.5px solid var(--color-border);
      color: var(--color-benefit);
      background: var(--color-surface);
      cursor: pointer;
      font-family: inherit;
      transition: all .12s;
    }
    :global(.pagination button.active) {
      background: var(--color-benefit);
      color: #fff;
      border-color: var(--color-benefit);
    }
    :global(.pagination button:hover:not(.active)) {
      background: var(--color-bg);
    }

    .total {
      text-align: center;
      margin-top: .75rem;
      font-size: .8rem;
      color: var(--color-muted);
    }

    /* ── 포스트 목록 인라인 광고 (동적 생성 → :global) ── */
    :global(.post-inline-ad) {
      position: relative;
      padding: .75rem 1.25rem 1rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-surface);
      min-height: 90px;
      width: 100%;
      text-align: center;
    }
    :global(.post-ad-label) {
      position: absolute;
      top: 6px; right: 10px;
      font-size: .62rem;
      color: var(--color-placeholder);
      letter-spacing: .04em;
    }
    :global(.post-ad-ins) {
      display: block !important;
    }
  </style>
</head>
<body>
  <Header />

  <!-- persona-community 상단 광고 -->
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="ca-pub-5938862195544185"
       data-ad-slot="9747654190"
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>

  <div class="community-toolbar">
    <a class="btn-write" id="btn-write" href="/community/write">✏️ 글쓰기</a>
  </div>

  <div class="container">
    <h1>💬 페르소나 커뮤니티</h1>
    <p class="sub" id="board-sub">같은 페르소나를 가진 사람들과 이야기를 나눠보세요</p>

    <div class="board-tabs">
      <button class="board-tab active" id="tab-persona" onclick="switchBoard('persona')">💬 페르소나</button>
      <button class="board-tab" id="tab-benefit" onclick="switchBoard('benefit')">💰 지원금</button>
    </div>

    <div class="search-bar">
      <input id="search-input" placeholder="게시글 검색..." />
      <button onclick="doSearch()">검색</button>
    </div>

    <div class="post-list" id="post-list"><div class="loading">불러오는 중...</div></div>
    <div class="pagination" id="pagination"></div>
    <div class="total" id="total"></div>
  </div>

  <script is:inline>
  function escapeHtml(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  var _qs    = new URLSearchParams(location.search);
  var _slug  = _qs.get('slug')  || '';
  var _board = _qs.get('board') || 'persona';
  var _q     = _qs.get('q')     || '';

  if (_board === 'benefit') {
    document.getElementById('tab-persona').classList.remove('active');
    document.getElementById('tab-benefit').classList.add('active');
  }
  document.getElementById('search-input').value = _q;

  /* 로그인 상태 → 글쓰기 버튼 표시 (헤더 로그인 버튼은 Header.astro가 처리) */
  var _session = document.cookie.split(';').find(function(c) { return c.trim().startsWith('session_ui='); });
  if (_session) {
    var _wBtn = document.getElementById('btn-write');
    if (_wBtn) {
      _wBtn.style.display = 'inline-block';
      if (_slug) _wBtn.href = '/community/write?slug=' + _slug;
    }
  }

  function switchBoard(b) {
    _board = b;
    document.querySelectorAll('.board-tab').forEach(function(t) { t.classList.remove('active'); });
    document.getElementById('tab-' + b).classList.add('active');
    document.getElementById('board-sub').textContent =
      b === 'persona' ? '같은 페르소나를 가진 사람들과 이야기를 나눠보세요' : '지원금 신청 정보와 후기를 나눠보세요';
    loadPosts(1);
  }

  function doSearch() {
    _q = document.getElementById('search-input').value.trim();
    loadPosts(1);
  }

  async function loadPosts(page) {
    page = page || 1;
    var list = document.getElementById('post-list');
    list.innerHTML = '<div class="loading">불러오는 중...</div>';

    var url = '/api/community/posts?page=' + page + '&board=' + encodeURIComponent(_board);
    if (_slug) url += '&slug=' + encodeURIComponent(_slug);
    if (_q)    url += '&q='    + encodeURIComponent(_q);

    try {
      var res   = await fetch(url);
      var data  = await res.json();
      var posts = data.posts || [];
      var total = data.total || 0;

      document.getElementById('total').textContent = '총 ' + total + '개의 게시글';

      /* ── 인라인 광고 HTML
         실제 운영 시 data-ad-slot 값을 AdSense 콘솔의 광고 단위 ID로 교체할 것 */
      var AD_HTML =
        '<div class="post-inline-ad">' +
          '<span class="post-ad-label">광고</span>' +
          '<ins class="adsbygoogle post-ad-ins"' +
            ' style="display:block; width:100%; text-align:center"' +
            ' data-ad-client="ca-pub-5938862195544185"' +
            ' data-ad-slot=""' + /* TODO: AdSense 콘솔에서 발급받은 광고 단위 ID */
            ' data-ad-format="auto"' +
            ' data-full-width-responsive="true">' +
          '</ins>' +
        '</div>';

      if (posts.length === 0) {
        list.innerHTML = '<div class="empty"><p>아직 글이 없어요</p>' +
          (_session ? '<a href="/community/write" style="color:#6B4226;font-weight:700;margin-top:.5rem;display:inline-block">첫 글 써보기 →</a>' : '') +
          '</div>';
      } else {
        /* 5번째 포스트마다 인라인 광고 삽입 */
        list.innerHTML = posts.map(function(p, i) {
          var cmtBadge = p.comment_count > 0
            ? '<span class="ccnt">[' + parseInt(p.comment_count) + ']</span>' : '';
          var postHtml = '<a class="post-item" href="/community/' + (parseInt(p.id)||0) + '">' +
            '<div class="post-meta">' +
              '<span class="pbadge">' + escapeHtml(p.region) + ' ' + escapeHtml(p.age) + ' ' + escapeHtml(p.sex) + '</span>' +
              '<span class="ptype">' + escapeHtml(p.persona_type) + '</span>' +
            '</div>' +
            '<div class="post-title">' + escapeHtml(p.title) + cmtBadge + '</div>' +
            '<div class="post-info">' +
              '<span>' + escapeHtml(p.author_name) + '</span>' +
              '<span>조회 ' + (parseInt(p.views)||0) + '</span>' +
              '<span>👍 ' + (parseInt(p.likes)||0) + '</span>' +
              '<span>' + escapeHtml((p.created_at||'').slice(0,10)) + '</span>' +
            '</div>' +
          '</a>';
          /* 5번째, 10번째, ... 포스트 뒤에 광고 삽입 (0-index 기준: 4, 9, ...) */
          if ((i + 1) % 5 === 0 && i < posts.length - 1) {
            postHtml += AD_HTML;
          }
          return postHtml;
        }).join('');

        /* innerHTML 완료 후 각 <ins>마다 push() 호출 */
        list.querySelectorAll('.post-ad-ins').forEach(function() {
          try { (adsbygoogle = window.adsbygoogle || []).push({}); } catch(e) {}
        });
      }

      /* 페이지네이션: 이벤트 위임 방식 */
      var totalPages = Math.ceil(total / 20);
      var pag = document.getElementById('pagination');
      if (totalPages <= 1) { pag.innerHTML = ''; return; }

      var html = '';
      if (page > 1) html += '<button data-page="' + (page - 1) + '">← 이전</button>';
      for (var i = Math.max(1, page - 2); i <= Math.min(totalPages, page + 2); i++) {
        html += '<button class="' + (i === page ? 'active' : '') + '" data-page="' + i + '">' + i + '</button>';
      }
      if (page < totalPages) html += '<button data-page="' + (page + 1) + '">다음 →</button>';
      pag.innerHTML = html;

    } catch(err) {
      list.innerHTML = '<div class="empty">불러오기 실패. 새로고침 해주세요.</div>';
    }
  }

  /* 페이지네이션 이벤트 위임 */
  document.getElementById('pagination').addEventListener('click', function(e) {
    var btn = e.target.closest('button[data-page]');
    if (btn) loadPosts(parseInt(btn.getAttribute('data-page'), 10));
  });

  document.getElementById('search-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') doSearch();
  });

  loadPosts(1);
  </script>

  <!-- persona-community 하단 광고 -->
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="ca-pub-5938862195544185"
       data-ad-slot="9747654190"
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>

  <Footer />
</body>
</html>
