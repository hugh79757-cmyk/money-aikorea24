---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---
<header>
  <nav>
    <a href="/" class="site-title">
      <span class="logo-kr">🇰🇷</span>
      <span>{SITE_TITLE}</span>
    </a>
    <div class="nav-links">
      <a href="/my-persona" class="nav-persona">🔍 내 페르소나</a>
      <div class="nav-menu-group">
        <HeaderLink href="/blog/category/insurance">🛡️ 보험</HeaderLink>
        <HeaderLink href="/blog/category/invest">📈 투자·절세</HeaderLink>
        <HeaderLink href="/blog/category/loan">🏠 대출·부동산</HeaderLink>
        <HeaderLink href="/blog/category/tax">💰 세금·절약</HeaderLink>
      </div>
      <a href="/benefits" class="nav-benefits">⏰ 지원금</a>
      <a href="/community" class="nav-community">💬 커뮤니티</a>
      <a href="/auth/login" class="nav-kakao" id="btn-login">
        <svg width="16" height="16" viewBox="0 0 40 40" fill="none" style="flex-shrink:0">
          <path d="M20 4C11.163 4 4 9.82 4 17c0 4.747 3.027 8.91 7.627 11.367L9.8 35.08a.5.5 0 0 0 .717.543L17.64 31.2c.778.1 1.573.153 2.36.153 8.837 0 16-5.82 16-13S28.837 4 20 4z" fill="#3D3D3D"/>
        </svg>
        카카오 로그인
      </a>
      <span class="nav-user" id="btn-user">
        <span id="user-name"></span>
        <a href="/api/auth/logout" class="nav-logout">로그아웃</a>
      </span>
    </div>
  </nav>
</header>

<script>
(function() {
  const raw = document.cookie.split(';').find(c => c.trim().startsWith('session='));
  const btnLogin = document.getElementById('btn-login');
  const btnUser  = document.getElementById('btn-user');
  const userName = document.getElementById('user-name');
  if (raw) {
    try {
      const encoded = raw.trim().replace('session=','');
      const user = JSON.parse(decodeURIComponent(atob(encoded).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join('')));
      if (btnLogin) btnLogin.style.display = 'none';
      if (btnUser)  btnUser.style.display  = 'flex';
      if (userName && user.name) userName.textContent = `👤 ${user.name}`;
    } catch {}
  } else {
    if (btnUser) btnUser.style.display = 'none';
  }
})();
</script>

<style>
  header {
    margin: 0;
    padding: 0;
    background: #1E3A5F;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 12px rgba(30,58,95,0.25);
    width: 100%;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.65em 1rem;
    gap: 0.5rem;
    width: 100%;
    box-sizing: border-box;
  }
  .site-title {
    font-size: 1rem;
    font-weight: 800;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }
  .logo-kr { font-size: 1.1rem; }
  .nav-links {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: nowrap;
  }
  .nav-persona {
    background: #D97706;
    color: #fff !important;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.42rem 0.9rem;
    border-radius: 99px;
    text-decoration: none !important;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(217,119,6,0.4);
    transition: background 0.15s;
  }
  .nav-persona:hover { background: #B45309; }
  .nav-community {
    background: rgba(255,255,255,0.1);
    color: #fff !important;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.42rem 0.8rem;
    border-radius: 99px;
    text-decoration: none !important;
    white-space: nowrap;
    border: 1px solid rgba(255,255,255,0.18);
    transition: background 0.15s;
  }
  .nav-community:hover { background: rgba(255,255,255,0.2); }
  .nav-kakao {
    background: #FEE500;
    color: #3D3D3D !important;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.42rem 0.85rem;
    border-radius: 99px;
    text-decoration: none !important;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    transition: background 0.15s;
    flex-shrink: 0;
  }
  .nav-kakao:hover { background: #F5D800; }
  .nav-user {
    display: none;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    flex-shrink: 0;
  }
  #user-name {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.9);
    font-weight: 600;
  }
  .nav-logout {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.5) !important;
    text-decoration: underline !important;
    cursor: pointer;
  }
  .nav-menu-group {
    display: flex;
    gap: 0.15rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 12px;
    padding: 0.28rem 0.35rem;
  }
  .nav-menu-group :global(a) {
    color: rgba(255,255,255,0.85) !important;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.32rem 0.6rem;
    border-radius: 8px;
    text-decoration: none !important;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .nav-menu-group :global(a:hover),
  .nav-menu-group :global(a.active) {
    background: rgba(255,255,255,0.15);
    color: #fff !important;
  }

  /* 태블릿 */
  @media (max-width: 900px) {
    .nav-menu-group { display: none; }
  }

  /* 모바일 — 전체 너비 꽉 */
  @media (max-width: 640px) {
    header { width: 100%; }
    nav {
      padding: 0.55em 0.75rem;
      gap: 0.4rem;
      width: 100%;
    }
    .nav-community { display: none; }
    .site-title { font-size: 0.92rem; }
    .nav-persona {
      font-size: 0.76rem;
      padding: 0.38rem 0.75rem;
    }
    .nav-kakao {
      font-size: 0.76rem;
      padding: 0.38rem 0.75rem;
    }
    .nav-kakao svg { display: none; }
  }
</style>
