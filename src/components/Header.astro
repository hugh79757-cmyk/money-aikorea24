---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchBar from './SearchBar.astro';
import { SITE_TITLE } from '../consts';
---
<header>
  <nav>
    <a href="/" class="site-title">
      <span class="logo-kr">🇰🇷</span>
      <span>{SITE_TITLE}</span>
    </a>
    <div class="nav-links">
      <a href="/my-persona" class="nav-persona">🔍 내 페르소나</a>
      <div class="nav-blog-wrap" id="nav-blog-wrap">
        <button class="nav-blog-btn" id="nav-blog-btn" type="button" aria-expanded="false" aria-haspopup="true">
          블로그 <span class="blog-arrow">▾</span>
        </button>
        <div class="blog-submenu" id="blog-submenu" role="menu">
          <a href="/blog" class="blog-sub-all">📋 전체 글 보기</a>
          <a href="/blog/category/insurance">🛡️ 보험</a>
          <a href="/blog/category/invest">📈 투자·절세</a>
          <a href="/blog/category/loan">🏠 대출·부동산</a>
        </div>
      </div>
      <a href="/benefits" class="nav-benefits">지원금</a>
      <a href="/community" class="nav-community">커뮤니티</a>
      <SearchBar />
      <a href="/auth/login" class="nav-kakao" id="btn-login">
        <svg width="16" height="16" viewBox="0 0 40 40" fill="none" style="flex-shrink:0">
          <path d="M20 4C11.163 4 4 9.82 4 17c0 4.747 3.027 8.91 7.627 11.367L9.8 35.08a.5.5 0 0 0 .717.543L17.64 31.2c.778.1 1.573.153 2.36.153 8.837 0 16-5.82 16-13S28.837 4 20 4z" fill="#3D3D3D"/>
        </svg>
        <span class="kakao-label">카카오 로그인</span>
      </a>
      <span class="nav-user" id="btn-user">
        <span id="user-name"></span>
        <a href="/api/auth/logout" class="nav-logout">로그아웃</a>
      </span>
      <ThemeToggle />
      <button class="hamburger" id="hamburger-btn" type="button" aria-label="메뉴 열기" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>

    <!-- ── 모바일 햄버거 메뉴 ── -->
    <div class="mobile-menu" id="mobile-menu" role="navigation" aria-label="모바일 네비게이션">
      <a href="/my-persona" class="mobile-link">🔍 내 페르소나</a>

      <div class="mobile-blog-wrap">
        <button class="mobile-blog-btn" type="button" aria-expanded="false">블로그 <span class="blog-arrow">▾</span></button>
        <div class="mobile-blog-sub">
          <a href="/blog" class="mobile-link">📋 전체 글 보기</a>
          <a href="/blog/category/insurance" class="mobile-link">🛡️ 보험</a>
          <a href="/blog/category/invest" class="mobile-link">📈 투자·절세</a>
          <a href="/blog/category/loan" class="mobile-link">🏠 대출·부동산</a>
        </div>
      </div>

      <a href="/benefits" class="mobile-link">지원금</a>
      <a href="/community" class="mobile-link">커뮤니티</a>
      <hr class="mobile-divider" />
      <a href="/auth/login" class="mobile-link mobile-login" id="mobile-btn-login">
        <svg width="16" height="16" viewBox="0 0 40 40" fill="none" style="flex-shrink:0;vertical-align:middle;margin-right:6px;">
          <path d="M20 4C11.163 4 4 9.82 4 17c0 4.747 3.027 8.91 7.627 11.367L9.8 35.08a.5.5 0 0 0 .717.543L17.64 31.2c.778.1 1.573.153 2.36.153 8.837 0 16-5.82 16-13S28.837 4 20 4z" fill="#3D3D3D"/>
        </svg>
        카카오 로그인
      </a>
      <span class="mobile-user" id="mobile-btn-user" style="display:none;">
        <span id="mobile-user-name"></span>
        <a href="/api/auth/logout" class="mobile-link" style="opacity:.7;font-size:.8rem;">로그아웃</a>
      </span>
    </div>
  </nav>
</header>

<script>
(function() {
  // session_ui: non-HttpOnly 쿠키 (UI 표시 전용, 이름/ID만 포함)
  const raw = document.cookie.split(';').find(c => c.trim().startsWith('session_ui='));
  const btnLogin = document.getElementById('btn-login');
  const btnUser  = document.getElementById('btn-user');
  const userName = document.getElementById('user-name');
  if (raw) {
    try {
      const encoded = raw.trim().replace('session_ui=', '');
      const user = JSON.parse(decodeURIComponent(atob(encoded).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join('')));
      if (btnLogin) btnLogin.style.display = 'none';
      if (btnUser)  btnUser.style.display  = 'flex';
      if (userName && user.name) userName.textContent = `👤 ${user.name}`;
    } catch {}
  } else {
    if (btnUser) btnUser.style.display = 'none';
  }

  // 블로그 드롭다운 토글 (데스크탑)
  const blogWrap = document.getElementById('nav-blog-wrap');
  const blogBtn  = document.getElementById('nav-blog-btn');
  if (blogWrap && blogBtn) {
    blogBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = blogWrap.classList.toggle('open');
      blogBtn.setAttribute('aria-expanded', String(isOpen));
    });
    document.addEventListener('click', (e) => {
      if (!blogWrap.contains(e.target as Node)) {
        blogWrap.classList.remove('open');
        blogBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // ── 햄버거 메뉴 토글 ──
  const hamburger  = document.getElementById('hamburger-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (hamburger && mobileMenu) {
    hamburger.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('open');
      hamburger.classList.toggle('open');
      hamburger.setAttribute('aria-expanded', String(isOpen));
      hamburger.setAttribute('aria-label', isOpen ? '메뉴 닫기' : '메뉴 열기');
    });
    // 메뉴 링크 클릭 시 자동 닫기 (블로그 버튼 제외)
    mobileMenu.querySelectorAll('.mobile-link').forEach(function(link) {
      link.addEventListener('click', function() {
        mobileMenu.classList.remove('open');
        hamburger.classList.remove('open');
        hamburger.setAttribute('aria-expanded', 'false');
        hamburger.setAttribute('aria-label', '메뉴 열기');
      });
    });
  }

  // ── 모바일 블로그 서브메뉴 토글 ──
  const mobileBlogBtn = document.querySelector('.mobile-blog-btn');
  const mobileBlogSub = document.querySelector('.mobile-blog-sub');
  if (mobileBlogBtn && mobileBlogSub) {
    mobileBlogBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const isOpen = mobileBlogSub.classList.toggle('open');
      mobileBlogBtn.classList.toggle('open');
      mobileBlogBtn.setAttribute('aria-expanded', String(isOpen));
    });
  }

  // ── 세션 쿠키 동기화 to 모바일 ──
  if (raw) {
    var mobileLogin  = document.getElementById('mobile-btn-login');
    var mobileUser   = document.getElementById('mobile-btn-user');
    var mobileName   = document.getElementById('mobile-user-name');
    if (mobileLogin) mobileLogin.style.display = 'none';
    if (mobileUser)  mobileUser.style.display  = 'flex';
    if (mobileName && user && user.name) mobileName.textContent = `👤 ${user.name}`;
  } else {
    var mobileUser = document.getElementById('mobile-btn-user');
    if (mobileUser) mobileUser.style.display = 'none';
  }
})();
</script>

<style>
  header {
    margin: 0;
    padding: 0;
    background: var(--color-header-bg);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    box-shadow: var(--shadow-md);
    width: 100%;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
    gap: var(--space-2);
    width: 100%;
    box-sizing: border-box;
  }
  .site-title {
    font-size: var(--text-base);
    font-weight: var(--font-extrabold);
    color: var(--color-surface);
    text-decoration: none;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-shrink: 0;
  }
  .logo-kr { font-size: 1.1rem; }
  .nav-links {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: nowrap;
  }
  .nav-persona {
    background: var(--color-accent);
    color: var(--color-surface) !important;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    text-decoration: none !important;
    white-space: nowrap;
    box-shadow: var(--shadow-accent);
    transition: background var(--transition-fast);
    /* global.css min-height:44px 대응 — 세로 중앙 정렬 보장 */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }
  .nav-persona:hover { background: var(--color-accent-dark); }
  .nav-benefits, .nav-community {
    background: rgba(255,255,255,0.1);
    color: var(--color-surface) !important;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    text-decoration: none !important;
    white-space: nowrap;
    border: 1px solid rgba(255,255,255,0.18);
    transition: background var(--transition-fast);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }
  .nav-benefits:hover, .nav-community:hover { background: rgba(255,255,255,0.2); }
  .nav-kakao {
    background: var(--color-kakao);
    color: var(--color-kakao-text) !important;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    text-decoration: none !important;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    transition: background var(--transition-fast);
    flex-shrink: 0;
  }
  .nav-kakao:hover { background: #F5D800; }
  .nav-user {
    display: none;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
    flex-shrink: 0;
  }
  #user-name {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.9);
    font-weight: var(--font-semibold);
  }
  .nav-logout {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.5) !important;
    text-decoration: underline !important;
    cursor: pointer;
  }
  /* ── 블로그 드롭다운 ── */
  .nav-blog-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .nav-blog-btn {
    background: rgba(255,255,255,0.1);
    color: var(--color-surface) !important;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid rgba(255,255,255,0.18);
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--transition-fast);
    font-family: inherit;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-blog-btn:hover,
  .nav-blog-wrap:hover .nav-blog-btn { background: rgba(255,255,255,0.2); }
  .blog-arrow { font-size: 0.65rem; opacity: 0.75; }
  .blog-submenu {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-surface);
    border-radius: 12px;
    box-shadow: 0 8px 28px rgba(0,0,0,0.15);
    border: 1px solid var(--color-border);
    padding: 6px;
    min-width: 168px;
    z-index: 1000;
    flex-direction: column;
    gap: 2px;
  }
  /* 투명 브릿지: 버튼↔메뉴 사이 gap을 hover 영역으로 덮음 */
  .blog-submenu::before {
    content: '';
    position: absolute;
    top: -10px;
    left: -8px;
    right: -8px;
    height: 10px;
  }
  /* 클릭으로 open 클래스 토글 (데스크탑·모바일 통일) */
  .nav-blog-wrap.open .blog-submenu { display: flex; }
  /* 화살표 회전 */
  .nav-blog-wrap.open .blog-arrow { display: inline-block; transform: rotate(180deg); }
  .blog-submenu a {
    display: block;
    padding: 8px 12px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-text) !important;
    text-decoration: none !important;
    border-radius: 8px;
    white-space: nowrap;
    transition: background var(--transition-fast);
  }
  .blog-submenu a:hover { background: var(--color-bg); color: var(--color-benefit) !important; }
  .blog-sub-all {
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 4px;
    color: var(--color-benefit) !important;
    font-weight: 700 !important;
  }

  /* ── 햄버거 버튼 ── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 8px;
    cursor: pointer;
    padding: 6px;
    transition: background var(--transition-fast);
    flex-shrink: 0;
  }
  .hamburger:hover { background: rgba(255,255,255,0.2); }
  .hamburger-line {
    display: block;
    width: 20px;
    height: 2.5px;
    background: var(--color-surface);
    border-radius: 2px;
    transition: transform .2s, opacity .2s;
  }
  .hamburger.open .hamburger-line:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .hamburger.open .hamburger-line:nth-child(2) { opacity: 0; }
  .hamburger.open .hamburger-line:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  /* ── 모바일 메뉴 ── */
  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 8px 28px rgba(0,0,0,.12);
    padding: .75rem 1rem;
    flex-direction: column;
    gap: 2px;
    z-index: 999;
  }
  .mobile-menu.open { display: flex; }
  .mobile-link {
    display: block;
    padding: .7rem .8rem;
    font-size: .9rem;
    font-weight: 600;
    color: var(--color-text) !important;
    text-decoration: none !important;
    border-radius: 10px;
    transition: background var(--transition-fast);
  }
  .mobile-link:hover { background: var(--color-bg); }
  .mobile-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: .4rem 0;
  }
  .mobile-blog-btn {
    width: 100%;
    background: none;
    border: none;
    padding: .7rem .8rem;
    font-size: .9rem;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    border-radius: 10px;
    font-family: inherit;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: background var(--transition-fast);
  }
  .mobile-blog-btn:hover { background: var(--color-bg); }
  .mobile-blog-btn .blog-arrow { font-size: .65rem; opacity: .75; transition: transform .2s; }
  .mobile-blog-btn.open .blog-arrow { transform: rotate(180deg); }
  .mobile-blog-sub {
    display: none;
    padding: 0 0 .25rem .8rem;
    flex-direction: column;
    gap: 1px;
  }
  .mobile-blog-sub.open { display: flex; }
  .mobile-blog-sub .mobile-link { font-size: .85rem; font-weight: 500; }

  /* ── 태블릿 (900px 이하): 블로그 버튼 유지, 개별 카테고리 hover 드롭다운으로 접근 ── */
  @media (max-width: 900px) {
    .nav-blog-btn { font-size: var(--text-xs); }
  }

  /* ── 모바일 640px ── */
  @media (max-width: 640px) {
    header { width: 100%; }
    nav {
      padding: var(--space-2) var(--space-3);
      gap: var(--space-1);
      width: 100%;
    }
    .nav-persona { display: none; }
    .nav-blog-wrap { display: none; }
    .nav-benefits, .nav-community { display: none; }
    .nav-kakao { display: none; }
    #btn-user { display: none !important; }
    .hamburger { display: flex; }
    .site-title { font-size: 0.88rem; gap: 4px; }
    /* 로그인/로그아웃은 햄버거 메뉴에만 표시 */
  }

  /* ── 초소형 480px: 카카오 아이콘 원형 + 사이트명 축약 + ThemeToggle 숨김 ── */
  @media (max-width: 480px) {
    .site-title span:last-child { display: none; }
    .logo-kr { font-size: 1.25rem; }
    .kakao-label { display: none; }
    .nav-kakao {
      width: 34px;
      height: 34px;
      padding: 0 !important;
      border-radius: 50% !important;
      justify-content: center;
    }
    .nav-kakao svg { display: block !important; }
    #user-name { display: none; }
    .nav-blog-btn { font-size: 0.72rem; }
    /* ThemeToggle → FAB으로 이동, 헤더에서 숨김 */
    :global(#theme-toggle) { display: none !important; }
  }
</style>
