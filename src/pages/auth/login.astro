---
const KAKAO_REST_KEY = 'fac8da4c0dd8911f025dce7bf2f76f0d';
const REDIRECT_URI = 'https://persona.aikorea24.kr/api/auth/callback/kakao';
const kakaoAuthUrl = `https://kauth.kakao.com/oauth/authorize?client_id=${KAKAO_REST_KEY}&redirect_uri=${encodeURIComponent(REDIRECT_URI)}&response_type=code&scope=profile_nickname,profile_image,account_email`;
---
<html lang="ko">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>로그인 | 페르소나</title>
  <link rel="stylesheet" crossorigin="anonymous"
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Pretendard',-apple-system,sans-serif;background:#FFF8EE;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1rem}
    .card{background:#fff;border-radius:24px;padding:2.25rem 2rem;max-width:420px;width:100%;box-shadow:0 8px 32px rgba(107,66,38,.12);text-align:center}
    .logo{font-size:2.5rem;margin-bottom:.5rem}
    h1{font-size:1.2rem;font-weight:800;color:#3D3D3D;margin-bottom:.4rem}
    .sub{font-size:.88rem;color:#8B7355;margin-bottom:1.5rem;line-height:1.6}
    .consents{background:#FFF8EE;border-radius:14px;padding:1rem;margin-bottom:1.25rem;text-align:left}
    .consent-row{display:flex;align-items:flex-start;gap:.5rem;padding:.4rem 0;font-size:.85rem;color:#3D3D3D;line-height:1.5}
    .consent-row input{margin-top:.2rem;flex-shrink:0}
    .consent-row.all{border-bottom:1px solid #E8D5B7;padding-bottom:.7rem;margin-bottom:.4rem;font-weight:700}
    .consent-row a{color:#6B4226;text-decoration:underline;margin-left:.3rem}
    .kakao-btn{display:flex;align-items:center;justify-content:center;gap:.6rem;width:100%;background:#FEE500;color:#3D3D3D;border-radius:14px;padding:1rem;font-size:1rem;font-weight:700;text-decoration:none;transition:opacity .2s;margin-bottom:.75rem;border:none;cursor:pointer}
    .kakao-btn:disabled{opacity:.4;cursor:not-allowed}
    .skip{font-size:.82rem;color:#8B7355;margin-top:.5rem}
    .skip a{color:#6B4226;font-weight:600}
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">🇰🇷</div>
    <h1>페르소나 커뮤니티 로그인</h1>
    <p class="sub">700만 한국인 데이터로 분석한<br/>내 페르소나를 함께 이야기해요</p>

    <div class="consents">
      <label class="consent-row all">
        <input type="checkbox" id="agree-all"/>
        <span>전체 동의</span>
      </label>
      <label class="consent-row">
        <input type="checkbox" class="req" id="agree-age"/>
        <span>[필수] 만 14세 이상입니다</span>
      </label>
      <label class="consent-row">
        <input type="checkbox" class="req" id="agree-terms"/>
        <span>[필수] <a href="/terms" target="_blank">서비스 이용약관</a> 동의</span>
      </label>
      <label class="consent-row">
        <input type="checkbox" class="req" id="agree-privacy"/>
        <span>[필수] <a href="/privacy" target="_blank">개인정보 수집·이용</a> 동의</span>
      </label>
      <label class="consent-row">
        <input type="checkbox" id="agree-marketing"/>
        <span>[선택] 새 지원금·혜택 정보 수신 동의</span>
      </label>
    </div>

    <button class="kakao-btn" id="login-btn" disabled>
      <svg width="22" height="22" viewBox="0 0 40 40" fill="none">
        <path d="M20 4C11.163 4 4 9.82 4 17c0 4.747 3.027 8.91 7.627 11.367L9.8 35.08a.5.5 0 0 0 .717.543L17.64 31.2c.778.1 1.573.153 2.36.153 8.837 0 16-5.82 16-13S28.837 4 20 4z" fill="#3D3D3D"/>
      </svg>
      카카오로 로그인
    </button>
    <div class="skip">로그인 없이 <a href="/community">게시글만 보기 →</a></div>
  </div>

  <script define:vars={{kakaoAuthUrl}}>
    const all = document.getElementById('agree-all');
    const reqs = document.querySelectorAll('.req');
    const mkt = document.getElementById('agree-marketing');
    const btn = document.getElementById('login-btn');

    function refresh() {
      const ok = [...reqs].every(c => c.checked);
      btn.disabled = !ok;
      all.checked = ok && mkt.checked;
    }
    all.addEventListener('change', () => {
      [...reqs, mkt].forEach(c => c.checked = all.checked);
      refresh();
    });
    [...reqs, mkt].forEach(c => c.addEventListener('change', refresh));
    btn.addEventListener('click', () => {
      if (btn.disabled) return;
      document.cookie = `pending_marketing=${mkt.checked ? '1' : '0'}; Path=/; Max-Age=600; Secure; SameSite=Lax`;
      location.href = kakaoAuthUrl;
    });
  </script>
</body>
</html>
