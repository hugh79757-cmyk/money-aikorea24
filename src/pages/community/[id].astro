---
export function getStaticPaths() {
  // 빌드 시 셸만 생성, 실제 데이터는 클라이언트 JS로 로드
  return [{ params: { id: '_' } }];
}
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<html lang="ko">
<head>
  <BaseHead
    title="게시글 | 페르소나 커뮤니티"
    description="페르소나 커뮤니티 게시글"
  />
  <meta name="robots" content="noindex,follow" />
  <style>
    /* ── 레이아웃 ── */
    .post-toolbar {
      max-width: 800px;
      margin: 1.5rem auto 0;
      padding: 0 1rem;
    }
    .back {
      color: var(--color-benefit);
      text-decoration: none;
      font-weight: 700;
      font-size: .92rem;
    }
    .back:hover { text-decoration: underline; }

    .container {
      max-width: 680px;
      margin: 0 auto;
      padding: 1.5rem 1rem;
    }

    /* ── 게시글 카드 ── */
    .post-card {
      background: var(--color-surface);
      border-radius: 16px;
      padding: 1.5rem;
      border: 1px solid var(--color-border);
      box-shadow: 0 2px 12px rgba(107,66,38,.08);
      margin-bottom: 1.25rem;
    }
    .post-badge {
      display: inline-block;
      background: var(--color-bg);
      color: var(--color-benefit);
      border: 1px solid var(--color-border);
      border-radius: 20px;
      padding: .2rem .7rem;
      font-size: .75rem;
      font-weight: 700;
      margin-bottom: .75rem;
    }
    .post-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text);
      margin-bottom: .75rem;
      line-height: 1.4;
    }
    .post-meta {
      font-size: .78rem;
      color: var(--color-muted);
      display: flex;
      gap: .75rem;
      margin-bottom: 1.25rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--color-border);
    }
    .post-content {
      font-size: .95rem;
      line-height: 1.8;
      color: var(--color-text);
      white-space: pre-wrap;
      margin-bottom: 1rem;
      word-break: break-word;
      overflow-wrap: anywhere;
    }
    .post-actions {
      display: flex;
      gap: .5rem;
      justify-content: flex-end;
    }
    .like-btn {
      background: var(--color-bg);
      border: 1.5px solid var(--color-border);
      border-radius: 8px;
      padding: .4rem .9rem;
      font-size: .85rem;
      color: var(--color-benefit);
      cursor: pointer;
      font-weight: 700;
      font-family: inherit;
    }
    .like-btn.liked {
      background: var(--color-benefit);
      color: #fff;
      border-color: var(--color-benefit);
    }

    /* ── 댓글 섹션 (정적 컨테이너) ── */
    .comments-section {
      background: var(--color-surface);
      border-radius: 16px;
      padding: 1.25rem;
      border: 1px solid var(--color-border);
      min-width: 0;
      overflow: hidden;
    }
    .comments-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--color-benefit);
      margin-bottom: 1rem;
    }

    /* ── 댓글 폼 (정적 요소) ── */
    .comment-form {
      margin-top: 1rem;
      display: flex;
      flex-direction: column;
      gap: .5rem;
    }
    .comment-form textarea {
      border: 1.5px solid var(--color-border);
      border-radius: 10px;
      padding: .75rem;
      font-size: .9rem;
      font-family: inherit;
      resize: none;
      height: 80px;
      outline: none;
      background: var(--color-surface);
      color: var(--color-text);
    }
    .comment-form textarea:focus { border-color: var(--color-benefit); }
    .comment-form textarea::placeholder { color: var(--color-placeholder); }
    .comment-submit {
      background: var(--color-benefit);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: .6rem 1.25rem;
      font-size: .88rem;
      font-weight: 700;
      cursor: pointer;
      align-self: flex-end;
      font-family: inherit;
    }

    /* ── 로딩/에러 ── */
    .loading { text-align: center; padding: 3rem; color: var(--color-muted); }

    /* ── 동적 생성 요소 (loadComments innerHTML) ── */
    :global(.comment-item) {
      padding: .75rem 0;
      border-bottom: 1px solid var(--color-border);
      min-width: 0;
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    :global(.comment-item:last-child) { border-bottom: none; }
    :global(.comment-author) {
      font-size: .78rem;
      font-weight: 700;
      color: var(--color-benefit);
      margin-bottom: .3rem;
    }
    :global(.comment-content) {
      font-size: .88rem;
      color: var(--color-text);
      line-height: 1.6;
      word-break: break-word;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
    }
    :global(.comment-date) {
      font-size: .72rem;
      color: var(--color-muted);
      margin-top: .2rem;
    }

    /* .empty: 댓글 없음 / 에러 상태 (innerHTML로 생성) */
    :global(.empty) {
      color: var(--color-muted);
      font-size: .88rem;
      text-align: center;
      padding: 1.5rem 0;
    }

    /* 로그인 유도 (comment-form innerHTML 교체 시) */
    :global(.login-prompt) {
      font-size: .85rem;
      color: var(--color-muted);
      text-align: center;
      padding: .75rem;
    }
    :global(.login-prompt a) {
      color: var(--color-benefit);
      font-weight: 700;
    }

    .err-msg { color: var(--color-error); font-size: .82rem; margin-top: .4rem; text-align: right; }
  </style>
</head>
<body>
  <Header />

  <div class="post-toolbar">
    <a class="back" href="/community" id="back-link">← 게시판</a>
  </div>

  <div class="container">
    <div id="loading" class="loading">불러오는 중...</div>

    <div id="post-area" style="display:none">
      <div class="post-card">
        <div class="post-badge" id="post-board">👤 페르소나</div>
        <div class="post-title" id="post-title"></div>
        <div class="post-meta">
          <span id="post-author"></span>
          <span id="post-date"></span>
          <span id="post-views"></span>
        </div>
        <div class="post-content" id="post-content"></div>
        <div class="post-actions">
          <button class="like-btn" id="like-btn" onclick="toggleLike()">❤️ <span id="like-count">0</span></button>
          <button
            id="delete-post-btn"
            onclick="deletePost()"
            style="display:none;background:none;border:1px solid var(--color-error);color:var(--color-error);border-radius:8px;padding:.4rem .8rem;cursor:pointer;font-size:.85rem;margin-left:.5rem;font-family:inherit"
          >🗑 삭제</button>
        </div>
      </div>

      <!-- 광고 슬롯 -->
      <ins class="adsbygoogle" style="display:block; width:100%; text-align:center" data-ad-client="ca-pub-5938862195544185" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins>

      <!-- 댓글 -->
      <div class="comments-section">
        <div class="comments-title">💬 댓글 <span id="comment-count">0</span>개</div>
        <div id="comment-list"><div class="empty">첫 댓글을 남겨보세요</div></div>
        <div id="comment-form-area">
          <div class="comment-form" id="comment-form">
            <textarea id="comment-input" placeholder="댓글을 입력하세요" maxlength="500"></textarea>
            <button class="comment-submit" onclick="submitComment()">댓글 달기</button>
          </div>
        </div>
      </div>
    </div>

    <div id="error-area" style="display:none" class="empty">글을 찾을 수 없어요</div>
  </div>

  <!-- is:inline → Astro 번들링 스킵, 모든 함수 전역 스코프 -->
  <script is:inline>
  function escapeHtml(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  /* ── 현재 포스트 ID ── */
  var _pathParts = location.pathname.split('/').filter(function(p){ return p.length > 0; });
  var _postId    = _pathParts[_pathParts.length - 1];

  /* 숫자 ID가 아니면 목록으로 이동 */
  if (_postId !== '_' && !/^\d+$/.test(_postId)) {
    location.replace('/community');
  }

  /* ── 세션 파싱 ── */
  var _session = document.cookie.split(';').find(function(c){ return c.trim().startsWith('session_ui='); });
  var _me = null;
  if (_session) {
    try {
      var _tok = _session.trim().slice('session_ui='.length);
      _me = JSON.parse(decodeURIComponent(atob(_tok).split('').map(function(c){
        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
      }).join('')));
    } catch(e) {}
  }

  /* ── 뒤로가기 board 파라미터 유지 ── */
  var _urlBoard = (new URLSearchParams(location.search)).get('board') || 'persona';
  document.getElementById('back-link').href = '/community?board=' + _urlBoard;

  /* ── API 인증 오류 처리 ── */
  function handleAuthError(status) {
    if (status === 401) {
      if (confirm('로그인이 필요하거나 세션이 만료됐어요.\n로그인 페이지로 이동할까요?')) {
        location.href = '/auth/login?next=' + encodeURIComponent(location.pathname);
      }
      return true;
    }
    return false;
  }

  /* ── 댓글 목록 로드 ── */
  async function loadComments() {
    try {
      var res      = await fetch('/api/community/comments?post_id=' + _postId);
      var data     = await res.json();
      var list     = document.getElementById('comment-list');
      var comments = data.comments || [];
      document.getElementById('comment-count').textContent = comments.length;
      if (!comments.length) {
        list.innerHTML = '<div class="empty">첫 댓글을 남겨보세요</div>';
        return;
      }
      list.innerHTML = comments.map(function(c) {
        var canDelete = _me && (_me.id === c.user_id || _me.id === 1);
        var deleteBtn = canDelete
          ? ' <button data-del-comment="' + (parseInt(c.id)||0) + '" style="float:right;background:none;border:none;color:#c00;cursor:pointer;font-size:.85rem">🗑 삭제</button>'
          : '';
        return '<div class="comment-item">' +
          '<div class="comment-author">' + escapeHtml(c.author_name || '익명') + deleteBtn + '</div>' +
          '<div class="comment-content">' + escapeHtml(c.content) + '</div>' +
          '<div class="comment-date">' + escapeHtml((c.created_at||'').slice(0,10)) + '</div>' +
          '</div>';
      }).join('');
    } catch(e) {
      console.error('댓글 로드 실패', e);
    }
  }

  /* ── 댓글 삭제: 이벤트 위임 ── */
  document.addEventListener('click', async function(e) {
    var btn = e.target.closest('[data-del-comment]');
    if (!btn) return;
    if (!confirm('삭제하시겠어요?')) return;
    var res = await fetch('/api/community/comments?id=' + btn.getAttribute('data-del-comment'), { method: 'DELETE' });
    if (res.ok) {
      loadComments();
    } else {
      handleAuthError(res.status) || alert('삭제 실패 (오류 ' + res.status + ')');
    }
  });

  /* ── 게시글 로드 ── */
  async function loadPost() {
    try {
      var res  = await fetch('/api/community/posts/' + _postId);
      var data = await res.json();
      if (!data || data.error) { showError(); return; }

      document.title = data.title + ' | 페르소나 커뮤니티';
      document.getElementById('post-board').textContent =
        data.board_type === 'benefit' ? '🎁 지원금·혜택' : '👤 페르소나';
      document.getElementById('post-title').textContent   = data.title;
      document.getElementById('post-author').textContent  = '✍️ ' + (data.author_name || '익명');
      document.getElementById('post-date').textContent    = (data.created_at || '').slice(0, 10);
      document.getElementById('post-views').textContent   = '👁 ' + (data.views || 0);
      document.getElementById('post-content').textContent = data.content;
      document.getElementById('like-count').textContent   = data.likes || 0;

      if (_me && (_me.id === data.user_id || _me.id === 1)) {
        document.getElementById('delete-post-btn').style.display = 'inline-block';
      }

      document.getElementById('loading').style.display   = 'none';
      document.getElementById('post-area').style.display = 'block';

      loadComments();

      if (!_me) {
        document.getElementById('comment-form').innerHTML =
          '<div class="login-prompt"><a href="/auth/login">카카오 로그인</a> 후 댓글을 달 수 있어요</div>';
      }

      (adsbygoogle = window.adsbygoogle || []).push({});
    } catch(e) {
      showError();
    }
  }

  /* ── 게시글 삭제 ── */
  function deletePost() {
    if (!confirm('이 글을 삭제하시겠어요? (댓글·좋아요도 함께 삭제됩니다)')) return;
    fetch('/api/community/posts/' + _postId, { method: 'DELETE' })
      .then(function(r) {
        if (r.ok) { alert('삭제 완료'); location.href = '/community'; }
        else handleAuthError(r.status) || alert('삭제 실패');
      });
  }

  /* ── 좋아요 토글 ── */
  function toggleLike() {
    if (!_me) { location.href = '/auth/login?next=' + encodeURIComponent(location.pathname); return; }
    fetch('/api/community/like', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ post_id: parseInt(_postId) })
    }).then(function(r) {
      if (r.status === 401) { handleAuthError(401); return; }
      return r.json();
    }).then(function(data) {
      if (data && data.ok) {
        document.getElementById('like-count').textContent = data.likes;
        document.getElementById('like-btn').classList.toggle('liked');
      }
    });
  }

  /* ── 댓글 달기 ── */
  function submitComment() {
    var content = document.getElementById('comment-input').value.trim();
    if (!content) return;
    var btn = document.querySelector('.comment-submit');
    if (btn) btn.disabled = true;

    fetch('/api/community/comments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ post_id: parseInt(_postId), content: content })
    }).then(function(r) {
      if (r.status === 401) { handleAuthError(401); return null; }
      return r.json();
    }).then(function(data) {
      if (data && data.ok) {
        document.getElementById('comment-input').value = '';
        loadComments();
      } else if (data && data.error) {
        alert('오류: ' + data.error);
      }
    }).catch(function() {
      alert('댓글 전송 실패. 다시 시도해주세요.');
    }).finally(function() {
      if (btn) btn.disabled = false;
    });
  }

  function showError() {
    document.getElementById('loading').style.display    = 'none';
    document.getElementById('error-area').style.display = 'block';
  }

  loadPost();
  </script>

  <Footer />
</body>
</html>
