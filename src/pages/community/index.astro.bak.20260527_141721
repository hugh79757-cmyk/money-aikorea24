---

import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<html lang="ko">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>페르소나 커뮤니티 | persona.aikorea24.kr</title>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5938862195544185" crossorigin="anonymous"></script>
  <link rel="stylesheet" crossorigin="anonymous"
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"/>
  <style is:global>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Pretendard',-apple-system,sans-serif;background:#FFF8EE;color:#3D3D3D;padding-bottom:60px}
    a{color:inherit;text-decoration:none}
    .logo{color:#fff;font-weight:800;font-size:1.05rem}
    .hbtns{display:flex;gap:.5rem}
    .btn-kakao{background:#FEE500;color:#3D3D3D;border-radius:8px;padding:.45rem 1rem;font-size:.85rem;font-weight:700;text-decoration:none}
    .btn-write{background:#fff;color:#6B4226;border-radius:8px;padding:.45rem 1rem;font-size:.85rem;font-weight:700;text-decoration:none;display:none}
    .container{max-width:760px;margin:0 auto;padding:1.5rem 1rem}
    h1{font-size:1.4rem;font-weight:800;color:#6B4226;margin-bottom:.25rem}
    .sub{color:#8B7355;font-size:.88rem;margin-bottom:1.25rem}
    .search-bar{display:flex;gap:.5rem;margin-bottom:1.25rem}
    .search-bar input{flex:1;border:1.5px solid #E8D5C0;border-radius:10px;padding:.65rem 1rem;font-size:.95rem;background:#fff;outline:none;font-family:inherit}
    .search-bar input:focus{border-color:#6B4226}
    .search-bar button{background:#6B4226;color:#fff;border:none;border-radius:10px;padding:.65rem 1.2rem;font-size:.92rem;font-weight:700;cursor:pointer}
    .post-list{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 2px 12px rgba(107,66,38,.08);margin-bottom:1.25rem;min-height:200px}
    .post-item{display:flex;flex-direction:column;gap:.3rem;padding:1rem 1.25rem;border-bottom:1px solid #F0DFC8;transition:background .15s;cursor:pointer}
    .post-item:last-child{border-bottom:none}
    .post-item:hover{background:#FFF8EE}
    .post-meta{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}
    .pbadge{background:#E8D5C0;color:#6B4226;border-radius:20px;padding:.18rem .65rem;font-size:.73rem;font-weight:700}
    .ptype{font-size:.75rem;color:#8B7355}
    .post-title{font-size:.97rem;font-weight:700;color:#3D3D3D;line-height:1.4}
    .ccnt{color:#6B4226;font-size:.85rem;margin-left:.3rem}
    .post-info{font-size:.76rem;color:#8B7355;display:flex;gap:.6rem}
    .empty{text-align:center;padding:3.5rem 1rem;color:#8B7355}
    .loading{text-align:center;padding:3rem;color:#8B7355}
    .pagination{display:flex;justify-content:center;gap:.4rem;margin-top:1rem;flex-wrap:wrap}
    .pagination button{padding:.5rem .9rem;border-radius:8px;font-size:.85rem;font-weight:600;border:1.5px solid #E8D5C0;color:#6B4226;background:#fff;cursor:pointer}
    .pagination button.active{background:#6B4226;color:#fff;border-color:#6B4226}
    .total{text-align:center;margin-top:.75rem;font-size:.8rem;color:#8B7355}
    .board-tabs{display:flex;gap:.5rem;margin-bottom:1.25rem}
    .board-tab{flex:1;text-align:center;padding:.65rem;border-radius:12px;font-size:.92rem;font-weight:700;border:2px solid #E8D5C0;color:#8B7355;background:#fff;cursor:pointer;transition:all .15s}
    .board-tab.active{background:#6B4226;color:#fff;border-color:#6B4226}
  
    .community-toolbar{max-width:800px;margin:1.5rem auto 0;padding:0 1rem;display:flex;justify-content:flex-end;gap:.5rem}
    .community-toolbar .btn-write{background:#fff;border:1.5px solid #E8D5B7;color:#6B4226;padding:.5rem 1rem;border-radius:10px;font-weight:700;text-decoration:none;font-size:.88rem}
    .community-toolbar .btn-write:hover{background:#FFF7EC}
  </style>
</head>
<body>
  <Header />
  <div class="community-toolbar">
    <a class="btn-write" id="btn-write" href="/community/write">✏️ 글쓰기</a>
  </div>
  <div class="container">
    <h1>💬 페르소나 커뮤니티</h1>
    <p class="sub" id="board-sub">같은 페르소나를 가진 사람들과 이야기를 나눠보세요</p>
    <div class="board-tabs">
      <button class="board-tab active" id="tab-persona" onclick="switchBoard('persona')">💬 페르소나</button>
      <button class="board-tab" id="tab-benefit" onclick="switchBoard('benefit')">💰 지원금</button>
    </div>
    <div class="search-bar">
      <input id="search-input" placeholder="게시글 검색..." />
      <button onclick="doSearch()">검색</button>
    </div>
    <div class="post-list" id="post-list"><div class="loading">불러오는 중...</div></div>
    <div class="pagination" id="pagination"></div>
    <div class="total" id="total"></div>
  </div>

  <!-- is:inline → Astro가 ES Module로 번들링하지 않음 → 모든 함수가 전역 스코프 -->
  <script is:inline>
  function escapeHtml(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  var _qs     = new URLSearchParams(location.search);
  var _slug   = _qs.get('slug') || '';
  var _board  = _qs.get('board') || 'persona';
  var _q      = _qs.get('q') || '';

  if (_board === 'benefit') {
    document.getElementById('tab-persona').classList.remove('active');
    document.getElementById('tab-benefit').classList.add('active');
  }
  document.getElementById('search-input').value = _q;

  // 로그인 상태 체크
  var _session = document.cookie.split(';').find(function(c) { return c.trim().startsWith('session_ui='); });
  if (_session) {
    document.getElementById('btn-login').style.display = 'none';
    var _wBtn = document.getElementById('btn-write');
    _wBtn.style.display = 'inline-block';
    if (_slug) _wBtn.href = '/community/write?slug=' + _slug;
  }

  function switchBoard(b) {
    _board = b;
    document.querySelectorAll('.board-tab').forEach(function(t) { t.classList.remove('active'); });
    document.getElementById('tab-' + b).classList.add('active');
    document.getElementById('board-sub').textContent =
      b === 'persona' ? '같은 페르소나를 가진 사람들과 이야기를 나눠보세요' : '지원금 신청 정보와 후기를 나눠보세요';
    loadPosts(1);
  }

  function doSearch() {
    _q = document.getElementById('search-input').value.trim();
    loadPosts(1);
  }

  async function loadPosts(page) {
    page = page || 1;
    var list = document.getElementById('post-list');
    list.innerHTML = '<div class="loading">불러오는 중...</div>';

    var url = '/api/community/posts?page=' + page + '&board=' + encodeURIComponent(_board);
    if (_slug) url += '&slug=' + encodeURIComponent(_slug);
    if (_q)    url += '&q='    + encodeURIComponent(_q);

    try {
      var res   = await fetch(url);
      var data  = await res.json();
      var posts = data.posts || [];
      var total = data.total || 0;

      document.getElementById('total').textContent = '총 ' + total + '개의 게시글';

      if (posts.length === 0) {
        list.innerHTML = '<div class="empty"><p>아직 글이 없어요</p>' +
          (_session ? '<a href="/community/write" style="color:#6B4226;font-weight:700;margin-top:.5rem;display:inline-block">첫 글 써보기 →</a>' : '') +
          '</div>';
      } else {
        list.innerHTML = posts.map(function(p) {
          var cmtBadge = p.comment_count > 0 ? '<span class="ccnt">[' + parseInt(p.comment_count) + ']</span>' : '';
          return '<a class="post-item" href="/community/' + (parseInt(p.id)||0) + '">' +
            '<div class="post-meta">' +
              '<span class="pbadge">' + escapeHtml(p.region) + ' ' + escapeHtml(p.age) + ' ' + escapeHtml(p.sex) + '</span>' +
              '<span class="ptype">' + escapeHtml(p.persona_type) + '</span>' +
            '</div>' +
            '<div class="post-title">' + escapeHtml(p.title) + cmtBadge + '</div>' +
            '<div class="post-info">' +
              '<span>' + escapeHtml(p.author_name) + '</span>' +
              '<span>조회 ' + (parseInt(p.views)||0) + '</span>' +
              '<span>👍 ' + (parseInt(p.likes)||0) + '</span>' +
              '<span>' + escapeHtml((p.created_at||'').slice(0,10)) + '</span>' +
            '</div>' +
          '</a>';
        }).join('');
      }

      /* ── 페이지네이션: data-page 속성 + 이벤트 위임 ── */
      var totalPages = Math.ceil(total / 20);
      var pag = document.getElementById('pagination');
      if (totalPages <= 1) { pag.innerHTML = ''; return; }
      var html = '';
      if (page > 1) html += '<button data-page="' + (page-1) + '">← 이전</button>';
      for (var i = Math.max(1, page-2); i <= Math.min(totalPages, page+2); i++) {
        html += '<button class="' + (i === page ? 'active' : '') + '" data-page="' + i + '">' + i + '</button>';
      }
      if (page < totalPages) html += '<button data-page="' + (page+1) + '">다음 →</button>';
      pag.innerHTML = html;

    } catch(err) {
      list.innerHTML = '<div class="empty">불러오기 실패. 새로고침 해주세요.</div>';
    }
  }

  /* 페이지네이션 이벤트 위임 — 버튼이 동적으로 바뀌어도 항상 동작 */
  document.getElementById('pagination').addEventListener('click', function(e) {
    var btn = e.target.closest('button[data-page]');
    if (btn) loadPosts(parseInt(btn.getAttribute('data-page'), 10));
  });

  document.getElementById('search-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') doSearch();
  });

  loadPosts(1);
  </script>
  <Footer />
</body>
</html>
