---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchBar from './SearchBar.astro';
import { SITE_TITLE } from '../consts';
---
<header>
  <nav>
    <a href="/" class="site-title">
      <span class="logo-kr">🇰🇷</span>
      <span>{SITE_TITLE}</span>
    </a>
    <div class="nav-links">
      <a href="/my-persona" class="nav-persona">🔍 내 페르소나</a>
      <div class="nav-blog-wrap" id="nav-blog-wrap">
        <button class="nav-blog-btn" id="nav-blog-btn" type="button" aria-expanded="false" aria-haspopup="true">
          📝 블로그 <span class="blog-arrow">▾</span>
        </button>
        <div class="blog-submenu" id="blog-submenu" role="menu">
          <a href="/blog" class="blog-sub-all">📋 전체 글 보기</a>
          <a href="/blog/category/insurance">🛡️ 보험</a>
          <a href="/blog/category/invest">📈 투자·절세</a>
          <a href="/blog/category/loan">🏠 대출·부동산</a>
          <a href="/blog/category/tax">💰 세금·절약</a>
        </div>
      </div>
      <a href="/benefits" class="nav-benefits">⏰ 지원금</a>
      <a href="/community" class="nav-community">💬 커뮤니티</a>
      <SearchBar />
      <a href="/auth/login" class="nav-kakao" id="btn-login">
        <svg width="16" height="16" viewBox="0 0 40 40" fill="none" style="flex-shrink:0">
          <path d="M20 4C11.163 4 4 9.82 4 17c0 4.747 3.027 8.91 7.627 11.367L9.8 35.08a.5.5 0 0 0 .717.543L17.64 31.2c.778.1 1.573.153 2.36.153 8.837 0 16-5.82 16-13S28.837 4 20 4z" fill="#3D3D3D"/>
        </svg>
        <span class="kakao-label">카카오 로그인</span>
      </a>
      <span class="nav-user" id="btn-user">
        <span id="user-name"></span>
        <a href="/api/auth/logout" class="nav-logout">로그아웃</a>
      </span>
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
(function() {
  // session_ui: non-HttpOnly 쿠키 (UI 표시 전용, 이름/ID만 포함)
  const raw = document.cookie.split(';').find(c => c.trim().startsWith('session_ui='));
  const btnLogin = document.getElementById('btn-login');
  const btnUser  = document.getElementById('btn-user');
  const userName = document.getElementById('user-name');
  if (raw) {
    try {
      const encoded = raw.trim().replace('session_ui=', '');
      const user = JSON.parse(decodeURIComponent(atob(encoded).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join('')));
      if (btnLogin) btnLogin.style.display = 'none';
      if (btnUser)  btnUser.style.display  = 'flex';
      if (userName && user.name) userName.textContent = `👤 ${user.name}`;
    } catch {}
  } else {
    if (btnUser) btnUser.style.display = 'none';
  }

  // 블로그 드롭다운 토글 (모바일 클릭)
  const blogWrap = document.getElementById('nav-blog-wrap');
  const blogBtn  = document.getElementById('nav-blog-btn');
  if (blogWrap && blogBtn) {
    blogBtn.addEventListener('click', (e) => {
      // 데스크탑(hover 작동)에서는 클릭 무시
      if (window.innerWidth > 640) return;
      e.stopPropagation();
      const isOpen = blogWrap.classList.toggle('open');
      blogBtn.setAttribute('aria-expanded', String(isOpen));
    });
    // 외부 클릭 시 닫기
    document.addEventListener('click', (e) => {
      if (!blogWrap.contains(e.target as Node)) {
        blogWrap.classList.remove('open');
        blogBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }
})();
</script>

<style>
  header {
    margin: 0;
    padding: 0;
    background: var(--color-header-bg);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    box-shadow: var(--shadow-md);
    width: 100%;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
    gap: var(--space-2);
    width: 100%;
    box-sizing: border-box;
  }
  .site-title {
    font-size: var(--text-base);
    font-weight: var(--font-extrabold);
    color: var(--color-surface);
    text-decoration: none;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-shrink: 0;
  }
  .logo-kr { font-size: 1.1rem; }
  .nav-links {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: nowrap;
  }
  .nav-persona {
    background: var(--color-accent);
    color: var(--color-surface) !important;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    text-decoration: none !important;
    white-space: nowrap;
    box-shadow: var(--shadow-accent);
    transition: background var(--transition-fast);
  }
  .nav-persona:hover { background: var(--color-accent-dark); }
  .nav-benefits, .nav-community {
    background: rgba(255,255,255,0.1);
    color: var(--color-surface) !important;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    text-decoration: none !important;
    white-space: nowrap;
    border: 1px solid rgba(255,255,255,0.18);
    transition: background var(--transition-fast);
  }
  .nav-benefits:hover, .nav-community:hover { background: rgba(255,255,255,0.2); }
  .nav-kakao {
    background: var(--color-kakao);
    color: var(--color-kakao-text) !important;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    text-decoration: none !important;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    transition: background var(--transition-fast);
    flex-shrink: 0;
  }
  .nav-kakao:hover { background: #F5D800; }
  .nav-user {
    display: none;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
    flex-shrink: 0;
  }
  #user-name {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.9);
    font-weight: var(--font-semibold);
  }
  .nav-logout {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.5) !important;
    text-decoration: underline !important;
    cursor: pointer;
  }
  /* ── 블로그 드롭다운 ── */
  .nav-blog-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .nav-blog-btn {
    background: rgba(255,255,255,0.1);
    color: var(--color-surface) !important;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid rgba(255,255,255,0.18);
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--transition-fast);
    font-family: inherit;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-blog-btn:hover,
  .nav-blog-wrap:hover .nav-blog-btn { background: rgba(255,255,255,0.2); }
  .blog-arrow { font-size: 0.65rem; opacity: 0.75; }
  .blog-submenu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-surface);
    border-radius: 12px;
    box-shadow: 0 8px 28px rgba(0,0,0,0.15);
    border: 1px solid var(--color-border);
    padding: 6px;
    min-width: 168px;
    z-index: 1000;
    flex-direction: column;
    gap: 2px;
  }
  /* 데스크탑: hover로 열기 */
  .nav-blog-wrap:hover .blog-submenu { display: flex; }
  /* JS로 open 클래스 추가 시에도 열기 (모바일) */
  .nav-blog-wrap.open .blog-submenu { display: flex; }
  .blog-submenu a {
    display: block;
    padding: 8px 12px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-text) !important;
    text-decoration: none !important;
    border-radius: 8px;
    white-space: nowrap;
    transition: background var(--transition-fast);
  }
  .blog-submenu a:hover { background: var(--color-bg); color: var(--color-benefit) !important; }
  .blog-sub-all {
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 4px;
    color: var(--color-benefit) !important;
    font-weight: 700 !important;
  }

  /* ── 태블릿 (900px 이하): 블로그 버튼 유지, 개별 카테고리 hover 드롭다운으로 접근 ── */
  @media (max-width: 900px) {
    .nav-blog-btn { font-size: var(--text-xs); }
  }

  /* ── 모바일 640px ── */
  @media (max-width: 640px) {
    header { width: 100%; }
    nav {
      padding: var(--space-2) var(--space-3);
      gap: var(--space-1);
      width: 100%;
    }
    .nav-benefits, .nav-community { display: none; }
    .site-title { font-size: 0.88rem; gap: 4px; }
    .nav-persona {
      font-size: var(--text-xs);
      padding: var(--space-1) var(--space-2);
    }
    .nav-blog-btn {
      font-size: var(--text-xs);
      padding: var(--space-1) var(--space-2);
    }
    .nav-kakao {
      font-size: var(--text-xs);
      padding: var(--space-2) var(--space-3);
    }
    .nav-kakao svg { display: none; }
    /* 모바일에서 드롭다운은 hover 없이 클릭으로만 */
    .nav-blog-wrap:hover .blog-submenu { display: none; }
    .nav-blog-wrap.open .blog-submenu { display: flex; }
    /* 모바일 드롭다운 위치: 뷰포트 넘치지 않도록 */
    .blog-submenu {
      left: auto;
      right: 0;
      transform: none;
    }
  }

  /* ── 초소형 480px: 카카오 아이콘 원형 + 사이트명 축약 ── */
  @media (max-width: 480px) {
    .site-title span:last-child { display: none; }
    .logo-kr { font-size: 1.25rem; }
    .kakao-label { display: none; }
    .nav-kakao {
      width: 34px;
      height: 34px;
      padding: 0 !important;
      border-radius: 50% !important;
      justify-content: center;
    }
    .nav-kakao svg { display: block !important; }
    #user-name { display: none; }
    .nav-blog-btn { font-size: 0.72rem; }
  }
</style>
