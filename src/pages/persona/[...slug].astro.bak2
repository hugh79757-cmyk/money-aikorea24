---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/tailwind.css';
import BenefitCards from '../../components/BenefitCards.astro';
import { getBenefitMatches } from "../../lib/benefitMatcher";
import WelfareCards from "../../components/WelfareCards.astro";
import PersonaBlogRecommend from '../../components/PersonaBlogRecommend.astro';
import { matchWelfare } from "../../lib/welfareMatcher";
import welfareLocal from "../../../public/welfare-local.json";
import welfareCentral from "../../../public/welfare-central.json";
const welfarePool = [...welfareLocal.map((x:any)=>({...x,_source:"local"})), ...welfareCentral.map((x:any)=>({...x,_source:"central"}))];
import wageTable from '../../data/wage-table.json';
import jobMap from '../../data/job-category-map.json';
import decisionCardsData from '../../data/decision-cards.json';
import DecisionCards from '../../components/DecisionCards.astro';
export async function getStaticPaths() {
  const fs   = await import('fs');
  const path = await import('path');
  const raw  = fs.readFileSync(path.join(process.cwd(), 'public', 'persona-stats.json'), 'utf-8');
  const data = JSON.parse(raw);
  const blogMatchData = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'blog-match.json'), 'utf-8'));
  const curatedData = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'benefits-curated.json'), 'utf-8'));
  const cleanData   = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'benefits-clean.json'), 'utf-8'));
  // 큐레이션 우선, 나머지는 clean에서 보충 (중복 id 제거)
  const curatedIds  = new Set(curatedData.map((d: any) => d.id));
  const benefitsData = [...curatedData, ...cleanData.filter((d: any) => !curatedIds.has(d.id))];
  return Object.entries(data).map(([key, stats]) => ({
    params: { slug: key.replace(/_/g, '-') },
    props:  { key, stats, blogMatch: blogMatchData, benefits: benefitsData, decisionCardData: (decisionCardsData as any)[key] || null }
  }));
}

const { key, stats: s, blogMatch, benefits, decisionCardData } = Astro.props;
const [region, sex, ageRaw] = key.split('_');

const regionMap: Record<string,string> = {
  '경상남':'경남','경상북':'경북','전라남':'전남','전라북':'전북',
  '충청남':'충남','충청북':'충북'
};
const dr = regionMap[region] || region;

const ageNum   = parseInt(ageRaw) || 0;
const isDecade = ageRaw.includes('대') || ageRaw.includes('이상');
const ageGroup = isDecade ? ageRaw :
  ageNum < 30 ? '20대' : ageNum < 40 ? '30대' : ageNum < 50 ? '40대' :
  ageNum < 60 ? '50대' : ageNum < 70 ? '60대' : '70대 이상';

function pctOf(obj: Record<string,number>, keys: string[]): number {
  if (!obj) return 0;
  const t = Object.values(obj).reduce((a,v) => a+v, 0);
  if (!t) return 0;
  return Math.round(keys.reduce((a,k) => a+(obj[k]||0), 0) / t * 100);
}

function topN(obj: Record<string,number>, n = 5) {
  return Object.entries(obj || {}).sort((a,b) => b[1]-a[1]).slice(0, n);
}


const aptPct  = pctOf(s.housing,   ['아파트']);
const eduPct  = pctOf(s.education, ['4년제 대학교','대학원']);
const marPct  = pctOf(s.marital,   ['배우자있음']);
const unePct  = pctOf(s.jobs,      ['무직']);
const sngPct  = pctOf(s.family,    ['혼자 거주','혼자 거주 (배우자 별거)']);
const isMar   = marPct >= 50;
const isUne   = unePct >= 20;
const incomeData = (s as any).income ?? null;
const incomeVal  = incomeData ? incomeData.income_employed : null;  // 취업자 기준 월소득(만원)
const incomeEst  = incomeData ? incomeData.income_estimate : null;  // 전체(무직포함) 평균
const topPct     = incomeData ? incomeData.top_percentile : null;   // 상위 백분위

// "당신은..." 카피 생성
function youAreSentence(n: number, hi: string, lo: string): string {
  const pct = n >= 50 ? n : 100 - n;
  const txt = n >= 50 ? hi : lo;
  if (pct >= 85) return `10명 중 9명은 ${txt} (${pct}%)`;
  if (pct >= 60) return `${pct}% 확률로 ${txt}`;
  if (pct >= 40) return `${pct}%가 ${txt}`;
  if (pct >= 20) return `10명 중 ${Math.round(pct/10)}명만 ${txt}`;
  return `${pct}% 정도가 ${txt}`;
}
const youAreItems = [
  { emoji:'🏠', text: youAreSentence(aptPct, '아파트에 살고 있어요', '아파트 외 주거형태에 살고 있어요') },
  { emoji:'🎓', text: youAreSentence(eduPct, '대학을 졸업했어요', '고졸 이하 학력이에요') },
  { emoji:'💍', text: youAreSentence(marPct, '결혼한 상태예요', '미혼이에요') },
  { emoji:'💼', text: youAreSentence(100-unePct, '현재 일하고 있어요', '지금 일을 쉬고 있어요') },
];

// 고용노동부 고용형태별근로실태조사 2025 기반 임금 추정
function mapJobToCategory(jobName) {
  for (const rule of jobMap.rules) {
    for (const kw of rule.keywords) {
      if (jobName.includes(kw)) return rule.category;
    }
  }
  return jobMap.fallback;
}
function ageToFactorKey(ageRaw, ageNum) {
  let n = ageNum;
  if (!n || isNaN(n)) {
    const m = String(ageRaw).match(/(\d+)/);
    if (m) n = parseInt(m[1]);
  }
  if (!n) return '30대초';
  if (n < 20) return '10대';
  if (n < 25) return '20대초';
  if (n < 30) return '20대후';
  if (n < 35) return '30대초';
  if (n < 40) return '30대후';
  if (n < 45) return '40대초';
  if (n < 50) return '40대후';
  if (n < 55) return '50대초';
  if (n < 60) return '50대후';
  return '60대이상';
}
function getRegionFactor(regionKey: string): number {
  const rf = (wageTable as any).regionFactor ?? {};
  // 지역명 접두어로 매칭 (경상남 → 경남 등 단축형 처리)
  if (rf[regionKey] !== undefined) return rf[regionKey];
  for (const [k, v] of Object.entries(rf)) {
    if (regionKey.startsWith(k) || k.startsWith(regionKey)) return v as number;
  }
  return 1.0;
}
function getJobWage(jobName, sex, ageRaw, ageNum, regionKey = '') {
  const cat = mapJobToCategory(jobName);
  const base = (wageTable.jobCategory as Record<string, number>)[cat];
  if (base === undefined || base === 0) return null;
  const sexKey = sex === '여자' ? '여' : '남';
  const ageKey = ageToFactorKey(ageRaw, ageNum);
  const ageFactor = (wageTable.ageSexFactor[sexKey] || {})[ageKey] ?? 1.0;
  const regionFactor = getRegionFactor(regionKey);
  return Math.round(base * ageFactor * regionFactor);
}
const parPct  = pctOf(s.family,    ['부모와 동거','어머니와 동거','아버지와 동거']);

/* 페르소나 유형 판정 */
type PType = { name: string; emoji: string; desc: string };
function detectType(): PType {
  const famPct = pctOf(s.family, ['배우자·자녀와 거주','배우자와 거주','배우자·자녀·어머니와 거주']);
  const bigCity = ['서울','경기','인천','부산','대구'].includes(region);
  const nonMetro = !bigCity;
  const housePct = pctOf(s.housing, ['단독주택','주택 이외의 거처']);
  const is20s = ageNum < 30 || ageRaw === '20대';
  const is30s = (ageNum >= 30 && ageNum < 40) || ageRaw === '30대';
  const is40s = (ageNum >= 40 && ageNum < 50) || ageRaw === '40대';
  const is50s = (ageNum >= 50 && ageNum < 60) || ageRaw === '50대';
  const is60up = ageNum >= 60 || ageRaw === '70대이상' || ageRaw === '60대';

  // 60대 이상
  if (is60up) {
    if (isMar) return { name:'배우자와 노후를 보내는 사람', emoji:'🥇', desc:'연금·건강·손자녀를 동시에 챙기는 시기' };
    return { name:'혼자서 노후를 설계하는 사람', emoji:'🥇', desc:'내 속도로 인생 후반전을 사는 사람' };
  }

  // 50대
  if (is50s) {
    if (isMar && !isUne) {
      if (sex === '여자') return { name:'자식 다 키우고 이제야 내 시간 생긴 사람', emoji:'🌿', desc:'정년까지 몇 년, 연금까지 몇 년 계산하는 시기' };
      return { name:'정년까지 버티며 노후 준비하는 사람', emoji:'🌿', desc:'퇴직금·연금·건강보험 세 가지 동시에 챙기는 사람' };
    }
    if (isMar && isUne) return { name:'자식 결혼시키고 홀가분해진 사람', emoji:'🌿', desc:'이제 내 노후를 위한 시간' };
    return { name:'혼자서 단단하게 사는 사람', emoji:'🎯', desc:'남의 시선 신경 안 쓰고 내 삶 사는 사람' };
  }

  // 40대
  if (is40s) {
    if (famPct > 35 && isMar && !isUne) {
      if (sex === '여자') return { name:'점심시간에 어린이집에서 전화 오는 사람', emoji:'💪', desc:'아이·직장·대출 세 가지를 동시에 돌리는 사람' };
      return { name:'대출 갚으며 아이 학원비 내는 사람', emoji:'💪', desc:'가족을 위해 오늘도 출근하는 사람' };
    }
    if (famPct > 35 && isMar && isUne) return { name:'아이 학교 보내고 재취업 고민하는 사람', emoji:'🏠', desc:'경력 공백을 어떻게 채울지 고민 중인 사람' };
    if (bigCity && aptPct > 45) return { name:'내 집 마련하고 대출 상환 중인 사람', emoji:'🏙️', desc:'가계부 앱 두 개 쓰는 사람' };
    return { name:'연말정산 꼼꼼히 챙기는 40대', emoji:'💼', desc:'IRP·연금저축 가입하고 노후 계산하는 사람' };
  }

  // 30대
  if (is30s) {
    if (famPct > 35 && isMar && !isUne) {
      if (sex === '여자') return { name:'퇴근하면 두 번째 직장 시작되는 사람', emoji:'💪', desc:'아이·남편·직장 세 가지를 동시에 돌리는 사람' };
      return { name:'월급날만 기다리며 버티는 가장', emoji:'💪', desc:'가족을 위해 오늘도 출근하는 사람' };
    }
    if (famPct > 35 && isMar && isUne) return { name:'애 재우고 나만의 시간 30분인 사람', emoji:'🏠', desc:'육아와 나 사이 어딘가에 있는 사람' };
    if (bigCity && aptPct > 45 && !isMar) return { name:'퇴근 후 청약통장 들여다보는 사람', emoji:'🏙️', desc:'내 집 마련 계산기 켜두고 자는 사람' };
    if (bigCity && aptPct > 45 && isMar) return { name:'대출 상환하며 노후도 준비하는 사람', emoji:'🏙️', desc:'가계부 앱 세 개 쓰는 사람' };
    if (sngPct > 25 && !isMar) return { name:'퇴근하면 아무도 기다리지 않아서 좋은 사람', emoji:'🎯', desc:'혼자 사는 게 불편하지 않은 사람' };
    if (isUne) return { name:'오늘도 잡코리아 켜는 사람', emoji:'🚀', desc:'이직·취업 준비로 지쳐가는 사람' };
    return { name:'내 집 마련 계산 중인 30대', emoji:'🏙️', desc:'청약통장 들여다보며 아파트 시세 검색하는 사람' };
  }

  // 20대
  if (is20s) {
    if (isUne) return { name:'스펙 쌓으며 미래 고민 중인 청년', emoji:'🌐', desc:'취업·이직·방향 중 하나를 고르는 시기' };
    if (sngPct > 30) return { name:'월급 전부 내 맘대로 쓰는 사람', emoji:'🎯', desc:'결혼은 옵션, 자유는 필수인 사람' };
    if (parPct > 30) return { name:'부모님과 살며 돈 모으는 사람', emoji:'🌐', desc:'독립 자금 모으는 중인 사람' };
    return { name:'아직 뭘 할지 모르는 청년', emoji:'🌐', desc:'가능성을 탐색 중인 20대' };
  }

  // 비수도권 + 단독주택
  if (nonMetro && housePct > 25) {
    return { name:'서울 안 부럽고 동네가 좋은 사람', emoji:'🌱', desc:'고향 단골 가게가 있는 사람' };
  }

  return { name:'대한민국 딱 평균인 사람', emoji:'🇰🇷', desc:'특별히 많지도 적지도 않은 보통 사람' };
}
const pType = detectType();

/* 혜택 매칭 */
const matchedBenefits = getBenefitMatches(
  { age: ageNum || (ageRaw === '20대' ? 25 : ageRaw === '30대' ? 35 : ageRaw === '40대' ? 45 : ageRaw === '50대' ? 55 : ageRaw === '60대' ? 65 : 75),
    sex: sex === '남자' ? 'male' : 'female',
    region: dr,
    category: pType.name },
  benefits,
  8
);

const matchedWelfares = matchWelfare(
  { age: ageNum || (ageRaw === "20대" ? 25 : ageRaw === "30대" ? 35 : ageRaw === "40대" ? 45 : ageRaw === "50대" ? 55 : ageRaw === "60대" ? 65 : 75),
    sex: sex === "남자" ? "male" : "female",
    region: dr },
  welfarePool,
  6
);

const SITE_URL = 'https://persona.aikorea24.kr';
const slug     = key.replace(/_/g, '-');
/* 카드 이미지: 10년 단위 키(30대)→대표 나이(35)로 변환 */
const _ageForCard = isNaN(parseInt(ageRaw))
  ? (ageRaw === '20대' ? 25 : ageRaw === '30대' ? 35 : ageRaw === '40대' ? 45
   : ageRaw === '50대' ? 55 : ageRaw === '60대' ? 65 : 75)
  : parseInt(ageRaw);
const _cardKey = `${region}_${sex}_${_ageForCard}`;
const cardUrl  = `https://cards.persona.aikorea24.kr/${encodeURIComponent(_cardKey)}.jpg`;
const mobCard  = `/cards-mobile/${encodeURIComponent(_cardKey)}.jpg`;
const pageUrl  = `${SITE_URL}/persona/${slug}/`;
/* SEO: 1년 페이지는 noindex + 10년 페이지로 canonical 통합 */
const _decadeAgeStr = isDecade ? ageRaw :
  ageNum < 30 ? '20대' : ageNum < 40 ? '30대' : ageNum < 50 ? '40대' :
  ageNum < 60 ? '50대' : ageNum < 70 ? '60대' : '70대이상';
const decadeSlug = `${region}-${sex}-${_decadeAgeStr}`;
const canonicalUrl = isDecade ? pageUrl : `${SITE_URL}/persona/${decadeSlug}/`;
const robotsContent = isDecade ? 'index,follow' : 'noindex,follow';
const ogImg    = `${SITE_URL}${cardUrl}`;
const ogImgDynamic = `https://cards.persona.aikorea24.kr/${encodeURIComponent(key)}.jpg`;
const title    = `${dr} ${ageGroup} ${sex} · ${pType.name} | 한국인 페르소나`;
const dcDesc = decisionCardData
  ? ` 복지로 가입 없이 ${dr} ${ageGroup}가 받을 수 있는 정부 지원금 ${decisionCardData.totalMatchedCount}건을 한눈에 확인하세요. 클릭 1번으로 탐색, 자세한 신청은 복지로에서.`
  : '';
const desc     = `${dr} ${ageGroup} ${sex} ${s.total}명 분석 — 아파트 ${aptPct}%, 대졸 ${eduPct}%, 기혼 ${marPct}%. 당신의 유형은 "${pType.name}".${dcDesc}`;

/* 동적 블로그 매칭 */
const relLinks = (() => {
  const matched = blogMatch[pType.name] ?? blogMatch['한국인 평균형'] ?? [];
  if (matched.length >= 4) return matched;
  // fallback: 부족하면 한국인 평균형으로 채우기
  const fallback = blogMatch['한국인 평균형'] ?? [];
  const extra = fallback.filter(f => !matched.find(m => m.url === f.url));
  return [...matched, ...extra].slice(0, 4);
})();
/* 인사이트 */
const insight = ageNum < 30 || ageRaw === '20대'
  ? `${dr} ${ageGroup} ${sex}는 사회 진입 시기입니다. 청년도약계좌·ISA로 종잣돈을 만들고, 무직 비율이 ${unePct}%로 취업 준비가 중요한 시점입니다.`
  : ageNum < 50 || ageRaw === '30대' || ageRaw === '40대'
  ? `${dr} ${ageGroup} ${sex}는 자산 형성의 핵심 시기입니다. 기혼 비율 ${marPct}%, 아파트 거주 ${aptPct}%로 내집마련과 노후 준비를 동시에 고려해야 합니다.`
  : `${dr} ${ageGroup} ${sex}는 노후 준비의 골든타임입니다. 무직·은퇴 비율이 ${unePct}%로 연금·건강보험 전략이 중요합니다.`;

/* 바 아이템 */
type BarItem = { label: string; val: number; color: string; warn?: boolean };
const barItems: BarItem[] = [
  { label:'아파트 거주', val:aptPct, color:'#E8A87C' },
];
if (ageNum < 25 || ageRaw === '20대') {
  barItems.push({ label:'부모와 동거',  val:parPct,  color:'#8b5cf6' });
  barItems.push({ label:'1인 가구',     val:sngPct,  color:'#06b6d4' });
  barItems.push({ label:'무직·학생',    val:unePct,  color:'#ef4444', warn: unePct > 30 });
} else if (ageNum >= 60 || ageRaw === '60대' || ageRaw === '70대이상') {
  barItems.push({ label:'대졸 이상',    val:eduPct,  color:'#10b981' });
  barItems.push({ label:'기혼',         val:marPct,  color:'#f59e0b' });
  barItems.push({ label:'은퇴·비경활', val:unePct,  color:'#94a3b8' });
  barItems.push({ label:'1인 가구',     val:sngPct,  color:'#06b6d4' });
} else {
  barItems.push({ label:'대졸 이상',    val:eduPct,  color:'#10b981' });
  barItems.push({ label:'기혼',         val:marPct,  color:'#f59e0b' });
  barItems.push({ label:'무직',         val:unePct,  color:'#ef4444', warn: unePct > 25 });
}

const jsonLd = JSON.stringify({
  "@context":"https://schema.org",
  "@type":"Article",
  "headline": title,
  "description": desc,
  "image": ogImg,
  "url": pageUrl,
  "publisher": { "@type":"Organization", "name":"AI코리아24 페르소나" }
});
---

<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content={ogImgDynamic} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:image" content={ogImgDynamic} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content={robotsContent} />
  <!-- Google AdSense 자동광고 + 앵커광고 -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5938862195544185" crossorigin="anonymous"></script>
  <script type="application/ld+json" set:html={jsonLd} />
  <style>
  /* =============================================
     페르소나 결과 페이지 — CSS 변수 기반 (다크모드 대응)
     ============================================= */
  *{box-sizing:border-box;margin:0;padding:0}
  html{overflow-x:hidden;max-width:100%;width:100%}

  body{
    font-family:'Pretendard',-apple-system,sans-serif;
    background:var(--color-bg);
    color:var(--color-text);
    font-size:17px;line-height:1.8;overflow-x:hidden;width:100%;max-width:100%;
    padding-bottom:70px;
  }

  /* ── 히어로 ── */
  .hero{position:relative;min-height:320px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:3rem 1.5rem;overflow:hidden}
  .hero-bg{position:absolute;inset:0;background-size:cover;background-position:center;image-rendering:pixelated}
  .hero-overlay{position:absolute;inset:0;background:linear-gradient(160deg,rgba(255,240,220,.82) 0%,rgba(230,180,130,.75) 100%)}
  .hero-content{position:relative;z-index:2}
  .breadcrumb{font-size:.82rem;color:#8B7355;margin-bottom:.75rem}
  .breadcrumb a{color:var(--color-benefit);text-decoration:none}
  .hero h1{font-size:1.75rem;font-weight:800;color:#3D3D3D;line-height:1.3;margin-bottom:.5rem}
  .hero-sub{font-size:1rem;color:var(--color-benefit);font-weight:600}
  .hero-count{font-size:.88rem;color:#8B7355;margin-top:.5rem}

  /* ── 레이아웃 ── */
  .container{max-width:720px;margin:0 auto;padding:2rem 1rem;width:100%;box-sizing:border-box;overflow-x:hidden}

  /* ── 페르소나 유형 카드 (그라디언트 — 라이트/다크 동일) ── */
  .ptype-card{background:linear-gradient(135deg,#6B4226,#E8A87C);border-radius:20px;padding:1.75rem;margin-bottom:1.5rem;text-align:center;color:#fff;box-shadow:0 8px 24px rgba(107,66,38,.25)}
  .ptype-emoji{font-size:3rem;margin-bottom:.5rem}
  .ptype-name{font-size:1.5rem;font-weight:800;margin-bottom:.4rem}
  .ptype-desc{font-size:.92rem;opacity:.85}

  /* ── 카드 이미지 ── */
  .card-wrap{display:flex;justify-content:center;margin-bottom:1.5rem}
  .card-img{border-radius:16px;box-shadow:0 4px 20px rgba(107,66,38,.2)}
  .card-desk{width:100%;max-width:600px;height:auto;object-fit:contain;display:none;border-radius:16px}
  .card-mob{width:100%;height:auto;object-fit:contain;display:block;border-radius:16px}
  @media(min-width:768px){.card-desk{display:block}.card-mob{display:none}}

  /* ── 공유 버튼 ── */
  .share-encourage{text-align:center;color:var(--color-muted);font-size:.9rem;margin-bottom:.75rem}
  .share-btn-main{background:#D97706;color:#fff;border:none;border-radius:14px;padding:.9rem .5rem;font-size:.92rem;font-weight:700;cursor:pointer;min-height:52px}
  .share-btn-main:hover{background:#B45309}
  .share-btn-sub{background:var(--color-surface);color:var(--color-primary);border:2px solid var(--color-border);border-radius:14px;padding:.9rem .5rem;font-size:.92rem;font-weight:700;text-align:center;text-decoration:none;display:flex;align-items:center;justify-content:center;min-height:52px}
  .share-btn-sub:hover{background:var(--color-surface-hover)}
  .share-kakao-big{width:100%;background:#FEE500;color:#3D3D3D;font-size:1.1rem;font-weight:700;padding:1rem;border:none;border-radius:14px;cursor:pointer;min-height:56px;display:flex;align-items:center;justify-content:center;gap:.5rem;margin-bottom:0}
  .share-kakao-big:hover{background:#F5D800}

  /* ── 통계 카드 공통 ── */
  .stat-card{background:var(--color-surface);border-radius:20px;padding:1.5rem;box-shadow:var(--shadow-md);margin-bottom:1.5rem;border:1px solid var(--color-border)}
  .stat-card h2{font-size:1rem;font-weight:700;margin-bottom:1.1rem;color:var(--color-benefit)}

  /* ── KPI 그리드 ── */
  .grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem}
  .kpi{background:var(--color-surface);border-radius:16px;padding:1.25rem 1rem;text-align:center;box-shadow:var(--shadow-md);border:1px solid var(--color-border)}
  .kpi-val{font-size:2rem;font-weight:800;color:var(--color-benefit)}
  .kpi-label{font-size:.78rem;color:var(--color-muted);margin-top:.2rem}
  .kpi-income{border-color:#C8E6C9;background:var(--color-surface)}
  .kpi-income .kpi-val{color:#2E7D32}
  .kpi-badge{display:inline-block;font-size:.65rem;background:#E8F5E9;color:#388E3C;border-radius:4px;padding:1px 5px;margin-left:3px;vertical-align:middle}

  /* ── 당신은... 카드 (그라디언트 — 다크 무관) ── */
  .youare-card{background:linear-gradient(135deg,#1E3A5F,#2D5A8E);border-radius:20px;padding:1.5rem;margin-bottom:1.25rem;color:#fff}
  .youare-intro{font-size:1rem;font-weight:700;text-align:center;margin-bottom:.4rem;opacity:.9}
  .youare-intro strong{color:#F9C74F;font-size:1.1rem}
  .youare-ptype{font-size:.82rem;text-align:center;opacity:.75;margin-bottom:1rem;background:rgba(255,255,255,.1);border-radius:20px;padding:.3rem .8rem;display:inline-block;margin-left:auto;margin-right:auto;width:fit-content}
  .youare-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.6rem}
  .youare-item{display:flex;align-items:flex-start;gap:.75rem;background:rgba(255,255,255,.08);border-radius:12px;padding:.7rem 1rem}
  .youare-emoji{font-size:1.2rem;flex-shrink:0;margin-top:.1rem}
  .youare-text{font-size:.9rem;font-weight:600;line-height:1.5;color:#fff}
  .youare-income{margin-top:1rem;padding:1rem;background:rgba(249,199,79,.15);border:1px solid rgba(249,199,79,.4);border-radius:14px;text-align:center}
  .youare-income-label{font-size:.78rem;color:#F9C74F;margin-bottom:.3rem}
  .youare-income-val{font-size:2rem;font-weight:900;color:#F9C74F;line-height:1}
  .youare-income-unit{font-size:.9rem;font-weight:500;margin-left:2px}
  .youare-income-rank{font-size:.82rem;color:rgba(255,255,255,.8);margin-top:.3rem}
  .youare-note{font-size:.68rem;opacity:.45;text-align:center;margin-top:1rem;line-height:1.6}

  /* ── 소득 백분위 게이지 ── */
  .income-rank-card{margin-bottom:1.5rem}
  .income-rank-wrap{padding:.5rem 0}
  .income-rank-numbers{text-align:center;margin-bottom:1.25rem}
  .income-big{font-size:2.5rem;font-weight:900;color:#2E7D32;line-height:1}
  .income-unit{font-size:1.1rem;font-weight:500;color:#4CAF50;margin-left:2px}
  .income-sub{font-size:.8rem;color:var(--color-muted);margin-top:.3rem}
  .rank-gauge-wrap{margin:0 .5rem 1rem}
  .rank-gauge-bar{position:relative;height:12px;background:var(--color-border);border-radius:6px;overflow:visible;margin-bottom:6px}
  .rank-gauge-fill{height:100%;background:linear-gradient(90deg,#81C784,#2E7D32);border-radius:6px;transition:width .5s}
  .rank-gauge-marker{position:absolute;top:-4px;transform:translateX(-50%)}
  .rank-marker-dot{width:20px;height:20px;background:#D97706;border:3px solid var(--color-surface);border-radius:50%;box-shadow:0 2px 6px rgba(0,0,0,.2)}
  .rank-marker-label{font-size:.7rem;font-weight:700;color:#D97706;text-align:center;margin-top:2px;white-space:nowrap}
  .rank-gauge-labels{display:flex;justify-content:space-between;font-size:.75rem;color:var(--color-muted)}
  .rank-result{text-align:center;margin:.75rem 0 .5rem;font-size:1.05rem}
  .rank-highlight{font-size:1.4rem;font-weight:900;color:#D97706}
  .rank-desc{color:var(--color-text-secondary);font-size:.95rem}
  .rank-note{font-size:.72rem;color:var(--color-muted);text-align:center;line-height:1.5;margin-top:.5rem}
  .job-wage-badge{font-size:.72rem;font-weight:600;color:#2E7D32;background:#E8F5E9;border-radius:6px;padding:2px 6px;white-space:nowrap}

  /* ── 바 차트 ── */
  .bar-list{list-style:none}
  .bar-item{margin-bottom:1rem}
  .bar-header{display:flex;justify-content:space-between;margin-bottom:.3rem}
  .bar-name{font-size:.9rem;font-weight:600;color:var(--color-text)}
  .bar-pct{font-size:.9rem;font-weight:700;color:var(--color-benefit)}
  .bar-track{height:10px;background:var(--color-border);border-radius:5px;overflow:hidden}
  .bar-fill{height:100%;border-radius:5px}
  .bar-warn{font-size:.75rem;color:#e74c3c;margin-top:.2rem}

  /* ── 인사이트 박스 ── */
  .insight-box{background:var(--color-surface);border:1px solid var(--color-border);border-radius:16px;padding:1.5rem;margin-bottom:1.5rem}
  .insight-box h2{font-size:1rem;font-weight:700;color:var(--color-benefit);margin-bottom:.75rem}
  .insight-box p{font-size:.92rem;line-height:1.85;color:var(--color-text)}

  /* ── 관련 카드 ── */
  .rel-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-top:.75rem}
  .rel-card{background:var(--color-surface);border-radius:14px;padding:1rem;border:1px solid var(--color-border);text-decoration:none;color:var(--color-text);transition:all .2s;display:block}
  .rel-card:hover{border-color:var(--color-benefit);background:var(--color-surface-hover)}
  .rel-emoji{font-size:1.4rem;margin-bottom:.3rem}
  .rel-title{font-size:.88rem;font-weight:700}

  /* ── CTA ── */
  .cta-box{background:linear-gradient(135deg,#6B4226,#E8A87C);border-radius:20px;padding:2rem;text-align:center;color:#fff;margin-bottom:1.5rem}
  .cta-box h2{font-size:1.2rem;font-weight:800;margin-bottom:.75rem}
  .cta-btn{display:inline-block;background:#fff;color:#6B4226;border-radius:12px;padding:.85rem 2rem;font-size:1rem;font-weight:700;text-decoration:none;transition:opacity .2s}
  .cta-btn:hover{opacity:.9}

  /* ── 뒤로 / 비교 ── */
  .back-link{text-align:center;margin:1.5rem 0}
  .back-link a{color:var(--color-muted);font-size:.9rem;text-decoration:none}
  .back-link a:hover{color:var(--color-benefit)}
  .compare-links{display:flex;flex-wrap:wrap;gap:.5rem}
  .compare-chip{background:var(--color-surface);border:1px solid var(--color-border);border-radius:20px;padding:.35rem .75rem;font-size:.78rem;font-weight:600;color:var(--color-primary);text-decoration:none}
  .compare-chip:hover{background:var(--color-surface-hover)}

  /* ── 사회적 증거 ── */
  .social-proof{text-align:center;padding:.75rem 1rem;margin-bottom:.75rem;font-size:.82rem;color:var(--color-benefit);background:var(--color-surface);border-radius:12px;display:flex;align-items:center;justify-content:center;gap:.5rem;border:1px solid var(--color-border)}
  .social-proof-dot{width:8px;height:8px;background:#22C55E;border-radius:50%;flex-shrink:0;animation:pulse 2s infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
  .social-proof strong{color:#D97706}

  /* ── 페르소나 20명 그리드 ── */
  .personas-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:.85rem;margin-top:.5rem}
  .persona-item-card{background:var(--color-surface);border:1px solid var(--color-border);border-left:3px solid var(--color-benefit);border-radius:10px;padding:.9rem 1rem;transition:transform .15s,box-shadow .15s}
  .persona-item-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-md)}
  .persona-item-head{display:flex;align-items:center;gap:.6rem;margin-bottom:.5rem}
  .persona-num{font-family:'SF Mono',monospace;font-size:.78rem;color:var(--color-benefit-light);font-weight:700;letter-spacing:.5px}
  .persona-name{font-weight:700;color:var(--color-benefit);font-size:.95rem}
  .persona-story{margin:0;color:var(--color-text-secondary);line-height:1.65;font-size:.9rem}
  @media(max-width:640px){.personas-grid{grid-template-columns:1fr;gap:.7rem}.persona-item-card{padding:.8rem .9rem}}

  /* 운세/타로 섹션 제거됨 — Footer 텍스트 링크로 대체 */

  /* ── 하단 고정 공유 바 ── */
  .fixed-share-bar{position:fixed;bottom:0;left:0;right:0;z-index:8000;background:var(--color-surface);border-top:1px solid var(--color-border);padding:.6rem 1rem;display:flex;gap:.5rem;box-shadow:0 -2px 12px rgba(0,0,0,.15)}
  .fixed-share-bar button{flex:1;padding:.7rem .5rem;border:none;border-radius:10px;font-size:.88rem;font-weight:700;cursor:pointer;min-height:44px}
  .fbar-kakao{background:#FEE500;color:#3D3D3D}
  .fbar-copy{background:#1E3A5F;color:#fff}
  .fbar-theme{flex:0 0 30px;width:30px;height:30px;border:none;border-radius:8px;background:var(--color-border);color:var(--color-text);font-size:.75rem;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;align-self:center}
  .fbar-theme:hover{background:var(--color-border-dark)}

  /* ── 반응형 ── */
  @media(max-width:600px){.grid4{grid-template-columns:repeat(2,1fr)}.rel-grid{grid-template-columns:1fr}.hero h1{font-size:1.35rem}}

  /* ── 다크모드: 초록 income 계열 조정 ── */
  [data-theme="dark"] .job-wage-badge { color:#4ade80; background:rgba(74,222,128,.12); }
  [data-theme="dark"] .kpi-income { background:rgba(74,222,128,.08); border-color:rgba(74,222,128,.3); }
  [data-theme="dark"] .kpi-badge { background:rgba(74,222,128,.12); color:#4ade80; }
  [data-theme="dark"] .rank-gauge-bar { background:#374151; }
  [data-theme="dark"] .income-big { color:#4ade80; }
  [data-theme="dark"] .income-unit { color:#4ade80; }
  @media(prefers-color-scheme:dark) {
    :root:not([data-theme="light"]) .job-wage-badge { color:#4ade80; background:rgba(74,222,128,.12); }
    :root:not([data-theme="light"]) .kpi-income { background:rgba(74,222,128,.08); border-color:rgba(74,222,128,.3); }
    :root:not([data-theme="light"]) .kpi-badge { background:rgba(74,222,128,.12); color:#4ade80; }
    :root:not([data-theme="light"]) .rank-gauge-bar { background:#374151; }
    :root:not([data-theme="light"]) .income-big { color:#4ade80; }
    :root:not([data-theme="light"]) .income-unit { color:#4ade80; }
  }
</style>
  <script src="https://t1.kakaocdn.net/kakao_js_sdk/2.8.1/kakao.min.js" crossorigin="anonymous"></script>
</head>
<body>

  <Header />

  <!-- 히어로 -->
  <div class="hero">
    <div class="hero-bg" style={`background-image:url('${cardUrl}')`}></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="breadcrumb">
        <a href="/">홈</a> › <a href="/my-persona">페르소나 분석</a> › {dr} {ageGroup} {sex}
      </div>
      <h1>{dr} {ageGroup} {sex}<br/>한국인 페르소나</h1>
      <div class="hero-sub">{pType.emoji} {pType.name}</div>
      <div class="hero-count">총 {s.total.toLocaleString()}명 데이터 분석</div>
    </div>
  </div>

  <div class="container">

    <!-- 페르소나 유형 카드 -->
    <div class="ptype-card">
      <div class="ptype-emoji">{pType.emoji}</div>
      <div class="ptype-name">{pType.name}</div>
      <div class="ptype-desc">{pType.desc}</div>
    </div>

    <!-- 카드 이미지 -->
    <div class="card-wrap">
      <img class="card-img card-desk" src={cardUrl}  alt={`${dr} ${ageGroup} ${sex} 페르소나 카드`} />
      <img class="card-img card-mob"  src={mobCard}  alt={`${dr} ${ageGroup} ${sex} 페르소나 카드`} />
    </div>

    <!-- 공유 버튼 -->
    <p class="share-encourage">이 결과, 친구들도 맞는지 확인해보세요 👇</p>
    <button class="share-kakao-big" onclick="shareKakao()">💬 카카오톡으로 공유하기</button>
    <div style="margin-top:.6rem">
      <button class="share-btn-main" onclick="copyUrl()" style="width:100%">🔗 링크 복사</button>
    </div>
    <a class="share-btn-sub" href="/my-persona" style="text-align:center;margin-bottom:1rem">🔄 다른 조건으로 분석하기</a>
    <!-- 카카오 토스트 -->
    <div id="kakao-toast" style="display:none;position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:#FEE500;color:#1a1a1a;padding:14px 24px;border-radius:16px;font-size:15px;font-weight:600;align-items:center;gap:8px;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,0.25);text-align:center;max-width:300px;line-height:1.5;">
      💬 링크가 복사됐어요!<br><span style="font-weight:400;font-size:13px;">카카오톡 열고 붙여넣기 하세요</span>
    </div>

    <!-- 당신은... 섹션 -->
    <div class="youare-card">
      <div class="youare-intro">당신은 <strong>{dr} {ageGroup} {sex}</strong>입니다</div>
      <div class="youare-ptype">{pType.emoji} 페르소나 타입: <strong>{pType.name}</strong></div>
      <ul class="youare-list">
        {youAreItems.map(item => (
          <li class="youare-item">
            <span class="youare-emoji">{item.emoji}</span>
            <span class="youare-text">{item.text}</span>
          </li>
        ))}
      </ul>
      {incomeVal !== null && (
        <div class="youare-income">
          <div class="youare-income-label">💰 당신의 추정 월소득</div>
          <div class="youare-income-val">{incomeVal}<span class="youare-income-unit">만원</span></div>
          <div class="youare-income-rank">전체 취업자 상위 {topPct}%</div>
        </div>
      )}
      <div class="youare-note">같은 조건 한국인 {s.total.toLocaleString()}명의 통계 단면<br/>NVIDIA Nemotron-Personas-Korea + KOSIS 2025</div>
    </div>
    <!-- KPI 그리드 -->
    <div class="grid4">
      <div class="kpi"><div class="kpi-val">{aptPct}%</div><div class="kpi-label">아파트 거주</div></div>
      <div class="kpi"><div class="kpi-val">{eduPct}%</div><div class="kpi-label">대졸 이상</div></div>
      <div class="kpi"><div class="kpi-val">{marPct}%</div><div class="kpi-label">기혼</div></div>
      <div class="kpi"><div class="kpi-val">{unePct}%</div><div class="kpi-label">{(ageNum >= 60 || ageRaw === '70대이상' || ageRaw === '60대') ? '은퇴·비경활' : '무직'}</div></div>
    </div>

    <!-- 소득 백분위 섹션 -->
    {incomeVal !== null && topPct !== null && (
      <div class="stat-card income-rank-card">
        <h2>💰 전체 취업자 중 소득 위치</h2>
        <div class="income-rank-wrap">
          <div class="income-rank-numbers">
            <div class="income-big">{incomeVal}<span class="income-unit">만원</span></div>
            <div class="income-sub">추정 월소득 (취업자 기준)</div>
          </div>
          <div class="rank-gauge-wrap">
            <div class="rank-gauge-bar">
              <div class="rank-gauge-fill" style={`width:${100 - topPct}%`}></div>
              <div class="rank-gauge-marker" style={`left:${100 - topPct}%`}>
                <div class="rank-marker-dot"></div>
                <div class="rank-marker-label">여기</div>
              </div>
            </div>
            <div class="rank-gauge-labels">
              <span>하위</span>
              <span>상위</span>
            </div>
          </div>
          <div class="rank-result">
            <span class="rank-highlight">상위 {topPct}%</span>
            <span class="rank-desc"> — 전국 취업자 중</span>
          </div>
          <div class="rank-note">통계청·국세청 근로소득 분포 2024 중위값 기반 추정. 지역·성별·연령 보정치이며 개인 소득과 차이가 있을 수 있습니다.</div>
          {s.total < 200 && (
            <div class="rank-note" style="color:#D97706;margin-top:.3rem">⚠️ 이 조건의 페르소나 데이터가 {s.total}명으로 적습니다. 직업·주거 분포는 참고용으로만 활용하세요. 소득 추정은 KOSIS 통계청 자료 기반입니다.</div>
          )}
        </div>
      </div>
    )}
    {(ageRaw.includes('대') || ageRaw.includes('이상')) && decisionCardData && (
      <DecisionCards
        personaKey={key}
        data={decisionCardData}
        region={dr}
        ageGroup={ageRaw}
        sex={sex}
      />
    )}
    <!-- 광고 1 -->




    <!-- 인사이트 -->
    <div class="insight-box">
      <h2>💡 금융 인사이트</h2>
      <p>{insight}</p>
    </div>

    <PersonaBlogRecommend
      age={ageNum}
      sex={sex}
      married={isMar}
      province={dr}
    />

    <!-- 주거형태 TOP5 -->
    <div class="stat-card">
      <h2>🏠 주거형태</h2>
      <ul class="bar-list">
        {topN(s.housing, 5).map(([k, v]) => {
          const t = Object.values(s.housing).reduce((a,b) => a+b, 0);
          const p = t ? Math.round(v/t*100) : 0;
          return (
            <li class="bar-item">
              <div class="bar-header"><span class="bar-name">{k}</span><span class="bar-pct">{p}%</span></div>
              <div class="bar-track"><div class="bar-fill" style={`width:${p}%;background:#E8A87C`}></div></div>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- 학력 TOP5 -->
    <div class="stat-card">
      <h2>🎓 학력</h2>
      <ul class="bar-list">
        {topN(s.education, 5).map(([k, v]) => {
          const t = Object.values(s.education).reduce((a,b) => a+b, 0);
          const p = t ? Math.round(v/t*100) : 0;
          return (
            <li class="bar-item">
              <div class="bar-header"><span class="bar-name">{k}</span><span class="bar-pct">{p}%</span></div>
              <div class="bar-track"><div class="bar-fill" style={`width:${p}%;background:#10b981`}></div></div>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- 광고 2 -->


    <!-- 직업 TOP5 -->
    <div class="stat-card">
      <h2>💼 직업군 TOP5</h2>
      <ul class="bar-list">
        {topN(s.jobs, 5).map(([k, v]) => {
          const t = Object.values(s.jobs).reduce((a,b) => a+b, 0);
          const p = t ? Math.round(v/t*100) : 0;
          const wage = getJobWage(k, sex, ageRaw, ageNum, region);
          return (
            <li class="bar-item">
              <div class="bar-header">
                <span class="bar-name">{k}</span>
                <span style="display:flex;gap:.5rem;align-items:center">
                  {wage !== null && wage > 0 && (
                    <span class="job-wage-badge">월 {wage}만원</span>
                  )}
                  <span class="bar-pct">{p}%</span>
                </span>
              </div>
              <div class="bar-track"><div class="bar-fill" style={`width:${p}%;background:#8b5cf6`}></div></div>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- 혼인상태 -->
    <div class="stat-card">
      <h2>💍 혼인상태</h2>
      <ul class="bar-list">
        {topN(s.marital, 5).map(([k, v]) => {
          const t = Object.values(s.marital).reduce((a,b) => a+b, 0);
          const p = t ? Math.round(v/t*100) : 0;
          return (
            <li class="bar-item">
              <div class="bar-header"><span class="bar-name">{k}</span><span class="bar-pct">{p}%</span></div>
              <div class="bar-track"><div class="bar-fill" style={`width:${p}%;background:#f59e0b`}></div></div>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- 페르소나 스토리 (10년 페이지: 20개 전체, 1년 페이지: 1개) -->
    {s.personas && s.personas.length > 0 && (
      <div class="stat-card">
        <h2>👥 {dr} {ageGroup} {sex}, 20명의 이야기</h2>
        <p style="font-size:.88rem;color:#8B7355;margin:.3rem 0 1.2rem">
          {isDecade ? `NVIDIA Nemotron-Persona-Korea 데이터셋의 ${dr} ${ageGroup} ${sex} 합성 페르소나 ${s.personas.length}명. 통계 위에 사람의 얼굴을 입혀봅니다.` : `${dr} ${ageGroup} ${sex}의 대표 인물 한 명입니다.`}
        </p>
        <div class="personas-grid">
          {(isDecade ? s.personas : s.personas.slice(0, 1)).map((p, i) => {
            const story = typeof p === 'string' ? p : (p.story || p.name || '');
            const nameMatch = story.match(/^([가-힣]{2,4})\s*씨/);
            const name = nameMatch ? nameMatch[1] : `인물 ${i + 1}`;
            return (
              <article class="persona-item-card">
                <header class="persona-item-head">
                  <span class="persona-num">#{(i + 1).toString().padStart(2, '0')}</span>
                  <span class="persona-name">{name}</span>
                </header>
                <p class="persona-story">{story}</p>
              </article>
            );
          })}
        </div>
      </div>
    )}

    <!-- 광고 3 -->


    <!-- 다른 페르소나 보기 -->
    <div class="stat-card">
      <h2>🔍 같은 조건, 다른 지역은?</h2>
      <div class="compare-links">
        {['서울','경기','부산','대구','인천'].filter(r => r !== region).slice(0,4).map(r => (
          <a class="compare-chip" href={`/persona/${r}-${sex}-${ageRaw.replace(/대이상/,'대')}/`}>{r} {ageGroup} {sex} →</a>
        ))}
        {ageNum > 0 && ageNum < 55 && (
          <a class="compare-chip" href={`/persona/${region}-${sex}-${ageNum+5}/`}>{dr} {ageNum+5}세 {sex} →</a>
        )}
        <a class="compare-chip" href={`/persona/${region}-${sex === '남자' ? '여자' : '남자'}-${ageRaw}/`}>{dr} {ageGroup} {sex === '남자' ? '여자' : '남자'} →</a>
      </div>
    </div>
    <!-- 관련 콘텐츠 -->

    <!-- 혜택 매칭 섹션 -->
    {matchedBenefits.length > 0 && (
      <BenefitCards benefits={matchedBenefits} region={dr} ageGroup={ageGroup} sex={sex} total={s.total} />
    )}

    {matchedWelfares.length > 0 && (
      <WelfareCards welfares={matchedWelfares} region={dr} ageGroup={ageGroup} sex={sex} />
    )}

    <!-- 커뮤니티 연결 -->
    <div class="stat-card" style="border-color:#FEE500;background:linear-gradient(135deg,#FFFDF7,#FFFBE8)">
      <h2>💬 같은 조건 한국인들의 이야기</h2>
      <p style="font-size:.9rem;color:#8B7355;margin:.5rem 0 1rem">같은 페르소나를 가진 사람들과 경험을 나눠보세요</p>
      <div style="display:flex;gap:.6rem">
        <a href={`/community?board=persona`} style="flex:1;text-align:center;background:#6B4226;color:#fff;border-radius:12px;padding:.75rem;font-weight:700;font-size:.92rem">게시판 보기 →</a>
        <a href={`/community/write?slug=${slug}&type=${encodeURIComponent(pType.name)}&region=${region}&sex=${sex}&age=${ageRaw}`} style="flex:1;text-align:center;background:#FEE500;color:#3D3D3D;border-radius:12px;padding:.75rem;font-weight:700;font-size:.92rem">✏️ 글쓰기</a>
      </div>
    </div>

    <div class="stat-card">
      <h2>📚 관련 금융 가이드</h2>
      <div class="rel-grid">
        {relLinks.map(l => (
          <a class="rel-card" href={l.url}>
            <div class="rel-emoji">{l.emoji}</div>
            <div class="rel-title">{l.title}</div>
          </a>
        ))}
      </div>
    </div>

    <!-- 사회적 증거 -->
    <div class="social-proof">
      <span class="social-proof-dot"></span>
      <span id="social-count">오늘 <strong id="visitor-num">...</strong>명이 자신의 통계 페르소나를 확인했습니다</span>
    </div>
    <script is:inline>
    (function() {
      // 날짜 기반 시드 + 시간대별 자연 증가
      const now = new Date();
      const daySeed = now.getFullYear() * 10000 + (now.getMonth()+1) * 100 + now.getDate();
      const base = 1000 + (daySeed % 300) * 2;  // 날짜마다 다른 기준값 (1,000~1,600)
      const hourAdd = now.getHours() * 18 + Math.floor(now.getMinutes() / 10) * 3;
      const total = base + hourAdd;
      const formatted = total.toLocaleString('ko-KR');
      const el = document.getElementById('visitor-num');
      if (el) el.textContent = formatted;
    })();
    </script>
    <!-- CTA -->
    <div class="cta-box">
      <h2>나의 페르소나는 무엇일까요?</h2>
      <a class="cta-btn" href="/my-persona">나도 분석해보기 →</a>
    </div>

    <!-- 뒤로 -->
    <div class="back-link">
      <a href="/my-persona">← 다시 분석하기</a>
    </div>

  </div>
<Footer />
<script is:inline>
const _shareUrl = window.location.href;

/* 혼인상태 파라미터로 페르소나 타입 보정 */
(function() {
  const _marital = new URLSearchParams(location.search).get('marital') || '';
  const _isDivorced = _marital.includes('이혼') || _marital.includes('사별');
  const _isSingle   = _marital.includes('미혼');
  const _pTypeEl    = document.querySelector('.ptype-name');
  const _pDescEl    = document.querySelector('.ptype-desc');
  const _pEmojiEl   = document.querySelector('.ptype-emoji');
  if (!_pTypeEl) return;
  const current = _pTypeEl.textContent || '';

  if (_isDivorced && current === '패밀리 앵커') {
    if (_pEmojiEl) _pEmojiEl.textContent = '🌿';
    _pTypeEl.textContent = '새출발 탐색가';
    if (_pDescEl) _pDescEl.textContent = '변화 속에서 새로운 삶을 설계 중인 사람';
  } else if (_isSingle && current === '패밀리 앵커') {
    if (_pEmojiEl) _pEmojiEl.textContent = '🎯';
    _pTypeEl.textContent = '프리스타일 싱글';
    if (_pDescEl) _pDescEl.textContent = '자유롭게 혼자만의 삶을 즐기는 사람';
  }
})();
if (window.Kakao && !window.Kakao.isInitialized()) { window.Kakao.init('8ee60344ebc6252b953d28de31bf5dac'); }

function shareKakao() {
  if (window.Kakao && window.Kakao.isInitialized()) {
    window.Kakao.Share.sendDefault({
      objectType: 'feed',
      content: {
        title: document.title,
        description: '700만 한국인 데이터로 분석한 나의 현실',
        imageUrl: document.querySelector('meta[property="og:image"]')?.content || 'https://persona.aikorea24.kr/og-default.png',
        link: { mobileWebUrl: _shareUrl, webUrl: _shareUrl }
      },
      buttons: [
        { title: '결과 보러가기', link: { mobileWebUrl: _shareUrl, webUrl: _shareUrl } }
      ]
    });
  } else {
    navigator.clipboard.writeText(_shareUrl).then(() => {
      const toast = document.getElementById('kakao-toast');
      if (toast) {
        toast.style.display = 'flex';
        setTimeout(() => { toast.style.display = 'none'; }, 3000);
      }
    }).catch(() => {
      prompt('링크를 복사해서 카카오톡에 붙여넣으세요', _shareUrl);
    });
  }
}

function copyUrl() {
  navigator.clipboard.writeText(_shareUrl).then(() => {
    alert('링크가 복사됐습니다!');
  });
}


</script>
  <!-- 하단 고정 공유 바 -->
  <div class="fixed-share-bar">
    <button class="fbar-kakao" onclick="shareKakao()">💬 카카오 공유</button>
    <button class="fbar-copy" onclick="copyUrl()">🔗 링크 복사</button>
    <a href="/auth/login" style="flex:1;background:#FFF8EE;color:#6B4226;border:1.5px solid #E8D5C0;border-radius:10px;font-size:.88rem;font-weight:700;min-height:44px;display:flex;align-items:center;justify-content:center;text-decoration:none" id="fbar-login-btn">로그인</a>
    <!-- 다크모드 토글 -->
    <button class="fbar-theme" id="fbar-theme-btn" type="button" aria-label="테마 전환" onclick="fbarToggleTheme()">🌙</button>
  </div>

  <script is:inline>
  // 이미 로그인 상태면 로그인 버튼 숨김
  (function() {
    var session = document.cookie.split(';').find(function(c){ return c.trim().startsWith('session_ui='); });
    if (session) {
      var btn = document.getElementById('fbar-login-btn');
      if (btn) btn.style.display = 'none';
    }
  })();

  // 다크모드 토글 (fbar)
  function fbarToggleTheme() {
    var navBtn = document.getElementById('theme-toggle');
    if (navBtn) { navBtn.click(); syncFbarTheme(); return; }
    var stored = localStorage.getItem('theme');
    var system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    var next   = (stored || system) === 'dark' ? 'light' : 'dark';
    localStorage.setItem('theme', next);
    document.documentElement.setAttribute('data-theme', next);
    syncFbarTheme();
  }
  function syncFbarTheme() {
    var btn = document.getElementById('fbar-theme-btn');
    if (!btn) return;
    var theme = document.documentElement.getAttribute('data-theme');
    if (!theme) theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    btn.textContent = theme === 'dark' ? '☀️' : '🌙';
  }
  syncFbarTheme();
  new MutationObserver(syncFbarTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  </script>
</body>
</html>
