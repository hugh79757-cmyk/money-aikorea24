---
// Marketing Persona Studio — 양방향(제품→페르소나 / 페르소나→시나리오) 마케팅 도구
// Phase 7 Task C. 선례: my-persona.astro(구조·stats fetch), benefit-click.js(API 계약)
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// index.astro REGIONS와 동일한 짧은 이름 17개 (persona-stats 키와 일치)
const REGIONS = [
  '서울', '경기', '인천', '부산', '대구', '대전', '광주', '울산', '세종',
  '강원', '충북', '충남', '전북', '전남', '경북', '경남', '제주'
];
const GENDERS = ['남자', '여자'];
const DECADES = ['10대', '20대', '30대', '40대', '50대', '60대', '70대', '80대'];
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <BaseHead
    title="마케팅 페르소나 스튜디오 | 드림 고객 시트 생성"
    description="제품 또는 타깃 조건을 입력하면 한국 인구통계 기반 가상 고객 페르소나와 드림 고객 시트(F1~F9)를 AI가 생성해드립니다."
    canonical="/marketing-persona"
  />
</head>
<body class="bg-[#F7F3EA] text-[#3D3D3D] min-h-screen flex flex-col">
  <Header />

  <main class="flex-1 w-full max-w-3xl mx-auto px-4 py-8">
    <!-- HERO -->
    <section class="text-center mb-8">
      <span class="inline-block bg-amber-600 text-white text-xs font-bold tracking-widest px-3 py-1 rounded-full mb-3">MARKETING PERSONA STUDIO</span>
      <h1 class="text-2xl md:text-3xl font-extrabold text-[#1E3A5F] leading-snug">드림 고객 시트를 만들어 보세요</h1>
      <p class="mt-2 text-sm md:text-base text-gray-600">사람들은 기능이 아니라 지금 해결하고 싶은 고민에 돈을 납니다.<br/>공공 통계 700만 한국인 데이터 기반 가상 페르소나로 타깃을 구체화하세요.</p>
      <noscript><span class="mt-3 block text-sm text-red-600 font-semibold">이 도구는 JavaScript가 필요합니다. 브라우저 설정에서 JavaScript를 활성화해 주세요.</span></noscript>
    </section>

    <!-- TABS -->
    <div class="grid grid-cols-2 gap-2 mb-6" role="tablist">
      <button id="tab-product" role="tab" aria-selected="true" onclick="switchTab('product')"
        class="tab-btn rounded-t-xl px-4 py-3 font-bold text-sm md:text-base border-2 border-b-0 transition-colors">🛍️ 제품부터 시작</button>
      <button id="tab-persona" role="tab" aria-selected="false" onclick="switchTab('persona')"
        class="tab-btn rounded-t-xl px-4 py-3 font-bold text-sm md:text-base border-2 border-b-0 transition-colors">👤 페르소나부터 시작</button>
    </div>

    <!-- PRODUCT-FIRST PANEL -->
    <section id="panel-product" class="bg-white border-2 border-[#E5E0D8] rounded-b-xl rounded-tr-xl p-5 md:p-6 shadow-sm">
      <h2 class="font-extrabold text-[#1E3A5F] mb-1">어떤 제품/서비스를 파시나요?</h2>
      <p class="text-xs text-gray-500 mb-3">예) "30대 직장인을 위한 저평가 ETF 자동 리밸런싱 앱. 월 5만 원부터 투자 가능"</p>
      <textarea id="product-input" maxlength="2000" rows="5"
        class="w-full border-2 border-[#E5E0D8] rounded-xl p-3 text-sm focus:border-amber-600 outline-none resize-y"
        placeholder="제품·서비스 설명을 입력하세요 (최대 2,000자)"></textarea>
      <p class="text-right text-xs text-gray-400 mt-1"><span id="product-count">0</span>/2000</p>
      <button id="generate-product" onclick="generate('product')"
        class="w-full mt-2 bg-amber-600 hover:bg-amber-700 disabled:bg-gray-300 text-white font-bold py-3.5 rounded-xl transition-colors min-h-[52px]">✨ 드림 고객 시트 생성하기</button>
    </section>

    <!-- PERSONA-FIRST PANEL -->
    <section id="panel-persona" class="hidden bg-white border-2 border-[#E5E0D8] rounded-b-xl rounded-tl-xl p-5 md:p-6 shadow-sm">
      <h2 class="font-extrabold text-[#1E3A5F] mb-3">타깃 페르소나 선택</h2>

      <p class="text-xs font-bold text-gray-500 mb-2">지역</p>
      <div id="region-grid" class="flex flex-wrap gap-1.5 mb-4">
        {REGIONS.map(r => <button class="opt-btn" data-group="region" data-value={r} onclick="pick(this)">{r}</button>)}
      </div>

      <p class="text-xs font-bold text-gray-500 mb-2">성별</p>
      <div class="flex gap-1.5 mb-4" id="gender-grid">
        {GENDERS.map(g => <button class="opt-btn" data-group="gender" data-value={g} onclick="pick(this)">{g}</button>)}
      </div>

      <p class="text-xs font-bold text-gray-500 mb-2">연령대</p>
      <div class="flex flex-wrap gap-1.5 mb-4" id="decade-grid">
        {DECADES.map(d => <button class="opt-btn" data-group="decade" data-value={d} onclick="pick(this)">{d}</button>)}
      </div>

      <!-- 프로파일 열람 (비로그인 허용 — MKT-01) -->
      <div id="profile-card" class="hidden bg-[#F7F3EA] border border-[#E5E0D8] rounded-xl p-4 my-3">
        <h3 id="profile-title" class="font-extrabold text-[#1E3A5F] mb-2"></h3>
        <div id="profile-body" class="text-xs text-gray-700 space-y-1"></div>
        <p class="text-[10px] text-gray-400 mt-2">출처: 행정안전부 주민등록·통계청 등 공공통계 기반 추정치</p>
      </div>

      <button id="generate-persona" onclick="generate('persona')" disabled
        class="w-full bg-amber-600 enabled:hover:bg-amber-700 disabled:bg-gray-300 text-white font-bold py-3.5 rounded-xl transition-colors min-h-[52px]">✨ 이 페르소나의 드림 고객 시트 보기</button>
    </section>

    <!-- LOGIN GATE (미로그인 시 생성 차단 — MKT-01) -->
    <div id="login-gate" class="hidden mt-4 bg-blue-50 border-2 border-blue-200 rounded-xl p-5 text-center">
      <p class="font-bold text-[#1E3A5F] mb-1">🔒 AI 생성은 카카오 로그인 후 이용할 수 있어요</p>
      <p class="text-xs text-gray-600 mb-3">카카오 로그인 후 AI 생성 가능 · 1일 5회</p>
      <a href="/auth/login" class="inline-block bg-[#FEE500] text-[#181600] font-bold px-6 py-3 rounded-xl text-sm">카카오로 로그인하기</a>
    </div>

    <!-- STATUS -->
    <div id="status-area" class="hidden mt-4 text-center p-4 rounded-xl text-sm font-semibold"></div>

    <!-- RESULT (Task D에서 시트 렌더러로 교체) -->
    <section id="result-container" class="hidden mt-6"></section>

    <!-- DISCLAIMER -->
    <p class="text-[11px] text-gray-400 mt-8 leading-relaxed text-center">
      본 페르소나는 공공 통계 기반의 가상 인물이며 실존 인물이 아닙니다.
      생성된 시나리오는 마케팅 기획 참고용이며 결과의 정확성을 보장하지 않습니다.
    </p>
  </main>

  <Footer />

  <script>
    import { escapeHtml } from '../lib/html-sanitizer';

    const REGIONS = ['서울','경기','인천','부산','대구','대전','광주','울산','세종','강원','충북','충남','전북','전남','경북','경남','제주'];
    const sel = { region: '', gender: '', decade: '' };
    let statsData: Record<string, any> | null = null;
    let currentMode: 'product' | 'persona' = 'product';

    function $(id: string) { return document.getElementById(id); }

    // ── 탭 전환 ──
    window.switchTab = (mode: 'product' | 'persona') => {
      currentMode = mode;
      $('tab-product')!.setAttribute('aria-selected', String(mode === 'product'));
      $('tab-persona')!.setAttribute('aria-selected', String(mode === 'persona'));
      $('panel-product')!.classList.toggle('hidden', mode !== 'product');
      $('panel-persona')!.classList.toggle('hidden', mode !== 'persona');
      styleTabs();
      if (mode === 'persona' && !statsData) loadStats();
    };
    function styleTabs() {
      for (const m of ['product', 'persona'] as const) {
        const active = currentMode === m;
        const el = $(`tab-${m}`)!;
        el.className = `tab-btn rounded-t-xl px-4 py-3 font-bold text-sm md:text-base border-2 border-b-0 transition-colors ${active ? 'bg-white text-[#1E3A5F] border-[#E5E0D8]' : 'bg-[#EFE9DD] text-gray-500 border-[#E5E0D8]'}`;
      }
    }
    styleTabs();

    // ── persona-first: 옵션 선택 ──
    window.pick = (btn: HTMLButtonElement) => {
      const group = btn.dataset.group as keyof typeof sel;
      sel[group] = btn.dataset.value || '';
      document.querySelectorAll(`.opt-btn[data-group="${group}"]`).forEach(b => b.classList.toggle('selected', b === btn));
      updatePersonaPanel();
    };

    function personaKey() {
      return (sel.region && sel.gender && sel.decade) ? `${sel.region}_${sel.gender}_${sel.decade}` : null;
    }

    async function loadStats() {
      try {
        const res = await fetch('/persona-stats-decade.json');
        statsData = await res.json();
      } catch { /* 프로파일 카드는 실패해도 생성 가능 */ }
      updatePersonaPanel();
    }

    function fmt(n: number) { return typeof n === 'number' ? n.toLocaleString('ko-KR') : '-'; }

    function updatePersonaPanel() {
      const key = personaKey();
      const genBtn = $('generate-persona')!;
      genBtn.disabled = !key;
      const card = $('profile-card')!, body = $('profile-body')!, title = $('profile-title')!;
      if (!key || !statsData?.[key]) {
        if (!key) { card.classList.add('hidden'); }
        else { title.textContent = `${sel.region} ${sel.decade} ${sel.gender} 프로필`; body.textContent = '통계 데이터를 불러올 수 없습니다.'; card.classList.remove('hidden'); }
        return;
      }
      const s = statsData[key];
      const eduTop = Object.entries(s.education ?? {}).sort((a: any, b: any) => b[1] - a[1])[0];
      const jobTop = Object.entries(s.jobs ?? {}).sort((a: any, b: any) => b[1] - a[1]).slice(0, 3);
      const inc = s.income ?? {};
      body.innerHTML = `
        <p>👥 해당 조건 인구: <b>${fmt(s.total)}명</b></p>
        ${eduTop ? `<p>🎓 최다 학력: <b>${escapeHtml(String(eduTop[0]))}</b> (${fmt(eduTop[1])}명)</p>` : ''}
        ${inc.income_employed > 0 ? `<p>💰 추정 월소득: <b>${fmt(inc.income_employed)}만원</b>${inc.top_percentile > 0 ? ` (취업자 상위 ${inc.top_percentile}%)` : ''}</p>` : ''}
        ${jobTop.length ? `<p>💼 주요 직업: <b>${jobTop.map(j => escapeHtml(String(j[0]))).join(', ')}</b></p>` : ''}
      `;
      title.textContent = `${sel.region} ${sel.decade} ${sel.gender}`;
      card.classList.remove('hidden');
    }

    // ── 로그인 게이트 (session_ui 쿠키 — Header.astro 패턴) ──
    function isLoggedIn(): boolean {
      const raw = document.cookie.split(';').find(c => c.trim().startsWith('session_ui='));
      if (!raw) return false;
      try { const v = JSON.parse(atob(decodeURIComponent(raw.trim().slice('session_ui='.length)))); return !!v?.id; }
      catch { return false; }
    }

    function showStatus(kind: 'loading' | 'error' | 'info', msg: string) {
      const area = $('status-area')!;
      area.className = `mt-4 text-center p-4 rounded-xl text-sm font-semibold ${kind === 'error' ? 'bg-red-50 text-red-700' : kind === 'info' ? 'bg-blue-50 text-blue-800' : 'bg-amber-50 text-amber-800'}`;
      area.innerHTML = kind === 'loading'
        ? '<span class="inline-block animate-spin mr-2">⏳</span>' + escapeHtml(msg)
        : escapeHtml(msg);
      area.classList.remove('hidden');
    }
    function hideStatus() { $('status-area')!.classList.add('hidden'); }

    function setLoading(on: boolean) {
      for (const id of ['generate-product', 'generate-persona']) {
        const b = $(id) as HTMLButtonElement | null;
        if (b) b.disabled = on;
      }
    }

    // ── 생성 요청 ──
    window.generate = async (mode: 'product' | 'persona') => {
      hideStatus();
      $('result-container')!.classList.add('hidden');
      if (!isLoggedIn()) { $('login-gate')!.classList.remove('hidden'); return; }
      $('login-gate')!.classList.add('hidden');

      const payload: Record<string, unknown> = { mode };
      if (mode === 'product') {
        const product = ($('product-input') as HTMLTextAreaElement).value.trim();
        if (!product) { showStatus('error', '제품/서비스 설명을 입력해 주세요.'); return; }
        payload.product = product;
      } else {
        const key = personaKey();
        if (!key) { showStatus('error', '지역·성별·연령대를 모두 선택해 주세요.'); return; }
        payload.personaKey = key;
      }

      setLoading(true);
      showStatus('loading', 'AI가 드림 고객 시트를 작성하고 있습니다... 최대 1분 걸릴 수 있어요.');
      try {
        const res = await fetch('/api/marketing/persona', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.status === 401) { showStatus('error', '로그인이 필요합니다. 카카오 로그인 후 다시 시도해 주세요.'); $('login-gate')!.classList.remove('hidden'); return; }
        if (res.status === 429) { showStatus('info', '오늘 5회를 모두 사용했어요. 내일 다시 이용해 주세요. 🙏'); return; }
        if (!res.ok) { showStatus('error', '생성에 실패했습니다. 잠시 후 다시 시도해 주세요.'); return; }
        const data = await res.json();
        renderResult(data);
      } catch {
        showStatus('error', '네트워크 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.');
      } finally {
        setLoading(false);
      }
    };

    // ── 결과 표시 (Task B 병합 전 임시: raw JSON 계약 검증용) ──
    function renderResult(data: { ok: boolean; scenario?: unknown; model_used?: string }) {
      const c = $('result-container')!;
      c.innerHTML = `<pre class="bg-white border-2 border-[#E5E0D8] rounded-xl p-4 text-xs overflow-auto whitespace-pre-wrap">${escapeHtml(JSON.stringify(data.scenario, null, 2))}</pre>`;
      c.classList.remove('hidden');
      hideStatus();
    }

    // ── product 글자수 카운터 ──
    $('product-input')?.addEventListener('input', (e) => {
      $('product-count')!.textContent = String((e.target as HTMLTextAreaElement).value.length);
    });
  </script>

  <style is:global>
    .opt-btn { background:#fff; border:2px solid #E5E0D8; border-radius:10px; padding:.45rem .85rem; font-size:.85rem; font-weight:600; color:#3D3D3D; cursor:pointer; transition:all .12s; min-height:38px; }
    .opt-btn:hover { border-color:#D97706; }
    .opt-btn.selected { border-color:#D97706; background:#EEF2FF; color:#1E3A5F; }
  </style>
</body>
</html>
