---
---
<html lang="ko">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title id="page-title">게시글 | 페르소나 커뮤니티</title>
  <meta name="robots" content="noindex,follow"/>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5938862195544185" crossorigin="anonymous"></script>
  <link rel="stylesheet" crossorigin="anonymous"
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Pretendard',-apple-system,sans-serif;background:#FFF8EE;color:#3D3D3D;padding-bottom:80px}
    header{background:#6B4226;padding:.9rem 1.25rem;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
    .logo{color:#fff;font-weight:800;font-size:1.05rem;text-decoration:none}
    .back{color:#fff;font-size:.9rem;opacity:.8;text-decoration:none}
    .container{max-width:680px;margin:0 auto;padding:1.5rem 1rem}
    .post-card{background:#fff;border-radius:16px;padding:1.5rem;border:1px solid #F0DFC8;box-shadow:0 2px 12px rgba(107,66,38,.08);margin-bottom:1.25rem}
    .post-badge{display:inline-block;background:#E8D5C0;color:#6B4226;border-radius:20px;padding:.2rem .7rem;font-size:.75rem;font-weight:700;margin-bottom:.75rem}
    .post-title{font-size:1.25rem;font-weight:800;color:#3D3D3D;margin-bottom:.75rem;line-height:1.4}
    .post-meta{font-size:.78rem;color:#8B7355;display:flex;gap:.75rem;margin-bottom:1.25rem;padding-bottom:1rem;border-bottom:1px solid #F0DFC8}
    .post-content{font-size:.95rem;line-height:1.8;color:#3D3D3D;white-space:pre-wrap;margin-bottom:1rem}
    .post-actions{display:flex;gap:.5rem;justify-content:flex-end}
    .like-btn{background:#FFF8EE;border:1.5px solid #E8D5C0;border-radius:8px;padding:.4rem .9rem;font-size:.85rem;color:#6B4226;cursor:pointer;font-weight:700}
    .like-btn.liked{background:#6B4226;color:#fff;border-color:#6B4226}

    /* 광고 슬롯 */
    .ad-slot{background:#f9f9f9;border:1px dashed #E8D5C0;border-radius:8px;min-height:100px;margin:1rem 0;display:flex;align-items:center;justify-content:center;color:#ccc;font-size:.75rem}

    /* 댓글 */
    .comments-section{background:#fff;border-radius:16px;padding:1.25rem;border:1px solid #F0DFC8}
    .comments-title{font-size:1rem;font-weight:800;color:#6B4226;margin-bottom:1rem}
    .comment-item{padding:.75rem 0;border-bottom:1px solid #F0DFC8}
    .comment-item:last-child{border-bottom:none}
    .comment-author{font-size:.78rem;font-weight:700;color:#6B4226;margin-bottom:.3rem}
    .comment-content{font-size:.88rem;color:#3D3D3D;line-height:1.6}
    .comment-date{font-size:.72rem;color:#8B7355;margin-top:.2rem}
    .comment-form{margin-top:1rem;display:flex;flex-direction:column;gap:.5rem}
    .comment-form textarea{border:1.5px solid #E8D5C0;border-radius:10px;padding:.75rem;font-size:.9rem;font-family:inherit;resize:none;height:80px;outline:none}
    .comment-form textarea:focus{border-color:#6B4226}
    .comment-submit{background:#6B4226;color:#fff;border:none;border-radius:8px;padding:.6rem 1.25rem;font-size:.88rem;font-weight:700;cursor:pointer;align-self:flex-end}
    .login-prompt{font-size:.85rem;color:#8B7355;text-align:center;padding:.75rem}
    .login-prompt a{color:#6B4226;font-weight:700}
    .empty{color:#8B7355;font-size:.88rem;text-align:center;padding:1.5rem 0}
    .loading{text-align:center;padding:3rem;color:#8B7355}
  </style>
</head>
<body>
  <header>
    <a class="logo" href="/">🇰🇷 페르소나</a>
    <a class="back" href="/community" id="back-link">← 게시판</a>
  </header>

  <div class="container">
    <div id="loading" class="loading">불러오는 중...</div>

    <div id="post-area" style="display:none">
      <div class="post-card">
        <div class="post-badge" id="post-board">👤 페르소나</div>
        <div class="post-title" id="post-title"></div>
        <div class="post-meta">
          <span id="post-author"></span>
          <span id="post-date"></span>
          <span id="post-views"></span>
        </div>
        <div class="post-content" id="post-content"></div>
        <div class="post-actions">
          <button class="like-btn" id="like-btn" onclick="toggleLike()">❤️ <span id="like-count">0</span></button>
        </div>
      </div>

      <!-- 광고 슬롯 1 -->
      <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-5938862195544185" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins>

      <!-- 댓글 -->
      <div class="comments-section">
        <div class="comments-title">💬 댓글 <span id="comment-count">0</span>개</div>
        <div id="comment-list"><div class="empty">첫 댓글을 남겨보세요</div></div>

        <div id="comment-form-area">
          <div class="comment-form" id="comment-form">
            <textarea id="comment-input" placeholder="댓글을 입력하세요" maxlength="500"></textarea>
            <button class="comment-submit" onclick="submitComment()">댓글 달기</button>
          </div>
        </div>
      </div>
    </div>

    <div id="error-area" style="display:none" class="empty">글을 찾을 수 없어요</div>
  </div>

  <script>
    const postId = location.pathname.split('/').pop();
    const session = document.cookie.split(';').find(c => c.trim().startsWith('session='));
    let currentUser = null;
    if (session) {
      try { currentUser = JSON.parse(atob(session.split('=').slice(1).join('='))); } catch {}
    }

    // 뒤로가기 board 파라미터 유지
    const urlBoard = new URLSearchParams(location.search).get('board') || 'persona';
    document.getElementById('back-link').href = `/community?board=${urlBoard}`;

    async function loadPost() {
      try {
        const res = await fetch(`/api/community/posts/${postId}`);
        const data = await res.json();
        if (!data || data.error) { showError(); return; }

        document.title = data.title + ' | 페르소나 커뮤니티';
        document.getElementById('post-board').textContent =
          data.board_type === 'benefit' ? '🎁 지원금·혜택' : '👤 페르소나';
        document.getElementById('post-title').textContent = data.title;
        document.getElementById('post-author').textContent = '✍️ ' + (data.author_name || '익명');
        document.getElementById('post-date').textContent = data.created_at?.slice(0,10) || '';
        document.getElementById('post-views').textContent = '👁 ' + (data.views || 0);
        document.getElementById('post-content').textContent = data.content;
        document.getElementById('like-count').textContent = data.likes || 0;
        document.getElementById('loading').style.display = 'none';
        document.getElementById('post-area').style.display = 'block';

        loadComments();
        if (!currentUser) {
          document.getElementById('comment-form').innerHTML =
            '<div class="login-prompt"><a href="/auth/login">카카오 로그인</a> 후 댓글을 달 수 있어요</div>';
        }
        (adsbygoogle = window.adsbygoogle || []).push({});
      } catch(e) { showError(); }
    }

    async function loadComments() {
      const res = await fetch(`/api/community/comments?post_id=${postId}`);
      const data = await res.json();
      const list = document.getElementById('comment-list');
      const comments = data.comments || [];
      document.getElementById('comment-count').textContent = comments.length;
      if (!comments.length) { list.innerHTML = '<div class="empty">첫 댓글을 남겨보세요</div>'; return; }
      list.innerHTML = comments.map(c => `
        <div class="comment-item">
          <div class="comment-author">${c.author_name || '익명'}</div>
          <div class="comment-content">${c.content}</div>
          <div class="comment-date">${c.created_at?.slice(0,10) || ''}</div>
        </div>`).join('');
    }

    async function toggleLike() {
      if (!currentUser) { location.href = '/auth/login'; return; }
      const res = await fetch('/api/community/like', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({post_id: parseInt(postId)})
      });
      const data = await res.json();
      if (data.ok) {
        document.getElementById('like-count').textContent = data.likes;
        document.getElementById('like-btn').classList.toggle('liked');
      }
    }

    async function submitComment() {
      const content = document.getElementById('comment-input').value.trim();
      if (!content) return;
      const res = await fetch('/api/community/comments', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({post_id: parseInt(postId), content})
      });
      const data = await res.json();
      if (data.ok) {
        document.getElementById('comment-input').value = '';
        loadComments();
      }
    }

    function showError() {
      document.getElementById('loading').style.display = 'none';
      document.getElementById('error-area').style.display = 'block';
    }

    loadPost();
  </script>
</body>
</html>
