---
import type { BenefitMatch } from '../lib/benefitMatcher';
import { calcDeadline, deadlineBadgeClass } from '../lib/deadlineExtractor';
interface Props { benefits: BenefitMatch[]; region: string; ageGroup: string; sex: string; total?: number; }
const { benefits, region, ageGroup, sex, total } = Astro.props;

// 마감 임박(30일 이하) 건수 계산
const urgentCount = benefits.filter(b => {
  const { daysLeft } = calcDeadline(b.content || '', b.deadline || '');
  return daysLeft <= 30;
}).length;

function badge(status: string) {
  if (status === 'eligible_likely') return { label: '✅ 가능성 높음', cls: 'b-green' };
  if (status === 'needs_check')    return { label: '⚠️ 조건 확인 필요', cls: 'b-yellow' };
  return { label: '❓ 추가 확인', cls: 'b-gray' };
}

function getDlText(dl: { source: string; daysLeft: number; label: string }): string {
  if (dl.source === 'content') return dl.label + ' (마감일 명시)';
  const threshold = 221;
  if (dl.daysLeft < threshold) return '예산 소진 전 신청 권장 · ' + dl.label;
  return '상시신청 · ' + dl.label;
}
---

<div class="benefit-section">
  <!-- ▼ 영웅 위젯 -->
  <div class="hero-widget">
    <p class="hw-title">🎁 {region} {ageGroup} {sex}가 받을 수 있는 혜택</p>
    <div class="hw-stats">
      <div class="hw-stat">
        <span class="hw-num">{benefits.length}</span>
        <span class="hw-lbl">매칭 혜택</span>
      </div>
      {total && total > 0 && (
        <div class="hw-stat">
          <span class="hw-num">{total.toLocaleString('ko-KR')}</span>
          <span class="hw-lbl">같은 조건 한국인</span>
        </div>
      )}
      {urgentCount > 0 && (
        <div class="hw-stat hw-urgent">
          <span class="hw-num">{urgentCount}</span>
          <span class="hw-lbl">마감 임박 ⏰</span>
        </div>
      )}
    </div>
    <a class="hw-cta" href="#benefit-grid-anchor">내 혜택 보기 ↓</a>
  </div>
  <!-- ▲ 영웅 위젯 -->
  <div class="benefit-header">
    <h2>🎁 {region} {ageGroup} {sex}가 받을 수 있는 혜택</h2>
    <p class="benefit-desc">나이·지역 조건 기준으로 매칭했어요. 실제 신청 전 공식 기관을 확인하세요.</p>
  </div>

  <div class="benefit-grid" id="benefit-grid-anchor">
    {benefits.map((b) => {
      const { label, cls } = badge(b.matchStatus);
      const dl = calcDeadline(b.content || '', b.deadline || '');
      const dlCls = deadlineBadgeClass(dl.daysLeft);
      const dlText = getDlText(dl);
      return (
        <div class="benefit-card">
          <div class="bc-top">
            <span class={`bc-badge ${cls}`}>{label}</span>
            <span class="bc-org">{b.org}</span>
          </div>
          <div class="bc-name">{b.name}</div>
          <div class="bc-purpose">{b.purpose || b.content?.slice(0, 80)}</div>
          {b.reasons.length > 0 && (
            <ul class="bc-reasons">
              {b.reasons.slice(0, 2).map(r => <li>✓ {r}</li>)}
            </ul>
          )}
          {b.warnings.length > 0 && (
            <ul class="bc-warnings">
              {b.warnings.slice(0, 1).map(w => <li>⚠ {w}</li>)}
            </ul>
          )}
                    <div class={`bc-deadline deadline-badge ${dlCls}`}>{dlText}</div>
          <div class="bc-actions">
            {b.url
              ? <a class="bc-btn-primary" href={b.url} target="_blank" rel="nofollow noopener" data-bid={b.id} data-seed={Math.floor((total||100)/10)} onclick="bcClick(this)">공식 신청처 →</a>
              : <span class="bc-btn-disabled">신청처 확인 필요</span>
            }
          </div>
        </div>
      );
    })}
  </div>
  <p class="benefit-disclaimer">AI코리아24는 민간 정보 서비스입니다. 실제 수급 여부는 공식 기관 기준을 최종 확인하세요.</p>
</div>

<script>
function bcClick(el) {
  const bid = el.getAttribute('data-bid');
  const seed = parseInt(el.getAttribute('data-seed') || '0');
  if (!bid) return;
  fetch('/api/benefit-click', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ benefit_id: bid, seed })
  }).catch(() => {});
}
</script>

<style>
.benefit-section{margin:2rem 0;padding:1.5rem;background:#FFFDF7;border-radius:20px;border:1px solid #F0DFC8}
.benefit-header h2{font-size:1.15rem;font-weight:800;color:#6B4226;margin-bottom:.3rem}
.benefit-desc{font-size:.82rem;color:#8B7355;margin-bottom:1.25rem}
.benefit-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
@media(max-width:600px){.benefit-grid{grid-template-columns:1fr}}
.benefit-card{background:#fff;border-radius:14px;padding:1rem;border:1px solid #F0DFC8;box-shadow:0 2px 8px rgba(107,66,38,.06)}
.bc-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem;flex-wrap:wrap;gap:.3rem}
.bc-badge{font-size:.7rem;font-weight:700;border-radius:99px;padding:.2rem .6rem}
.b-green{background:#dcfce7;color:#166534}
.b-yellow{background:#fef9c3;color:#854d0e}
.b-gray{background:#f3f4f6;color:#374151}
.bc-org{font-size:.7rem;color:#8B7355}
.bc-name{font-size:.92rem;font-weight:700;color:#3D3D3D;margin-bottom:.35rem;line-height:1.4}
.bc-purpose{font-size:.78rem;color:#555;line-height:1.5;margin-bottom:.5rem}
.bc-reasons{list-style:none;padding:0;margin:.35rem 0;font-size:.74rem;color:#166534}
.bc-warnings{list-style:none;padding:0;margin:.35rem 0;font-size:.74rem;color:#854d0e}
.bc-deadline{font-size:.72rem;color:#8B7355;margin-bottom:.6rem}
.bc-actions{display:flex;gap:.4rem}
.bc-btn-primary{background:#6B4226;color:#fff;border-radius:8px;padding:.4rem .8rem;font-size:.78rem;font-weight:700;text-decoration:none;white-space:nowrap}
.bc-btn-disabled{background:#F0DFC8;color:#8B7355;border-radius:8px;padding:.4rem .8rem;font-size:.78rem}
.benefit-disclaimer{font-size:.7rem;color:#8B7355;margin-top:1rem;text-align:center;line-height:1.6}
/* 영웅 위젯 */
.hero-widget{background:linear-gradient(135deg,#6B4226,#9B6B46);border-radius:16px;padding:1.25rem 1.5rem;margin-bottom:1.5rem;text-align:center;color:#fff}
.hw-title{font-size:.9rem;font-weight:700;margin-bottom:1rem;opacity:.95}
.hw-stats{display:flex;justify-content:center;gap:2rem;margin-bottom:1rem;flex-wrap:wrap}
.hw-stat{display:flex;flex-direction:column;align-items:center;gap:.15rem}
.hw-num{font-size:1.6rem;font-weight:900;line-height:1}
.hw-lbl{font-size:.68rem;opacity:.8}
.hw-urgent .hw-num{color:#FEE500}
.hw-urgent .hw-lbl{color:#FEE500}
.hw-cta{display:inline-block;background:#FEE500;color:#3D3D3D;border-radius:99px;padding:.45rem 1.4rem;font-size:.82rem;font-weight:800;text-decoration:none;margin-top:.25rem}
/* 카운트다운 배지 */
.deadline-badge{font-size:.72rem;font-weight:600;padding:.25rem .55rem;border-radius:6px;display:inline-block;margin-bottom:.6rem}
.deadline-urgent{background:#fee2e2;color:#991b1b;animation:pulse 1.5s infinite}
.deadline-soon{background:#fef3c7;color:#92400e}
.deadline-normal{background:#f3f4f6;color:#6b7280}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
</style>
