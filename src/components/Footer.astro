      <p class="copy">&copy; {today.getFullYear()} AI코리아24 머니. All rights reserved.</p>
    </div>
  </div>
</footer>

<script is:inline>
function footerKakaoShare() {
  const url = window.location.href;
  const title = document.title;
  if (window.Kakao && window.Kakao.isInitialized()) {
    window.Kakao.Share.sendDefault({
      objectType: 'feed',
      content: {
        title: title,
        description: '700만 한국인 데이터로 분석한 나의 현실',
        imageUrl: document.querySelector('meta[property="og:image"]')?.content || 'https://persona.aikorea24.kr/og-default.png',
        link: { mobileWebUrl: url, webUrl: url }
      },
      buttons: [{ title: '보러가기', link: { mobileWebUrl: url, webUrl: url } }]
    });
  } else {
    // 카카오 SDK 없으면 클립보드 복사
    navigator.clipboard.writeText(url).then(() => {
      alert('링크가 복사됐어요! 카카오톡에 붙여넣기 하세요 💬');
    }).catch(() => {
      prompt('링크를 복사해서 카카오톡에 붙여넣으세요', url);
    });
  }
}
</script>

<style>
  footer {
    background: var(--color-surface-hover);
    border-top: 1px solid var(--color-border-light);
    margin-top: var(--space-16);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .footer-inner {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: var(--space-10) var(--space-4) var(--space-6);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }
  .footer-col h3 {
    font-size: 0.9rem;
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }
  .footer-col p { line-height: 1.7; margin: 0; }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer-col a { color: var(--color-muted); text-decoration: none; transition: color var(--transition-fast); }
  .footer-col a:hover { color: var(--color-text); }
  .footer-sns {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    align-items: center;
  }
  .footer-sns a { color: var(--color-placeholder); text-decoration: none; transition: color var(--transition-fast); }
  .footer-sns a:hover { color: var(--color-text); }
  .sns-kakao-btn {
    background: var(--color-kakao);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-kakao-text);
    transition: background var(--transition-fast), transform var(--transition-fast);
    padding: 0;
  }
  .sns-kakao-btn:hover { background: #F5D800; transform: scale(1.1); }
  .footer-bottom {
    border-top: 1px solid var(--color-border-light);
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .footer-bottom p { margin: 0; }
  .disclaimer-note { color: var(--color-placeholder); font-size: var(--text-xs); margin-top: var(--space-1) !important; }
  .copy { margin-top: var(--space-2) !important; }
</style>
