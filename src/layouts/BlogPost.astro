---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import AiTip from '../components/AiTip.astro';
import Disclaimer from '../components/Disclaimer.astro';
import FloatingFab from '../components/FloatingFab.astro';
import InlinePersonaCTA from '../components/InlinePersonaCTA.astro';

interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  collection?: string;
  category?: string;
  relatedPosts?: CollectionEntry<'blog'>[];
  tocHeadings?: { depth: number; slug: string; text: string }[];
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  collection = '',
  category: categoryProp = '',
  relatedPosts = [],
  tocHeadings = [],
  canonical = '',
  noindex = false,
} = Astro.props;

const FINANCE_COLLECTIONS = ['insurance', 'invest', 'loan'];
const isFinance = FINANCE_COLLECTIONS.includes(collection) || FINANCE_COLLECTIONS.includes(categoryProp);

const datePublished = pubDate ? pubDate.toISOString() : new Date().toISOString();

const categoryLabel: Record<string, string> = {
  insurance: '보험',
  invest:    '투자·절세',
  loan:      '대출·부동산',
  nomad:     '디지털노마드',
  blog:      '블로그',
};
const resolvedCategory = categoryProp || collection;
const category = categoryLabel[resolvedCategory] ?? resolvedCategory;

// ── 카테고리별 지원금 배너 매핑 ──
// 모든 배너는 /benefits 허브 페이지로 연결 (6개 카테고리 버튼에서 선택)
const CATEGORY_BENEFIT_MAP: Record<string, { ctaText: string; targetUrl: string; emoji: string; color: string }> = {
  insurance: {
    ctaText: '건강·의료비 지원금',
    targetUrl: '/benefits',
    emoji: '🏥',
    color: 'linear-gradient(135deg,#0EA5E9,#38BDF8)',
  },
  invest: {
    ctaText: '청년·창업 지원금',
    targetUrl: '/benefits',
    emoji: '📈',
    color: 'linear-gradient(135deg,#8B5CF6,#A78BFA)',
  },
  loan: {
    ctaText: '주거·전세 지원금',
    targetUrl: '/benefits',
    emoji: '🏠',
    color: 'linear-gradient(135deg,#F59E0B,#FBBF24)',
  },
  tax: {
    ctaText: '세금·연말정산 혜택',
    targetUrl: '/benefits',
    emoji: '💰',
    color: 'linear-gradient(135deg,#10B981,#34D399)',
  },
  nomad: {
    ctaText: '부업·교육 지원금',
    targetUrl: '/benefits',
    emoji: '🌍',
    color: 'linear-gradient(135deg,#EC4899,#F472B6)',
  },
  general: {
    ctaText: '맞춤 지원금 찾기',
    targetUrl: '/benefits',
    emoji: '🎁',
    color: 'linear-gradient(135deg,#6B7280,#9CA3AF)',
  },
};
const benefitTarget = CATEGORY_BENEFIT_MAP[resolvedCategory] || CATEGORY_BENEFIT_MAP.general;


---

<html lang="ko">
  <head>
    <BaseHead title={title} description={description} image={heroImage} canonical={canonical} noindex={noindex} />
    <JsonLd
      title={title}
      description={description}
      url={Astro.url.href}
      datePublished={datePublished}
      category={category}
    />
    <style>
      main {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
      }
      .prose {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        padding: 1em 1.25em;
        color: rgb(var(--gray-dark));
        box-sizing: border-box;
      }
      /* 모바일: 여백 최소화, 폰트 크기 향상 */
      @media (max-width: 640px) {
        .prose {
          max-width: 100%;
          padding: 0.75em 0.9em 2em;
        }
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1.3;
      }
      /* 모바일 폰트 크기 제한 */
      .title h1 {
        margin: 0 0 0.5em 0;
        font-size: 1.55rem;
        line-height: 1.35;
        word-break: keep-all;
      }
      @media (min-width: 640px) {
        .title h1 { font-size: 1.8rem; }
      }
      @media (min-width: 768px) {
        .title h1 { font-size: 2.2rem; }
      }
      .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
        font-size: 0.9rem;
      }
      .last-updated-on { font-style: italic; }
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        justify-content: center;
        margin-top: 0.8rem;
      }
      .tag {
        font-size: 0.78rem;
        padding: 0.2rem 0.6rem;
        background: #f0f0f0;
        border-radius: 999px;
        color: #555;
        text-decoration: none;
      }
      .category-badge {
        display: inline-block;
        font-size: 0.78rem;
        padding: 0.2rem 0.7rem;
        background: #4f8ef7;
        color: #fff;
        border-radius: 999px;
        margin-bottom: 0.6rem;
      }

      /* prose 본문 — 모바일 우선 */
      .prose :global(h2) {
        font-size: 1.35rem;
        margin-top: 1.8em;
        margin-bottom: 0.6em;
        word-break: keep-all;
      }
      .prose :global(h3) {
        font-size: 1.15rem;
        margin-top: 1.4em;
        word-break: keep-all;
      }
      .prose :global(p) {
        font-size: 1.1rem;
        line-height: 1.95;
        word-break: keep-all;
      }
      .prose :global(li) {
        font-size: 1.08rem;
        line-height: 1.85;
      }
      .prose :global(table) {
        width: 100%;
        font-size: 0.82rem;
        border-collapse: collapse;
        overflow-x: auto;
        display: block;
      }
      .prose :global(th),
      .prose :global(td) {
        padding: 0.4rem 0.5rem;
        border: 1px solid var(--color-border-light);
        white-space: nowrap;
        color: var(--color-text);
      }
      .prose :global(th) {
        background: var(--color-code-bg);
        font-weight: 700;
        color: var(--color-text);
      }
      @media (min-width: 640px) {
        .prose :global(h2) { font-size: 1.5rem; }
        .prose :global(h3) { font-size: 1.25rem; }
        .prose :global(p)  { font-size: 1.08rem; }
      }

      /* ── 히어로 이미지(썸네일) 가운데 정렬 ── */
      .hero-image {
        text-align: center !important;
        margin: 0 auto !important;
        max-width: 1020px;
        padding: 0 1rem;
        box-sizing: border-box;
        display: flex !important;
        justify-content: center !important;
      }
      .hero-image img {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
        display: block !important;
        margin: 0 auto !important;
        object-fit: contain;
      }

      /* ── 엔티티 카드 ── */
      .entity-card {
        margin: 2rem 0 1.5rem;
        padding: 1.25rem 1.4rem;
        background: linear-gradient(135deg, #F0F9FF, #E0F2FE);
        border: 1.5px solid #BAE6FD;
        border-radius: 16px;
        text-decoration: none;
        display: block;
        transition: transform .15s, box-shadow .15s;
      }
      .entity-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.08); }
      .entity-card-label {
        font-size: .72rem;
        font-weight: 700;
        color: #0369A1;
        letter-spacing: .06em;
        margin-bottom: .5rem;
      }
      .entity-card-stat {
        font-size: 1rem;
        font-weight: 700;
        color: #1E3A5F;
        margin-bottom: .4rem;
        line-height: 1.4;
      }
      .entity-card-cta {
        font-size: .82rem;
        color: #0369A1;
        font-weight: 600;
      }

      /* ── 목차 (TOC) ── */
      .toc-box {
        margin: 1.5rem 0 2rem;
        padding: 1.1rem 1.4rem;
        background: #F0F9FF;
        border: 1.5px solid #BAE6FD;
        border-radius: 14px;
      }
      .toc-box summary {
        font-size: .92rem;
        font-weight: 700;
        color: #1E3A5F;
        cursor: pointer;
        list-style: none;
        display: flex;
        align-items: center;
        gap: .4rem;
      }
      .toc-box summary::-webkit-details-marker { display: none; }
      .toc-list {
        margin: .8rem 0 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: .3rem;
      }
      .toc-list li a {
        font-size: .85rem;
        color: #0369A1;
        text-decoration: none;
        line-height: 1.5;
        display: block;
        transition: color .15s;
      }
      .toc-list li a:hover { color: #1E3A5F; text-decoration: underline; }
      .toc-list li.depth-3 { padding-left: 1rem; }
      .toc-list li.depth-3 a { color: #4B83B5; font-size: .82rem; }

      /* ── 관련 글 ── */
      .related-section {
        margin: 2rem 0 1.5rem;
      }
      .related-section h3 {
        font-size: 1rem;
        font-weight: 700;
        color: #1E3A5F;
        margin-bottom: 1rem;
        padding-bottom: .5rem;
        border-bottom: 2px solid #E5E0D8;
      }
      .related-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: .75rem;
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .related-grid li {
        display: block;
        list-style: none;
      }
      .related-card {
        display: block;
        padding: 1rem 1.2rem;
        background: #fff;
        border: 1px solid #E5E0D8;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
        box-shadow: 0 1px 4px rgba(0,0,0,.05);
      }
      .related-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0,0,0,.10);
      }
      .related-card-title {
        font-size: .95rem;
        font-weight: 700;
        color: #1E3A5F;
        margin-bottom: .3rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .related-card-desc {
        font-size: .82rem;
        color: #6B7280;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

    </style>
  </head>

  <body>
    <Header />
    <FloatingFab bottomOffset="24px" />
    <main>
      <article>
        {heroImage && (
          <div class="hero-image">
            <img width="1020" height="510" src={heroImage} alt={title} />
          </div>
        )}

        {/* ── 썸네일-타이틀 사이 광고 — Slot A ── */}
        <div style="max-width:760px; margin:0 auto; padding:0 1.25em;">
          <ins class="adsbygoogle lazyad"
            style="display:block; width:100%; text-align:center; margin: 0.5rem 0 1rem;"
            data-ad-client="ca-pub-5938862195544185"
            data-ad-slot="5768046585"
            data-ad-format="auto"
            data-full-width-responsive="true"></ins>
        </div>

        <div class="prose">
          <div class="title">
            {category && <span class="category-badge">{category}</span>}
            <div class="date">
              {pubDate && <FormattedDate date={pubDate} />}
              {updatedDate && (
                <div class="last-updated-on">
                  최종 수정: <FormattedDate date={updatedDate} />
                </div>
              )}
            </div>
            <h1>{title}</h1>
            {tags.length > 0 && (
              <div class="tags">
                {tags.map((tag) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
            )}
            <hr />
          </div>

          {/* ── 첫 설명문 끝 광고 — Slot B ── */}
          <ins class="adsbygoogle lazyad"
            style="display:block; width:100%; text-align:center; margin: 1rem 0 1.5rem;"
            data-ad-client="ca-pub-5938862195544185"
            data-ad-slot="1032549059"
            data-ad-format="auto"
            data-full-width-responsive="true"></ins>

          {tocHeadings.length > 2 && (
            <details class="toc-box" open>
              <summary>📋 목차 보기</summary>
              <ul class="toc-list">
                {tocHeadings.map((h) => (
                  <li class={`depth-${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </details>
          )}

          <InlinePersonaCTA category={resolvedCategory} />

          <slot />



          {relatedPosts.length > 0 && (
            <div class="related-section">
              <h3>📌 관련 글 더 보기</h3>
              <ol class="related-grid">
                {relatedPosts.map((p) => (
                  <li>
                    <a class="related-card" href={`/blog/${encodeURIComponent(p.id)}/`}>
                      <div class="related-card-title">{p.data.title}</div>
                      {p.data.description && (
                        <div class="related-card-desc">{p.data.description}</div>
                      )}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {/* ── 리더보드 광고 (PC 본문 끝) — Slot D ── */}
          <div class="ad-leaderboard desktop-only">
            <ins class="adsbygoogle lazyad desktop-only"
              style="display:block; text-align:center;"
              data-ad-client="ca-pub-5938862195544185"
              data-ad-slot="9981825008"
              data-ad-format="horizontal"
              data-full-width-responsive="true"></ins>
          </div>

          {/* ── 지원금 배너 (Entity Card 대체) ── */}
          <a class="benefit-banner" href={benefitTarget.targetUrl}
            style={`display:block;background:${benefitTarget.color};border-radius:16px;padding:1.25rem 1.5rem;margin:1.5rem 0;text-decoration:none;color:#fff;transition:transform .15s,box-shadow .15s;`}
            onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,.12)'"
            onmouseout="this.style.transform='';this.style.boxShadow=''">
            <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.4rem;">
              <span style="font-size:1.4rem;">{benefitTarget.emoji}</span>
              <span style="font-size:.82rem;font-weight:700;opacity:.85;letter-spacing:.04em;">지원금 혜택</span>
            </div>
            <div style="font-size:1.1rem;font-weight:800;line-height:1.4;margin-bottom:.6rem;word-break:keep-all;">
              {benefitTarget.ctaText} 놓치지 마세요
            </div>
            <div style="display:flex;align-items:center;gap:.4rem;">
              <span style="font-size:.88rem;font-weight:700;background:rgba(255,255,255,0.2);border-radius:8px;padding:.35rem .85rem;">
                지금 확인하기 →
              </span>
              <span style="font-size:.75rem;opacity:.7;">실시간 매칹 결과 보기</span>
            </div>
          </a>

          <AiTip topic={title} />

          {isFinance && <Disclaimer />}



        </div>
      </article>
    </main>
    <Footer />

    {/* ── 모바일 스티키 광고 — Slot D ── */}
    <div id="mobile-sticky-ad" class="ad-mobile-sticky" style="display:none;">
      <button class="close-btn" aria-label="광고 닫기" onclick="this.parentElement.style.display='none'">✕</button>
      <ins class="adsbygoogle lazyad"
        style="display:block; text-align:center;"
        data-ad-client="ca-pub-5938862195544185"
        data-ad-slot="9981825008"
        data-ad-format="horizontal"
        data-full-width-responsive="true"></ins>
    </div>

    {/* ── Funnel telemetry (Wave 2, T5) ── */}
    <script>
      import { track } from '../lib/funnel';
      window.funnelTrack = track;
    </script>

    {/* ── 글로벌 광고 레이지로드 ── */}
    <script is:inline>
    (function() {
      // 이미 초기화된 ins 건너뛰기
      var ads = Array.prototype.slice.call(document.querySelectorAll('ins.adsbygoogle.lazyad'));
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          var el = entry.target;
          if (el.dataset.adsbygoogleStatus) { io.unobserve(el); return; }
          try {
            (adsbygoogle = window.adsbygoogle || []).push({});
            el.dataset.adsbygoogleStatus = 'done';
            // 광고 노출 측정 (observation-only — 광고 코드/속성 변경 없음)
            if (typeof window.funnelTrack === 'function') {
              window.funnelTrack('ad_impression', {
                slot_position: (ads.indexOf(el) + 1),
                ad_unit: el.getAttribute('data-ad-slot') || null
              });
            }
          } catch(e) {}
          io.unobserve(el);
        });
      }, { rootMargin: '400px 0px', threshold: 0 });

      ads.forEach(function(ins) {
        if (!ins.dataset.adsbygoogleStatus) io.observe(ins);
      });

      // 모바일 스티키: 스크롤 600px 이후 표시
      var sticky = document.getElementById('mobile-sticky-ad');
      if (sticky && window.innerWidth < 768) {
        var shown = false;
        window.addEventListener('scroll', function() {
          if (!shown && window.scrollY > 600) {
            sticky.style.display = 'block';
            shown = true;
            try { (adsbygoogle = window.adsbygoogle || []).push({}); } catch(e) {}
          }
        }, { passive: true });
      }

      // ── Blog → persona CTA 클릭 캡처 (Wave 2, T5) ──
      document.addEventListener('click', function(e) {
        var a = e.target.closest && e.target.closest(
          'a[href*="/my-persona"], a[href*="persona.aikorea24.kr/my-persona"]'
        );
        if (!a) return;
        try {
          var url = new URL(a.href, location.href);
          var src = url.searchParams.get('src') || '';
          var parts = src.split('-');
          var cat = parts[0] || null;
          var persona = parts.slice(1).join('-') || null;
          if (typeof window.funnelTrack === 'function') {
            window.funnelTrack('blog_cta_click', {
              src: src || null,
              cat: cat,
              persona: persona
            });
          }
        } catch (err) {}
      });
    })();
    </script>
  </body>
</html>
