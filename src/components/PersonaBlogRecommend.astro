---
/**
 * PersonaBlogRecommend — 페르소나 페이지에 표시할 맞춤형 블로그 추천 섹션
 *
 * fetch(/search.json) → relevanceScore 계산 → 상위 4개 추천
 */


export interface Props {
  age: number;
  sex: string;
  married: boolean;
  province: string;
}

const { age, sex, married, province } = Astro.props;

/* ── 타입 ── */
interface SearchItem {
  title: string;
  description: string;
  slug: string;
  category: string;
  pubDate: string;
}

/* ── 연령대별 키워드 맵 ── */
const ageKeywordMap: Record<string, string[]> = {
  '19-29': ['청년', '청년도약', '청년적금', '주휴수당', '중소기업취업', '전세대출', '비상금'],
  '30-39': ['주담대', '청약', 'IRP', 'ISA', '연말정산', '실손보험', '육아', '부모급여'],
  '40-49': ['종합소득세', '절세', 'ETF', '상속', '증여', '암보험', '간병'],
  '50-64': ['상속세', '증여세', '노후', '연금', '간병인보험', '건강보험'],
  '65+':   ['상속', '증여', '간병', '실버', '노후', '의료비'],
};

/* ── 혼인 상태별 키워드 맵 ── */
const marriedKeywords = ['혼인세액공제', '육아', '부모급여', '아동수당', '태아보험'];
const singleKeywords  = ['청년', '전세', '비상금대출'];

/* ── 성별 키워드 맵 ── */
const sexKeywordMap: Record<string, string[]> = {
  '여자': ['태아보험', '육아휴직', '근로장려금', '실손보험'],
  '남자': ['주담대', '청약', '실업급여', 'IRP'],
};

/* ── 점수 계산 ── */
function calculateScore(item: SearchItem): number {
  const text = `${item.title} ${item.description}`.toLowerCase();
  let score = 0;

  // 연령대 키워드
  if (age >= 19 && age <= 29) {
    for (const kw of ageKeywordMap['19-29']) {
      if (text.includes(kw.toLowerCase())) score += 3;
    }
  } else if (age >= 30 && age <= 39) {
    for (const kw of ageKeywordMap['30-39']) {
      if (text.includes(kw.toLowerCase())) score += 3;
    }
  } else if (age >= 40 && age <= 49) {
    for (const kw of ageKeywordMap['40-49']) {
      if (text.includes(kw.toLowerCase())) score += 3;
    }
  } else if (age >= 50 && age <= 64) {
    for (const kw of ageKeywordMap['50-64']) {
      if (text.includes(kw.toLowerCase())) score += 3;
    }
  } else if (age >= 65) {
    for (const kw of ageKeywordMap['65+']) {
      if (text.includes(kw.toLowerCase())) score += 3;
    }
  }

  // 성별 키워드
  const sexKeywords = sexKeywordMap[sex];
  if (sexKeywords) {
    for (const kw of sexKeywords) {
      if (text.includes(kw.toLowerCase())) score += 2;
    }
  }

  // 혼인 상태 키워드
  const maritalKeywords = married ? marriedKeywords : singleKeywords;
  for (const kw of maritalKeywords) {
    if (text.includes(kw.toLowerCase())) score += 2;
  }

  // 카테고리 보너스
  if (item.category === 'insurance') score += 1;

  return score;
}

/* ── 카테고리 표시명 ── */
const categoryLabel: Record<string, string> = {
  insurance: '🛡️ 보험',
  invest:    '📈 투자·절세',
  loan:      '🏠 대출·부동산',
  general:   '📋 금융',
};

/* ── 데이터 조회 & 점수 계산 (Promise.race 로 타임아웃 처리) ── */
let selectedPosts: (SearchItem & { score: number })[] = [];

function timeout(ms: number): Promise<null> {
  return new Promise(resolve => setTimeout(() => resolve(null), ms));
}

try {
  const jsonPromise = fetch(new URL('/search.json', Astro.url).href)
    .then(r => r.ok ? r.json() : [])
    .catch(() => []);
  const allPosts: SearchItem[] = (await Promise.race([jsonPromise, timeout(10)])) ?? [];
  const scored = allPosts
    .map(p => ({ ...p, score: calculateScore(p) }))
    .filter(p => p.score > 0)
    .sort((a, b) => {
      const diff = b.score - a.score;
      if (diff !== 0) return diff;
      // 동점 시 최신순
      return new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf();
    });
  selectedPosts = scored.slice(0, 4);
} catch {
  // 조회 실패 시 빈 배열로 fallback
}

const isEmpty = selectedPosts.length === 0;
const displayAge = Math.floor(age / 10) * 10;
---

{!isEmpty && (
  <section class="persona-blog-rec">
    <h2 class="rec-title">📚 {`${province} ${displayAge}대 ${sex}에게 추천하는 금융 가이드`}</h2>

    <div class="rec-grid">
      {selectedPosts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="rec-card" data-rotation-card="true">
          <div class="rec-card-top">
            <span class={`rec-badge rec-badge-${post.category}`}>
              {categoryLabel[post.category] || '📋 금융'}
            </span>
          </div>
          <h3 class="rec-card-title">{post.title}</h3>
          <p class="rec-card-desc">{post.description}</p>
          <span class="rec-read-more">읽기 →</span>
        </a>
      ))}
    </div>

    <a href="/blog/" class="rec-all-link">📝 금융 가이드 전체 보기 →</a>
  </section>
)}

<style>
  .persona-blog-rec {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: var(--radius-xl, 16px);
    box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.06));
  }

  .rec-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary, #1E3A5F);
    margin: 0 0 1.25rem;
    line-height: 1.4;
  }

  .rec-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  @media (max-width: 640px) {
    .rec-grid {
      grid-template-columns: 1fr;
    }
  }

  .rec-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg, #F7F3EA);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: var(--radius-lg, 12px);
    padding: 1rem 1.1rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .rec-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md, 0 4px 8px rgba(0,0,0,0.08));
  }

  .rec-card-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .rec-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 99px;
    letter-spacing: 0.03em;
    flex-shrink: 0;
  }

  .rec-badge-insurance {
    background: rgba(30, 58, 95, 0.1);
    color: #1E3A5F;
  }

  .rec-badge-invest {
    background: rgba(6, 95, 70, 0.1);
    color: #065F46;
  }

  .rec-badge-loan {
    background: rgba(146, 64, 14, 0.1);
    color: #92400E;
  }

  .rec-badge-general {
    background: rgba(31, 41, 55, 0.1);
    color: #1F2937;
  }

  .rec-card-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-primary, #1E3A5F);
    margin: 0 0 0.4rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rec-card-desc {
    font-size: 0.8rem;
    color: var(--color-muted, #4B5563);
    margin: 0 0 0.6rem;
    line-height: 1.55;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rec-read-more {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-accent, #D97706);
    align-self: flex-end;
  }

  .rec-all-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary, #1E3A5F);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md, 8px);
    background: rgba(30, 58, 95, 0.06);
    transition: background 0.15s;
  }

  .rec-all-link:hover {
    background: rgba(30, 58, 95, 0.12);
  }
</style>
