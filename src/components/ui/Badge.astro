---
/**
 * Badge - 재사용 가능한 뱃지/태그 컴포넌트
 *
 * @prop variant - 뱃지 스타일 변형 (default | success | warning | error | info | accent)
 * @prop size - 뱃지 크기 (sm | md | lg)
 * @prop rounded - 완전히 둥근 형태 사용 여부
 * @prop pulse - 애니메이션 효과 (긴급 표시용)
 */
export interface Props {
  variant?: 'default' | 'success' | 'warning' | 'error' | 'info' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  rounded?: boolean;
  pulse?: boolean;
  class?: string;
}

const {
  variant = 'default',
  size = 'md',
  rounded = true,
  pulse = false,
  class: className = '',
} = Astro.props;

const classes = `badge badge-${variant} badge-${size} ${rounded ? 'badge-rounded' : ''} ${pulse ? 'badge-pulse' : ''} ${className}`.trim();
---

<span class={classes}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: var(--font-bold);
    white-space: nowrap;
    letter-spacing: var(--tracking-wide);
  }

  /* Sizes */
  .badge-sm {
    font-size: 0.65rem;
    padding: 0.15rem var(--space-2);
    border-radius: var(--radius-sm);
  }

  .badge-md {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
  }

  .badge-lg {
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
  }

  /* Rounded */
  .badge-rounded {
    border-radius: var(--radius-full);
  }

  /* Variants */
  .badge-default {
    background: var(--color-surface-hover);
    color: var(--color-muted);
  }

  .badge-success {
    background: var(--color-success-bg);
    color: var(--color-success);
  }

  .badge-warning {
    background: var(--color-warning-bg);
    color: var(--color-warning);
  }

  .badge-error {
    background: var(--color-error-bg);
    color: var(--color-error);
  }

  .badge-info {
    background: var(--color-info-bg);
    color: var(--color-info);
  }

  .badge-accent {
    background: var(--color-accent);
    color: var(--color-surface);
  }

  /* Pulse Animation */
  .badge-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }
</style>
