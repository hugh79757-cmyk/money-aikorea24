---
/**
 * FloatingFab — 플로팅 공유 + 다크모드 토글 버튼
 * bottomOffset: 기본 24px (페르소나 결과 페이지에서는 80px)
 */
interface Props {
  bottomOffset?: string;
}
const { bottomOffset = '24px' } = Astro.props;
---

<div class="fab-root" id="fab-root" style={`bottom: ${bottomOffset}`}>

  <!-- 공유 패널 (토글 시 펼침) -->
  <div class="fab-panel" id="fab-panel" aria-hidden="true">
    <button class="fab-panel-item fab-item-kakao"  id="fab-kakao-btn" type="button">💛 카카오</button>
    <button class="fab-panel-item fab-item-copy"   id="fab-copy-btn"  type="button">🔗 링크 복사</button>
  </div>

  <!-- 다크모드 토글 -->
  <button class="fab-btn fab-theme" id="fab-theme-btn" type="button" aria-label="테마 전환" title="다크/라이트 모드">
    <!-- 달 아이콘 (라이트 모드일 때 표시) -->
    <svg class="fab-icon-moon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
    <!-- 태양 아이콘 (다크 모드일 때 표시) -->
    <svg class="fab-icon-sun" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"/>
      <line x1="12" y1="1" x2="12" y2="3"/>
      <line x1="12" y1="21" x2="12" y2="23"/>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
      <line x1="1" y1="12" x2="3" y2="12"/>
      <line x1="21" y1="12" x2="23" y2="12"/>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
    </svg>
  </button>

  <!-- 공유 토글 -->
  <button class="fab-btn fab-share" id="fab-share-btn" type="button" aria-label="공유하기" aria-expanded="false">
    <!-- share icon -->
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
    </svg>
  </button>

  <!-- 복사 완료 토스트 -->
  <div class="fab-toast" id="fab-toast">🔗 링크 복사됨!</div>
</div>

<script is:inline>
(function() {
  var fabRoot    = document.getElementById('fab-root');
  var fabPanel   = document.getElementById('fab-panel');
  var fabShare   = document.getElementById('fab-share-btn');
  var fabTheme   = document.getElementById('fab-theme-btn');
  var fabKakao   = document.getElementById('fab-kakao-btn');
  var fabCopy    = document.getElementById('fab-copy-btn');
  var fabToast   = document.getElementById('fab-toast');

  var panelOpen = false;

  /* ── 공유 패널 토글 ── */
  function togglePanel() {
    panelOpen = !panelOpen;
    fabPanel.classList.toggle('open', panelOpen);
    fabShare.setAttribute('aria-expanded', String(panelOpen));
    fabShare.classList.toggle('active', panelOpen);
  }

  if (fabShare) fabShare.addEventListener('click', function(e) {
    e.stopPropagation();
    togglePanel();
  });

  /* 패널 외부 클릭 닫기 */
  document.addEventListener('click', function(e) {
    if (panelOpen && fabRoot && !fabRoot.contains(e.target)) {
      panelOpen = false;
      fabPanel.classList.remove('open');
      fabShare.setAttribute('aria-expanded', 'false');
      fabShare.classList.remove('active');
    }
  });

  /* ── 카카오 공유 ── */
  if (fabKakao) fabKakao.addEventListener('click', function() {
    var url   = window.location.href;
    var title = document.title;
    if (window.Kakao && window.Kakao.isInitialized()) {
      window.Kakao.Share.sendDefault({
        objectType: 'feed',
        content: {
          title: title,
          description: 'persona.aikorea24.kr',
          imageUrl: document.querySelector('meta[property="og:image"]')?.content || 'https://persona.aikorea24.kr/og-default.png',
          link: { mobileWebUrl: url, webUrl: url }
        },
        buttons: [{ title: '보러가기', link: { mobileWebUrl: url, webUrl: url } }]
      });
    } else {
      navigator.clipboard.writeText(url).then(function() {
        showToast('카카오 공유: 링크가 복사됐어요!');
      });
    }
    togglePanel();
  });

  /* ── 링크 복사 ── */
  if (fabCopy) fabCopy.addEventListener('click', function() {
    navigator.clipboard.writeText(window.location.href).then(function() {
      showToast('🔗 링크 복사됨!');
    });
    togglePanel();
  });

  /* ── 토스트 ── */
  function showToast(msg) {
    if (!fabToast) return;
    fabToast.textContent = msg;
    fabToast.classList.add('show');
    setTimeout(function() { fabToast.classList.remove('show'); }, 2200);
  }

  /* ── 다크모드 토글 ── */
  function syncFabThemeIcon() {
    var theme = document.documentElement.getAttribute('data-theme');
    if (!theme) theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    if (fabTheme) fabTheme.setAttribute('data-theme', theme);
  }
  syncFabThemeIcon();

  if (fabTheme) fabTheme.addEventListener('click', function() {
    /* 헤더의 테마 토글 버튼이 있으면 클릭 위임, 없으면 직접 처리 */
    var navToggle = document.getElementById('theme-toggle');
    if (navToggle) {
      navToggle.click();
      setTimeout(syncFabThemeIcon, 50);
    } else {
      /* 직접 토글 */
      var stored = localStorage.getItem('theme');
      var system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      var next = (stored || system) === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      document.documentElement.setAttribute('data-theme', next);
      setTimeout(syncFabThemeIcon, 50);
    }
  });

  /* 테마 변경 감지 (다른 곳에서 바뀔 때도 아이콘 동기화) */
  var observer = new MutationObserver(syncFabThemeIcon);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
})();
</script>

<style>
  .fab-root {
    position: fixed;
    right: 16px;
    z-index: 9000;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  /* ── 공유 패널 ── */
  .fab-panel {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
    opacity: 0;
    transform: translateY(12px) scale(0.92);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .fab-panel.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: all;
  }
  .fab-panel-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: none;
    border-radius: 24px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
    box-shadow: 0 4px 16px rgba(0,0,0,0.18);
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .fab-panel-item:hover { transform: scale(1.04); box-shadow: 0 6px 20px rgba(0,0,0,0.22); }
  .fab-item-kakao { background: #FEE500; color: #1a1a1a; }
  .fab-item-copy  { background: #1E3A5F; color: #fff; }

  /* ── FAB 버튼 공통 ── */
  .fab-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 18px rgba(0,0,0,0.22);
    transition: transform 0.15s, box-shadow 0.15s;
    flex-shrink: 0;
  }
  .fab-btn:hover { transform: scale(1.08); box-shadow: 0 6px 22px rgba(0,0,0,0.28); }
  .fab-btn:active { transform: scale(0.95); }

  /* 공유 버튼 */
  .fab-share {
    background: var(--color-benefit, #6B4226);
    color: #fff;
  }
  .fab-share.active { background: var(--color-accent, #1E3A5F); }

  /* 다크모드 버튼 — 앙증맞게 작게 */
  .fab-theme {
    width: 32px;
    height: 32px;
    background: var(--color-surface, #fff);
    color: var(--color-text, #333);
    border: 1.5px solid var(--color-border, #e0e0e0);
    position: relative;
    box-shadow: 0 2px 8px rgba(0,0,0,0.14);
  }
  .fab-theme svg { width: 13px; height: 13px; }
  .fab-icon-moon, .fab-icon-sun {
    position: absolute;
    transition: opacity 0.2s, transform 0.2s;
  }
  /* 라이트 모드: 달(다크 전환 예고) 표시 */
  .fab-theme[data-theme="light"] .fab-icon-moon { opacity: 1; transform: scale(1); }
  .fab-theme[data-theme="light"] .fab-icon-sun  { opacity: 0; transform: scale(0); }
  /* 다크 모드: 해(라이트 전환 예고) 표시 */
  .fab-theme[data-theme="dark"] .fab-icon-sun   { opacity: 1; transform: scale(1); }
  .fab-theme[data-theme="dark"] .fab-icon-moon  { opacity: 0; transform: scale(0); }
  /* 미결정 */
  .fab-theme:not([data-theme]) .fab-icon-moon { opacity: 0.6; transform: scale(1); }
  .fab-theme:not([data-theme]) .fab-icon-sun  { opacity: 0; }

  /* ── 토스트 ── */
  .fab-toast {
    position: absolute;
    bottom: calc(100% + 8px);
    right: 0;
    background: #1a1a1a;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 20px;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s;
  }
  .fab-toast.show { opacity: 1; transform: translateY(0); }

  /* 모바일에서만 표시 (데스크탑은 다른 공유 수단 충분) */
  @media (min-width: 960px) {
    .fab-root { display: none; }
  }
</style>
